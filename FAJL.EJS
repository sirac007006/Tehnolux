    // NOVA VERZIJA - Učitava STVARNE cene iz lagera
    async function populateEditArtikliTable(artikli) {
        const tbody = document.getElementById('edit-artikli-tbody');
        tbody.innerHTML = '';
        
        for (let i = 0; i < artikli.length; i++) {
            const artikal = artikli[i];
            
            try {
                // Učitaj TRENUTNE cene iz lagera
                const response = await fetch(`/api/lager/sifra/${artikal.sifra}`);
                
                let lagerCene = {
                    cena_bez_pdv: artikal.cena_bez_pdv,
                    cena_sa_pdv: artikal.cena_sa_pdv
                };
                
                if (response.ok) {
                    const lagerData = await response.json();
                    lagerCene.cena_bez_pdv = parseFloat(lagerData.cena_bez_pdv);
                    lagerCene.cena_sa_pdv = parseFloat(lagerData.cena_sa_pdv);
                    console.log(`Učitane cene iz lagera za ${artikal.sifra}: bez PDV=${lagerCene.cena_bez_pdv.toFixed(2)}, sa PDV=${lagerCene.cena_sa_pdv.toFixed(2)}`);
                } else {
                    console.warn(`Nije moguće učitati cene za ${artikal.sifra}, koriste se postojeće`);
                }
                
                addEditRow({
                    ...artikal,
                    cena_bez_pdv: lagerCene.cena_bez_pdv,
                    cena_sa_pdv: lagerCene.cena_sa_pdv
                }, i);
                
            } catch (error) {
                console.error(`Greška pri učitavanju cena za artikal ${artikal.sifra}:`, error);
                addEditRow(artikal, i);
            }
        }
        
        recalculateEditTotals();
    }

