    // AUTOCOMPLETE FUNKCIONALNOST
    function setupAutocomplete(input) {
        const wrapper = input.closest('.autocomplete-wrapper');
        const resultsDiv = wrapper.querySelector('.autocomplete-results');
        
        let searchTimeout;
        
        input.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            const query = this.value.trim();
            
            if (query.length < 2) {
                resultsDiv.classList.remove('show');
                return;
            }
            
            searchTimeout = setTimeout(async () => {
                try {
                    const response = await fetch(`/api/artikli/autocomplete?query=${encodeURIComponent(query)}`);
                    const results = await response.json();
                    
                    if (results.length > 0) {
                        displayAutocompleteResults(resultsDiv, results, input);
                    } else {
                        resultsDiv.classList.remove('show');
                    }
                } catch (error) {
                    console.error('Error fetching autocomplete results:', error);
                }
            }, 300);
        });
        
        document.addEventListener('click', function(e) {
            if (!wrapper.contains(e.target)) {
                resultsDiv.classList.remove('show');
            }
        });
        
        input.addEventListener('keydown', function(e) {
            const items = resultsDiv.querySelectorAll('.autocomplete-item');
            
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                if (items.length > 0) {
                    if (selectedAutocompleteIndex < items.length - 1) {
                        selectedAutocompleteIndex++;
                        updateAutocompleteSelection(items);
                    }
                }
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                if (selectedAutocompleteIndex > 0) {
                    selectedAutocompleteIndex--;
                    updateAutocompleteSelection(items);
                }
            } else if (e.key === 'Enter' && selectedAutocompleteIndex >= 0) {
                e.preventDefault();
                items[selectedAutocompleteIndex].click();
            } else if (e.key === 'Escape') {
                resultsDiv.classList.remove('show');
            }
        });
    }

    function displayAutocompleteResults(resultsDiv, results, input) {
        resultsDiv.innerHTML = '';
        selectedAutocompleteIndex = -1;
        
        results.forEach((item, index) => {
            const div = document.createElement('div');
            div.className = 'autocomplete-item';
            div.innerHTML = `
                <div>
                    <strong>${item.naziv}</strong>
                    <span class="item-code">(${item.sifra})</span>
                    <span class="item-price">${parseFloat(item.cena_bez_pdv).toFixed(2)} €</span>
                </div>
            `;
            
            div.addEventListener('click', function() {
                selectAutocompleteItem(input, item);
            });
            
            resultsDiv.appendChild(div);
        });
        
        resultsDiv.classList.add('show');
    }

    function updateAutocompleteSelection(items) {
        items.forEach((item, index) => {
            if (index === selectedAutocompleteIndex) {
                item.style.backgroundColor = '#e3f2fd';
            } else {
                item.style.backgroundColor = '';
            }
        });
    }

    // Autocomplete odabir - KORISTI CENE IZ LAGERA
    function selectAutocompleteItem(input, item) {
        const row = input.closest('tr');
        
        // Popuni sva polja - CENE DIREKTNO IZ AUTOCOMPLETE (koje dolaze iz lagera)
        row.querySelector('.artikal-sifra').value = item.sifra;
        row.querySelector('.artikal-naziv').value = item.naziv;
        row.querySelector('.artikal-jm').value = item.jm || 'kom';
        row.querySelector('.artikal-cena-bez').value = parseFloat(item.cena_bez_pdv).toFixed(2);
        row.querySelector('.artikal-cena-sa').value = parseFloat(item.cena_sa_pdv).toFixed(2);
        
        console.log(`Autocomplete odabir: ${item.naziv}, cena bez PDV=${item.cena_bez_pdv}, sa PDV=${item.cena_sa_pdv}`);
        
        const resultsDiv = input.closest('.autocomplete-wrapper').querySelector('.autocomplete-results');
        resultsDiv.classList.remove('show');
        
        calculateEditRow(row.querySelector('.artikal-kolicina'));
    }

    // Izračunavanje ukupnih iznosa - KORISTI CENE IZ INPUT POLJA
    function calculateEditRow(input) {
        const row = input.closest('tr');
        
        const kolicina = parseFloat(row.querySelector('.artikal-kolicina').value) || 0;
        const cenaBez = parseFloat(row.querySelector('.artikal-cena-bez').value) || 0;
        const rabat = parseFloat(row.querySelector('.artikal-rabat').value) || 0;
        
        // UKUPNO BEZ PDV = (cena × količina) - rabat
        const ukupnoBezPdvBefore = cenaBez * kolicina;
        const rabatAmount = ukupnoBezPdvBefore * (rabat / 100);
        const ukupnoBezPdv = ukupnoBezPdvBefore - rabatAmount;
        
        // UKUPNO SA PDV = ukupno bez PDV × 1.21
        const ukupnoSaPdv = ukupnoBezPdv * 1.21;
        
        row.querySelector('.artikal-total-bez').value = ukupnoBezPdv.toFixed(2);
        row.querySelector('.artikal-total-sa').value = ukupnoSaPdv.toFixed(2);
        
        recalculateEditTotals();
    }

    function recalculateEditTotals() {
        let totalKolicina = 0;
        let totalBezPdv = 0;
        let totalSaPdv = 0;
        
        document.querySelectorAll('#edit-artikli-tbody tr').forEach(row => {
            const kolicina = parseFloat(row.querySelector('.artikal-kolicina').value) || 0;
            const totalBez = parseFloat(row.querySelector('.artikal-total-bez').value) || 0;
            const totalSa = parseFloat(row.querySelector('.artikal-total-sa').value) || 0;
            
            totalKolicina += kolicina;
            totalBezPdv += totalBez;
            totalSaPdv += totalSa;
        });
        
        const totalPdv = totalSaPdv - totalBezPdv;
        
        document.getElementById('edit-total-kolicina').textContent = totalKolicina.toFixed(2);
        document.getElementById('edit-total-bez-pdv').textContent = totalBezPdv.toFixed(2) + ' €';
        document.getElementById('edit-total-pdv').textContent = totalPdv.toFixed(2) + ' €';
        document.getElementById('edit-total-sa-pdv').textContent = totalSaPdv.toFixed(2) + ' €';
    }

    function removeEditRow(btn) {
        const tbody = document.getElementById('edit-artikli-tbody');
        if (tbody.children.length <= 1) {
            alert('Morate imati najmanje jedan artikal u dokumentu.');
            return;
        }
        
        btn.closest('tr').remove();
        updateEditRowNumbers();
        recalculateEditTotals();
    }

