                        <td class="text-right">${vrijednostBezPdv.toFixed(2)}</td>
                        <td class="text-right">${item.rabat.toFixed(1)}%</td>
                        <td class="text-right">${item.pdvStopa.toFixed(0)}%</td>
                        <td class="text-right">${pdvIznos.toFixed(2)}</td>
                        <td class="text-right">${item.cenaSaPdv.toFixed(3)}</td>
                        <td class="text-right">${vrijednostSaPdv.toFixed(2)}</td>
                    </tr>
                `;
            });
            
            document.getElementById('print-items-tbody').innerHTML = itemsHTML;
            document.getElementById('print-total-bez-pdv').textContent = totalBezPdv.toFixed(2);
            document.getElementById('print-total-rabat').textContent = totalRabat.toFixed(2);
            document.getElementById('print-osnovica').textContent = totalBezPdv.toFixed(2);
            document.getElementById('print-pdv-iznos').textContent = totalPdv.toFixed(2);
            document.getElementById('print-total-sa-pdv').textContent = totalSaPdv.toFixed(2);
            
            document.getElementById('print-signature-left').textContent = getSignatureText(dokument.tip_dokumenta);
            document.getElementById('print-disclaimer').innerHTML = `<div><strong>${getDisclaimerText(dokument.tip_dokumenta)}</strong></div>`;
            
        } catch (error) {
            console.error('Error generating print document:', error);
            alert('Greška pri pripremi dokumenta za štampu');
        }
    }

    // Submit form
    document.getElementById('edit-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const submitBtn = e.target.querySelector('button[type="submit"]');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Čuvam...';
        
        try {
            const artikli = [];
            document.querySelectorAll('#edit-artikli-tbody tr').forEach(row => {
                artikli.push({
                    sifra: row.querySelector('.artikal-sifra').value || 'N/A',
                    naziv: row.querySelector('.artikal-naziv').value,
                    jm: row.querySelector('.artikal-jm').value,
                    kolicina: parseFloat(row.querySelector('.artikal-kolicina').value),
                    cena_bez_pdv: parseFloat(row.querySelector('.artikal-cena-bez').value),
                    cena_sa_pdv: parseFloat(row.querySelector('.artikal-cena-sa').value),
                    rabat: parseFloat(row.querySelector('.artikal-rabat').value)
                });
            });
            
            const data = {
                datum: document.getElementById('edit-datum').value,
                partner: document.getElementById('edit-partner').value,
                tip_dokumenta: document.getElementById('edit-tip-dokumenta').value,
                komercijalist_id: document.getElementById('edit-komercijalist').value || null,
                artikli: artikli
            };
            
            const dokumentId = document.getElementById('edit-dokument-id').value;
            
            const response = await fetch(`/api/dokumenti/${dokumentId}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });
            
            const result = await response.json();
            
            if (result.success) {
                alert('Dokument je uspešno ažuriran!');
                document.getElementById('edit-modal').classList.remove('show');
                location.reload();
            } else {
                alert('Greška: ' + (result.error || 'Nepoznata greška'));
            }
            
        } catch (error) {
            console.error('Error saving document:', error);
            alert('Greška pri čuvanju dokumenta: ' + error.message);
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-save"></i> Sačuvaj izmene';
        }
    });

    // Document details
    function showDocumentDetails(id) {
        const dokument = dokumentiData.find(d => d.id == id);
        if (!dokument) return;
        
        const detailsHTML = `
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                <div>
                    <strong>ID:</strong> ${dokument.id}<br>
                    <strong>Datum:</strong> ${new Date(dokument.datum).toLocaleDateString('sr-RS')}<br>
                    <strong>Tip dokumenta:</strong> ${dokument.tip_dokumenta}<br>
                    <strong>Partner:</strong> ${dokument.partner}
                </div>
                <div>
                    <strong>Količina:</strong> ${parseFloat(dokument.kolicina).toFixed(2)}<br>
                    <strong>Iznos bez PDV:</strong> ${parseFloat(dokument.iznos_bez_pdv).toFixed(2)} €<br>
                    <strong>PDV iznos:</strong> ${parseFloat(dokument.pdv_iznos).toFixed(2)} €<br>
                    <strong>Iznos sa PDV:</strong> ${parseFloat(dokument.iznos_sa_pdv).toFixed(2)} €<br>
                    <strong>Rabat:</strong> ${parseFloat(dokument.rabat).toFixed(2)} €
                </div>
            </div>
            <div style="margin-bottom: 1rem;">
                <strong>Naziv artikla:</strong>
                <div style="padding: 10px; background-color: #f8f9fa; border-radius: 4px; margin-top: 0.5rem; word-wrap: break-word; white-space: pre-wrap;">${dokument.naziv_artikla}</div>
            </div>
        `;
        
        document.getElementById('document-details-content').innerHTML = detailsHTML;
        window.currentDocumentForPrint = dokument;
        document.getElementById('document-details-modal').classList.add('show');
    }

    document.getElementById('close-details-modal').addEventListener('click', () => {
        document.getElementById('document-details-modal').classList.remove('show');
    });

    document.getElementById('close-details-btn').addEventListener('click', () => {
        document.getElementById('document-details-modal').classList.remove('show');
    });

    document.getElementById('print-from-details-btn').addEventListener('click', async () => {
        if (window.currentDocumentForPrint) {
            await generatePrintDocumentFromId(window.currentDocumentForPrint.id);
            window.print();
        }
    });

    // Helper functions
    function getDocumentTypeForPrint(tipDokumenta) {
        const tip = tipDokumenta.toLowerCase();
        if (tip.includes('otpremnica')) return 'Otpremnica';
        if (tip.includes('predracun')) return 'Predračun';
        if (tip.includes('kalkulacija')) return 'Kalkulacija';
        if (tip.includes('ponuda')) return 'Ponuda';
        return 'Dokument';
    }

    function getSignatureText(tipDokumenta) {
        const tip = tipDokumenta.toLowerCase();
        if (tip.includes('otpremnica')) return 'Otpremio,';
        if (tip.includes('predracun')) return 'Izradio,';
        if (tip.includes('kalkulacija')) return 'Kalkulisao,';
        if (tip.includes('ponuda')) return 'Ponudio,';
        return 'Izdao,';
    }

    function getDisclaimerText(tipDokumenta) {
        const tip = tipDokumenta.toLowerCase();
        if (tip.includes('otpremnica')) return 'OVO NIJE PDV RAČUN!!!';
        if (tip.includes('predracun')) return 'OVO NIJE PDV RAČUN - PREDRAČUN!!!';
        if (tip.includes('kalkulacija')) return 'KALKULACIJA - OVO NIJE PDV RAČUN!!!';
        if (tip.includes('ponuda')) return 'PONUDA - OVO NIJE OBAVEZUJUĆI DOKUMENT!!!';
        return 'OVO NIJE PDV RAČUN!!!';
    }

    async function loadPartnerByName(partnerName) {
        try {
            const partner = sviPartneri.find(p=> 
                (p.Naziv_partnera || p.naziv_partnera || '').toLowerCase() === partnerName.toLowerCase()
            );
            return partner || null;
        } catch (error) {
            console.error('Error loading partner:', error);
            return null;
        }
    }

    // Filter functions
    function applyFilters() {
        const searchTerm = document.getElementById('search-documents').value.toLowerCase();
        const partner = document.getElementById('partner-filter').value;
        const tip = document.getElementById('tip-filter').value;
        const artikal = document.getElementById('artikal-filter').value;
        const fromDate = document.getElementById('date-from').value;
        const toDate = document.getElementById('date-to').value;
        
        filteredData = dokumentiData.filter(item => {
            let passes = true;
            
            if (searchTerm) {
                const searchableText = `${item.partner} ${item.naziv_artikla} ${item.tip_dokumenta}`.toLowerCase();
                if (!searchableText.includes(searchTerm)) {
                    passes = false;
                }
            }
            
            if (partner && item.partner !== partner) {
                passes = false;
            }
            
            if (tip && item.tip_dokumenta !== tip) {
                passes = false;
            }
            
            if (artikal && item.naziv_artikla !== artikal) {
                passes = false;
            }
            
            if (fromDate && toDate) {
                const itemDate = new Date(item.datum);
                const filterFromDate = new Date(fromDate);
                const filterToDate = new Date(toDate);
                
                if (itemDate < filterFromDate || itemDate > filterToDate) {
                    passes = false;
                }
            }
            
            return passes;
        });
        
        filteredData.sort((a, b) => b.id - a.id);
        
        renderDokumentiTable();
    }

    function renderDokumentiTable() {
        const tbody = document.getElementById('dokumenti-tbody');
        tbody.innerHTML = '';
        
        filteredData.forEach((item, index) => {
            const row = document.createElement('tr');
            if (index === 0) {
                row.classList.add('selected');
            }
            
            row.innerHTML = `
                <td>${item.id}</td>
                <td class="date-column">${new Date(item.datum).toLocaleDateString('sr-RS')}</td>
                <td>${item.partner}</td>
                <td class="doc-type-column">${item.tip_dokumenta}</td>
                <td title="${item.naziv_artikla}" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${item.naziv_artikla}</td>
                <td class="price-column">${parseFloat(item.iznos_sa_pdv).toLocaleString('sr-RS', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                <td>
                    <div class="action-buttons">
                        <button class="btn btn-sm btn-info view-document-btn" data-id="${item.id}" title="Pregled">
                            <i class="fas fa-eye"></i>
                        </button>
                        <button class="btn btn-sm btn-warning edit-document-btn" data-id="${item.id}" title="Izmeni">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="btn btn-sm btn-primary print-document-btn" data-id="${item.id}" title="Štampaj">
                            <i class="fas fa-print"></i>
                        </button>
                        <button class="btn btn-sm btn-danger delete-document-btn" data-id="${item.id}" title="Obriši">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </td>
            `;
            
            tbody.appendChild(row);
        });

        document.getElementById('document-count').textContent = `Ukupno: ${filteredData.length} dokumenata`;
    }

    // Event listeners
    document.getElementById('search-documents').addEventListener('input', applyFilters);
    document.getElementById('partner-filter').addEventListener('change', applyFilters);
    document.getElementById('tip-filter').addEventListener('change', applyFilters);
    document.getElementById('artikal-filter').addEventListener('change', applyFilters);
    document.getElementById('date-from').addEventListener('change', applyFilters);
    document.getElementById('date-to').addEventListener('change', applyFilters);
    document.getElementById('apply-filters').addEventListener('click', applyFilters);

    document.getElementById('print-btn').addEventListener('click', () => {
        window.print();
    });

    document.getElementById('export-btn').addEventListener('click', () => {
        const csvContent = "data:text/csv;charset=utf-8," 
            + "ID,Datum,Partner,Tip dokumenta,Naziv artikla,Iznos sa PDV (€)\n"
            + filteredData.map(item => 
                `${item.id},${new Date(item.datum).toLocaleDateString('sr-RS')},${item.partner},${item.tip_dokumenta},${item.naziv_artikla},${item.iznos_sa_pdv}`
            ).join("\n");
        
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", "dokumenti.csv");
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    });

    document.getElementById('refresh-btn').addEventListener('click', () => {
        location.reload();
    });

    window.addEventListener('resize', function() {
        if (window.innerWidth > 576) {
            sidebar.classList.remove('mobile-open');
            sidebarOverlay.classList.remove('show');
            document.body.style.overflow = '';
        }
    });

    window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            if (document.getElementById('edit-modal').classList.contains('show')) {
                document.getElementById('edit-modal').classList.remove('show');
            } else if (document.getElementById('document-details-modal').classList.contains('show')) {
                document.getElementById('document-details-modal').classList.remove('show');
            } else if (sidebar.classList.contains('mobile-open')) {
                sidebar.classList.remove('mobile-open');
                sidebarOverlay.classList.remove('show');
                document.body.style.overflow = '';
            }
        }
    });

    console.log('Tehnolux Pregled dokumenata initialized - prices loaded directly from LAGER database');
</script>
</body>
</html>