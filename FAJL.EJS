    <script>
        // Pass server data to JavaScript
        const lagerArtikli = <%- JSON.stringify(lagerArtikli) %>;
        const sviPartneri = <%- JSON.stringify(sviPartneri) %>;
        const komercijalisti = <%- JSON.stringify(komercijalisti) %>;
        const dokumentiData = <%- JSON.stringify(dokumenti) %>;

        let currentEditingDocument = null;
        let filteredData = [...dokumentiData];

        // Sidebar toggle
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.getElementById('main-content');
        const header = document.getElementById('header');
        const toggleSidebar = document.getElementById('toggle-sidebar');
        const sidebarIcon = document.getElementById('sidebar-icon');
        const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
        const sidebarOverlay = document.getElementById('sidebar-overlay');

        toggleSidebar.addEventListener('click', function() {
            sidebar.classList.toggle('collapsed');
            mainContent.classList.toggle('expanded');
            header.classList.toggle('expanded');
            
            if (sidebar.classList.contains('collapsed')) {
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            } else {
                sidebarIcon.classList.remove('fa-chevron-right');
                sidebarIcon.classList.add('fa-chevron-left');
            }
        });

        // Mobile menu
        mobileMenuToggle.addEventListener('click', function() {
            sidebar.classList.toggle('mobile-open');
            sidebarOverlay.classList.toggle('show');
            
            if (sidebar.classList.contains('mobile-open')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = '';
            }
        });

        sidebarOverlay.addEventListener('click', function() {
            sidebar.classList.remove('mobile-open');
            sidebarOverlay.classList.remove('show');
            document.body.style.overflow = '';
        });

        // Submenu functionality
        document.querySelectorAll('.nav-item.has-submenu > .nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const parent = this.parentElement;
                const submenu = parent.querySelector('.submenu');
                
                document.querySelectorAll('.nav-item.has-submenu').forEach(item => {
                    if (item !== parent) {
                        item.classList.remove('open');
                        item.querySelector('.submenu').classList.remove('open');
                    }
                });
                
                parent.classList.toggle('open');
                submenu.classList.toggle('open');
            });
        });

        // EDIT MODAL FUNCTIONS
        document.addEventListener('click', async (e) => {
            if (e.target.closest('.edit-document-btn')) {
                const id = e.target.closest('.edit-document-btn').dataset.id;
                await openEditModal(id);
            }

            if (e.target.closest('.view-document-btn')) {
                const id = e.target.closest('.view-document-btn').dataset.id;
                showDocumentDetails(id);
            }

            if (e.target.closest('.print-document-btn')) {
                const id = e.target.closest('.print-document-btn').dataset.id;
                const dokument = dokumentiData.find(d => d.id == id);
                if (dokument) {
                    await generatePrintDocumentFromData(dokument);
                    window.print();
                }
            }

            if (e.target.closest('.delete-document-btn')) {
                const id = e.target.closest('.delete-document-btn').dataset.id;
                if (confirm('Da li ste sigurni da želite da obrišete ovaj dokument?')) {
                    alert('Funkcija brisanja će biti implementirana');
                }
            }
        });

        async function openEditModal(id) {
            try {
                const response = await fetch(`/api/dokumenti/${id}`);
                const data = await response.json();
                
                if (!data.success) {
                    alert('Greška pri učitavanju dokumenta');
                    return;
                }
                
                currentEditingDocument = data;
                
                document.getElementById('edit-dokument-id').value = data.dokument.id;
                document.getElementById('edit-datum').value = new Date(data.dokument.datum).toISOString().split('T')[0];
                document.getElementById('edit-partner').value = data.dokument.partner;
                document.getElementById('edit-tip-dokumenta').value = data.dokument.tip_dokumenta;
                document.getElementById('edit-komercijalist').value = data.dokument.komercijalist_id || '';
                
                populateEditArtikliTable(data.artikli);
                
                document.getElementById('edit-modal').classList.add('show');
                
            } catch (error) {
                console.error('Error loading document:', error);
                alert('Greška pri učitavanju dokumenta');
            }
        }

        function populateEditArtikliTable(artikli) {
            const tbody = document.getElementById('edit-artikli-tbody');
            tbody.innerHTML = '';
            
            artikli.forEach((artikal, index) => {
                addEditRow(artikal, index);
            });
            
            recalculateEditTotals();
        }

        function addEditRow(artikal = null, index = null) {
            const tbody = document.getElementById('edit-artikli-tbody');
            const rowIndex = index !== null ? index : tbody.children.length;
            
            const row = document.createElement('tr');
            row.dataset.rowIndex = rowIndex;
            
            const sifraOptions = lagerArtikli.map(la => `
                <option value="${la.sifra}" 
                        data-naziv="${la.naziv}"
                        data-jm="${la.jm || la.JM}"
                        data-cena-bez="${la.cena_bez_PDV}"
                        data-cena-sa="${la.cena_sa_PDV}"
                        ${artikal && artikal.sifra === la.sifra ? 'selected' : ''}>
                    ${la.sifra}
                </option>
            `).join('');
            
            row.innerHTML = `
                <td>${rowIndex + 1}</td>
                <td>
                    <select class="artikal-select" onchange="populateEditArtikalData(this)">
                        <option value="">-</option>
                        ${sifraOptions}
                    </select>
                </td>
                <td><input type="text" class="artikal-naziv" value="${artikal ? artikal.naziv : ''}" required></td>
                <td><input type="text" class="artikal-jm" value="${artikal ? artikal.jm : 'kom'}" required></td>
                <td><input type="number" class="artikal-kolicina numeric-input" value="${artikal ? artikal.kolicina : 1}" step="0.01" min="0.01" required oninput="calculateEditRow(this)"></td>
                <td><input type="number" class="artikal-cena-bez numeric-input" value="${artikal ? parseFloat(artikal.cena_bez_pdv).toFixed(2) : 0}" step="0.01" min="0" required oninput="calculateEditRow(this)"></td>
                <td><input type="number" class="artikal-cena-sa numeric-input" value="${artikal ? parseFloat(artikal.cena_sa_pdv).toFixed(2) : 0}" step="0.01" min="0" required oninput="calculateEditRow(this)"></td>
                <td><input type="number" class="artikal-rabat numeric-input" value="${artikal ? parseFloat(artikal.rabat).toFixed(1) : 0}" step="0.1" min="0" max="100" oninput="calculateEditRow(this)"></td>
                <td><input type="text" class="artikal-total-bez numeric-input" readonly></td>
                <td><input type="text" class="artikal-total-sa numeric-input" readonly></td>
                <td>
                    <button type="button" class="btn-remove-row" onclick="removeEditRow(this)">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            `;
            
            tbody.appendChild(row);
            
            if (artikal) {
                calculateEditRow(row.querySelector('.artikal-kolicina'));
            }
            
            updateEditRowNumbers();
        }

        function populateEditArtikalData(select) {
            const row = select.closest('tr');
            const selectedOption = select.options[select.selectedIndex];
            
            if (selectedOption.value) {
                row.querySelector('.artikal-naziv').value = selectedOption.dataset.naziv;
                row.querySelector('.artikal-jm').value = selectedOption.dataset.jm;
                row.querySelector('.artikal-cena-bez').value = parseFloat(selectedOption.dataset.cenaBez).toFixed(2);
                row.querySelector('.artikal-cena-sa').value = parseFloat(selectedOption.dataset.cenaSa).toFixed(2);
                
                calculateEditRow(row.querySelector('.artikal-kolicina'));
            }
        }

        function calculateEditRow(input) {
            const row = input.closest('tr');
            
            const kolicina = parseFloat(row.querySelector('.artikal-kolicina').value) || 0;
            const cenaBez = parseFloat(row.querySelector('.artikal-cena-bez').value) || 0;
            const cenaSa = parseFloat(row.querySelector('.artikal-cena-sa').value) || 0;
            const rabat = parseFloat(row.querySelector('.artikal-rabat').value) || 0;
            
            const totalBezBefore = cenaBez * kolicina;
            const rabatAmount = totalBezBefore * (rabat / 100);
            const totalBez = totalBezBefore - rabatAmount;
            
            const totalSaBefore = cenaSa * kolicina;
            const rabatAmountSa = totalSaBefore * (rabat / 100);
            const totalSa = totalSaBefore - rabatAmountSa;
            
            row.querySelector('.artikal-total-bez').value = totalBez.toFixed(2);
            row.querySelector('.artikal-total-sa').value = totalSa.toFixed(2);
            
            recalculateEditTotals();
        }

        function recalculateEditTotals() {
            let totalKolicina = 0;
            let totalBezPdv = 0;
            let totalSaPdv = 0;
            
            document.querySelectorAll('#edit-artikli-tbody tr').forEach(row => {
                const kolicina = parseFloat(row.querySelector('.artikal-kolicina').value) || 0;
                const totalBez = parseFloat(row.querySelector('.artikal-total-bez').value) || 0;
                const totalSa = parseFloat(row.querySelector('.artikal-total-sa').value) || 0;
                
                totalKolicina += kolicina;
                totalBezPdv += totalBez;
                totalSaPdv += totalSa;
            });
            
            const totalPdv = totalSaPdv - totalBezPdv;
            
            document.getElementById('edit-total-kolicina').textContent = totalKolicina.toFixed(2);
            document.getElementById('edit-total-bez-pdv').textContent = totalBezPdv.toFixed(2) + ' €';
            document.getElementById('edit-total-pdv').textContent = totalPdv.toFixed(2) + ' €';
            document.getElementById('edit-total-sa-pdv').textContent = totalSaPdv.toFixed(2) + ' €';
        }

        function removeEditRow(btn) {
            const tbody = document.getElementById('edit-artikli-tbody');
            if (tbody.children.length <= 1) {
                alert('Morate imati najmanje jedan artikal u dokumentu.');
                return;
            }
            
            btn.closest('tr').remove();
            updateEditRowNumbers();
            recalculateEditTotals();
        }

        function updateEditRowNumbers() {
            document.querySelectorAll('#edit-artikli-tbody tr').forEach((row, index) => {
                row.dataset.rowIndex = index;
                row.cells[0].textContent = index + 1;
            });
        }

        // Close modal
        document.getElementById('close-edit-modal').addEventListener('click', () => {
            document.getElementById('edit-modal').classList.remove('show');
        });

        document.getElementById('cancel-edit-btn').addEventListener('click', () => {
            document.getElementById('edit-modal').classList.remove('show');
        });

        document.getElementById('edit-modal').addEventListener('click', (e) => {
            if (e.target === document.getElementById('edit-modal')) {
                document.getElementById('edit-modal').classList.remove('show');
            }
        });

        // Submit form
        document.getElementById('edit-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const submitBtn = e.target.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Čuvam...';
            
            try {
                const artikli = [];
                document.querySelectorAll('#edit-artikli-tbody tr').forEach(row => {
                    const select = row.querySelector('.artikal-select');
                    const selectedOption = select.options[select.selectedIndex];
                    
                    artikli.push({
                        sifra: selectedOption.value || 'N/A',
                        naziv: row.querySelector('.artikal-naziv').value,
                        jm: row.querySelector('.artikal-jm').value,
                        kolicina: parseFloat(row.querySelector('.artikal-kolicina').value),
                        cena_bez_pdv: parseFloat(row.querySelector('.artikal-cena-bez').value),
                        cena_sa_pdv: parseFloat(row.querySelector('.artikal-cena-sa').value),
                        rabat: parseFloat(row.querySelector('.artikal-rabat').value)
                    });
                });
                
                const data = {
                    datum: document.getElementById('edit-datum').value,
                    partner: document.getElementById('edit-partner').value,
                    tip_dokumenta: document.getElementById('edit-tip-dokumenta').value,
                    komercijalist_id: document.getElementById('edit-komercijalist').value || null,
                    artikli: artikli
                };
                
                const dokumentId = document.getElementById('edit-dokument-id').value;
                
                const response = await fetch(`/api/dokumenti/${dokumentId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert('Dokument je uspešno ažuriran!');
                    document.getElementById('edit-modal').classList.remove('show');
                    location.reload();
                } else {
                    alert('Greška: ' + (result.error || 'Nepoznata greška'));
                }
                
            } catch (error) {
                console.error('Error saving document:', error);
                alert('Greška pri čuvanju dokumenta: ' + error.message);
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-save"></i> Sačuvaj izmene';
            }
        });

        // Document details
        function showDocumentDetails(id) {
            const dokument = dokumentiData.find(d => d.id == id);
            if (!dokument) return;
            
            const detailsHTML = `
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                    <div>
                        <strong>ID:</strong> ${dokument.id}<br>
                        <strong>Datum:</strong> ${new Date(dokument.datum).toLocaleDateString('sr-RS')}<br>
                        <strong>Tip dokumenta:</strong> ${dokument.tip_dokumenta}<br>
                        <strong>Partner:</strong> ${dokument.partner}
                    </div>
                    <div>
                        <strong>Količina:</strong> ${parseFloat(dokument.kolicina).toFixed(2)}<br>
                        <strong>Iznos bez PDV:</strong> ${parseFloat(dokument.iznos_bez_pdv).toFixed(2)} €<br>
                        <strong>PDV iznos:</strong> ${parseFloat(dokument.pdv_iznos).toFixed(2)} €<br>
                        <strong>Iznos sa PDV:</strong> ${parseFloat(dokument.iznos_sa_pdv).toFixed(2)} €<br>
                        <strong>Rabat:</strong> ${parseFloat(dokument.rabat).toFixed(2)} €
                    </div>
                </div>
                <div style="margin-bottom: 1rem;">
                    <strong>Naziv artikla:</strong>
                    <div style="padding: 10px; background-color: #f8f9fa; border-radius: 4px; margin-top: 0.5rem; word-wrap: break-word; white-space: pre-wrap;">${dokument.naziv_artikla}</div>
                </div>
            `;
            
            document.getElementById('document-details-content').innerHTML = detailsHTML;
            window.currentDocumentForPrint = dokument;
            document.getElementById('document-details-modal').classList.add('show');
        }

        document.getElementById('close-details-modal').addEventListener('click', () => {
            document.getElementById('document-details-modal').classList.remove('show');
        });

        document.getElementById('close-details-btn').addEventListener('click', () => {
            document.getElementById('document-details-modal').classList.remove('show');
        });

        document.getElementById('print-from-details-btn').addEventListener('click', async () => {
            if (window.currentDocumentForPrint) {
                await generatePrintDocumentFromData(window.currentDocumentForPrint);
                window.print();
            }
        });

        // Print functions
        async function generatePrintDocumentFromData(documentData) {
            const today = new Date();
            const formattedDate = `${String(today.getDate()).padStart(2, '0')}.${String(today.getMonth() + 1).padStart(2, '0')}.${today.getFullYear()}`;
            
            const docNumberMatch = documentData.tip_dokumenta.match(/(\d{3}-\d{6})/);
            const docNumber = docNumberMatch ? docNumberMatch[1] : 'N/A';
            
            const documentType = getDocumentTypeForPrint(documentData.tip_dokumenta);
            
            const partner = await loadPartnerByName(documentData.partner);
            
            document.getElementById('print-date').textContent = formattedDate;
            document.getElementById('print-document-type').textContent = documentType;
            document.getElementById('print-doc-number').textContent = docNumber;
            
            if (partner) {
                document.getElementById('print-customer-code').textContent = partner.Sifra || partner.sifra || '';
                document.getElementById('print-customer-name').textContent = partner.Naziv_partnera || partner.naziv_partnera || documentData.partner;
                document.getElementById('print-customer-pib').textContent = partner.PIB || partner.pib || '';
                document.getElementById('print-customer-pdv').textContent = partner.PDV || partner.pdv || '';
                document.getElementById('print-customer-address').textContent = partner.Adresa || partner.adresa || '';
                document.getElementById('print-customer-city').textContent = partner.Grad || partner.grad || '';
            } else {
                document.getElementById('print-customer-code').textContent = 'N/A';
                document.getElementById('print-customer-name').textContent = documentData.partner;
                document.getElementById('print-customer-pib').textContent = '';
                document.getElementById('print-customer-pdv').textContent = '';
                document.getElementById('print-customer-address').textContent = '';
                document.getElementById('print-customer-city').textContent = '';
            }
            
            const articles = parseArticlesFromDocument(
                documentData.naziv_artikla,
                parseFloat(documentData.kolicina),
                parseFloat(documentData.iznos_bez_pdv) / parseFloat(documentData.kolicina),
                parseFloat(documentData.iznos_sa_pdv) / parseFloat(documentData.kolicina),
                parseFloat(documentData.rabat) || 0,
                21
            );
            
            let itemsHTML = '';
            let totalBezPdv = 0;
            let totalRabat = parseFloat(documentData.rabat) || 0;
            let totalPdv = parseFloat(documentData.pdv_iznos) || 0;
            let totalSaPdv = parseFloat(documentData.iznos_sa_pdv) || 0;
            
            articles.forEach((item, index) => {
                const vrijednostBezPdv = item.cenaBezPdv * item.kolicina;
                const rabatIznos = vrijednostBezPdv * (item.rabat / 100);
                const vrijednostBezPdvSaRabatom = vrijednostBezPdv - rabatIznos;
                const pdvIznos = vrijednostBezPdvSaRabatom * (item.pdvStopa / 100);
                const vrijednostSaPdv = item.cenaSaPdv * item.kolicina;
                
                totalBezPdv += vrijednostBezPdvSaRabatom;
                
                itemsHTML += `
                    <tr>
                        <td>${item.rb}</td>
                        <td>${item.sifra}</td>
                        <td class="text-left">${item.naziv}</td>
                        <td>${item.jm}</td>
                        <td>${item.kolicina}</td>
                        <td class="text-right">${item.cenaBezPdv.toFixed(3)}</td>
                        <td class="text-right">${vrijednostBezPdv.toFixed(2)}</td>
                        <td class="text-right">${item.rabat.toFixed(1)}%</td>
                        <td class="text-right">${item.pdvStopa.toFixed(0)}%</td>
                        <td class="text-right">${pdvIznos.toFixed(2)}</td>
                        <td class="text-right">${item.cenaSaPdv.toFixed(3)}</td>
                        <td class="text-right">${vrijednostSaPdv.toFixed(2)}</td>
                    </tr>
                `;
            });
            
            document.getElementById('print-items-tbody').innerHTML = itemsHTML;
            document.getElementById('print-total-bez-pdv').textContent = totalBezPdv.toFixed(2);
            document.getElementById('print-total-rabat').textContent = totalRabat.toFixed(2);
            document.getElementById('print-osnovica').textContent = totalBezPdv.toFixed(2);
            document.getElementById('print-pdv-iznos').textContent = totalPdv.toFixed(2);
            document.getElementById('print-total-sa-pdv').textContent = totalSaPdv.toFixed(2);
            
            document.getElementById('print-signature-left').textContent = getSignatureText(documentData.tip_dokumenta);
            document.getElementById('print-disclaimer').innerHTML = `<div><strong>${getDisclaimerText(documentData.tip_dokumenta)}</strong></div>`;
        }

        function getDocumentTypeForPrint(tipDokumenta) {
            const tip = tipDokumenta.toLowerCase();
            if (tip.includes('otpremnica')) return 'Otpremnica';
            if (tip.includes('predracun')) return 'Predračun';
            if (tip.includes('kalkulacija')) return 'Kalkulacija';
            if (tip.includes('ponuda')) return 'Ponuda';
            return 'Dokument';
        }

        function getSignatureText(tipDokumenta) {
            const tip = tipDokumenta.toLowerCase();
            if (tip.includes('otpremnica')) return 'Otpremio,';
            if (tip.includes('predracun')) return 'Izradio,';
            if (tip.includes('kalkulacija')) return 'Kalkulisao,';
            if (tip.includes('ponuda')) return 'Ponudio,';
            return 'Izdao,';
        }

        function getDisclaimerText(tipDokumenta) {
            const tip = tipDokumenta.toLowerCase();
            if (tip.includes('otpremnica')) return 'OVO NIJE PDV RAČUN!!!';
            if (tip.includes('predracun')) return 'OVO NIJE PDV RAČUN - PREDRAČUN!!!';
            if (tip.includes('kalkulacija')) return 'KALKULACIJA - OVO NIJE PDV RAČUN!!!';
            if (tip.includes('ponuda')) return 'PONUDA - OVO NIJE OBAVEZUJUĆI DOKUMENT!!!';
            return 'OVO NIJE PDV RAČUN!!!';
        }

        async function loadPartnerByName(partnerName) {
            try {
                const partner = sviPartneri.find(p => 
                    (p.Naziv_partnera || p.naziv_partnera || '').toLowerCase() === partnerName.toLowerCase()
                );
                return partner || null;
            } catch (error) {
                console.error('Error loading partner:', error);
                return null;
            }
        }

        function parseArticlesFromDocument(nazivArtikla, kolicina, cenaBezPdv, cenaSaPdv, rabat, pdvStopa) {
            if (nazivArtikla.includes(',') && nazivArtikla.includes(' - ')) {
                const articles = [];
                const parts = nazivArtikla.split(', ');
                let articleIndex = 1;
                
                parts.forEach(part => {
                    const match = part.match(/^(.+?)\s-\s(.+?)\s\((.+?)\s(.+?)\)$/);
                    if (match) {
                        const [, sifra, naziv, qty, jm] = match;
                        articles.push({
                            rb: articleIndex++,
                            sifra: sifra.trim(),
                            naziv: naziv.trim(),
                            jm: jm.trim(),
                            kolicina: parseFloat(qty) || 1,
                            cenaBezPdv: cenaBezPdv / parts.length,
                            cenaSaPdv: cenaSaPdv / parts.length,
                            rabat: rabat || 0,
                            pdvStopa: pdvStopa || 21
                        });
                    }
                });
                
                return articles.length > 0 ? articles : [{
                    rb: 1,
                    sifra: 'N/A',
                    naziv: nazivArtikla,
                    jm: 'kom',
                    kolicina: kolicina,
                    cenaBezPdv: cenaBezPdv,
                    cenaSaPdv: cenaSaPdv,
                    rabat: rabat || 0,
                    pdvStopa: pdvStopa || 21
                }];
            } else {
                return [{
                    rb: 1,
                    sifra: 'N/A',
                    naziv: nazivArtikla,
                    jm: 'kom',
                    kolicina: kolicina,
                    cenaBezPdv: cenaBezPdv,
                    cenaSaPdv: cenaSaPdv,
                    rabat: rabat || 0,
                    pdvStopa: pdvStopa || 21
                }];
            }
        }

        // Filter functions
        function applyFilters() {
            const searchTerm = document.getElementById('search-documents').value.toLowerCase();
            const partner = document.getElementById('partner-filter').value;
            const tip = document.getElementById('tip-filter').value;
            const artikal = document.getElementById('artikal-filter').value;
            const fromDate = document.getElementById('date-from').value;
            const toDate = document.getElementById('date-to').value;
            
            filteredData = dokumentiData.filter(item => {
                let passes = true;
                
                if (searchTerm) {
                    const searchableText = `${item.partner} ${item.naziv_artikla} ${item.tip_dokumenta}`.toLowerCase();
                    if (!searchableText.includes(searchTerm)) {
                        passes = false;
                    }
                }
                
                if (partner && item.partner !== partner) {
                    passes = false;
                }
                
                if (tip && item.tip_dokumenta !== tip) {
                    passes = false;
                }
                
                if (artikal && item.naziv_artikla !== artikal) {
                    passes = false;
                }
                
                if (fromDate && toDate) {
                    const itemDate = new Date(item.datum);
                    const filterFromDate = new Date(fromDate);
                    const filterToDate = new Date(toDate);
                    
                    if (itemDate < filterFromDate || itemDate > filterToDate) {
                        passes = false;
                    }
                }
                
                return passes;
            });
            
            renderDokumentiTable();
        }

        function renderDokumentiTable() {
            const tbody = document.getElementById('dokumenti-tbody');
            tbody.innerHTML = '';
            
            filteredData.forEach((item, index) => {
                const row = document.createElement('tr');
                if (index === 0) {
                    row.classList.add('selected');
                }
                
                row.innerHTML = `
                    <td>${item.id}</td>
                    <td class="date-column">${new Date(item.datum).toLocaleDateString('sr-RS')}</td>
                    <td>${item.partner}</td>
                    <td class="doc-type-column">${item.tip_dokumenta}</td>
                    <td title="${item.naziv_artikla}" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${item.naziv_artikla}</td>
                    <td class="price-column">${parseFloat(item.iznos_sa_pdv).toLocaleString('sr-RS', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                    <td>
                        <div class="action-buttons">
                            <button class="btn btn-sm btn-info view-document-btn" data-id="${item.id}" title="Pregled">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="btn btn-sm btn-warning edit-document-btn" data-id="${item.id}" title="Izmeni">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-primary print-document-btn" data-id="${item.id}" title="Štampaj">
                                <i class="fas fa-print"></i>
                            </button>
                            <button class="btn btn-sm btn-danger delete-document-btn" data-id="${item.id}" title="Obriši">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                `;
                
                tbody.appendChild(row);
            });

            document.getElementById('document-count').textContent = `Ukupno: ${filteredData.length} dokumenata`;
        }

        // Event listeners
        document.getElementById('search-documents').addEventListener('input', applyFilters);
        document.getElementById('partner-filter').addEventListener('change', applyFilters);
        document.getElementById('tip-filter').addEventListener('change', applyFilters);
        document.getElementById('artikal-filter').addEventListener('change', applyFilters);
        document.getElementById('date-from').addEventListener('change', applyFilters);
        document.getElementById('date-to').addEventListener('change', applyFilters);
        document.getElementById('apply-filters').addEventListener('click', applyFilters);

        document.getElementById('print-btn').addEventListener('click', () => {
            window.print();
        });

        document.getElementById('export-btn').addEventListener('click', () => {
            const csvContent = "data:text/csv;charset=utf-8," 
                + "ID,Datum,Partner,Tip dokumenta,Naziv artikla,Iznos sa PDV (€)\n"
                + filteredData.map(item => 
                    `${item.id},${new Date(item.datum).toLocaleDateString('sr-RS')},${item.partner},${item.tip_dokumenta},${item.naziv_artikla},${item.iznos_sa_pdv}`
                ).join("\n");
            
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "dokumenti.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });

        document.getElementById('refresh-btn').addEventListener('click', () => {
            location.reload();
        });

        window.addEventListener('resize', function() {
            if (window.innerWidth > 576) {
                sidebar.classList.remove('mobile-open');
                sidebarOverlay.classList.remove('show');
                document.body.style.overflow = '';
            }
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (document.getElementById('edit-modal').classList.contains('show')) {
                    document.getElementById('edit-modal').classList.remove('show');
                } else if (document.getElementById('document-details-modal').classList.contains('show')) {
                    document.getElementById('document-details-modal').classList.remove('show');
                } else if (sidebar.classList.contains('mobile-open')) {
                    sidebar.classList.remove('mobile-open');
                    sidebarOverlay.classList.remove('show');
                    document.body.style.overflow = '';
                }
            }
        });

        console.log('Tehnolux Pregled dokumenata initialized with edit functionality');
    </script>
</body>
</html>