        document.getElementById('print-customer-address').textContent = '';
        document.getElementById('print-customer-city').textContent = '';
    }
    
    // 🔴 KLJUČNA IZMENA: Uzmi artikle DIREKTNO IZ TABELE (tačne cene iz input polja!)
    const artikli = [];
    document.querySelectorAll('#edit-artikli-tbody tr').forEach((row, index) => {
        let nazivArtikla = row.querySelector('.artikal-naziv').value;
        nazivArtikla = nazivArtikla.replace(/\n/g, ' ').trim();
        
        // 🔴 UZIMAMO TAČNE VREDNOSTI IZ INPUT POLJA
