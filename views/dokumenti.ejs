                    <span id="document-count" style="color: #666; font-size: 14px;">Ukupno: <%= dokumenti.length %> dokumenata</span>
                    <button class="btn btn-primary btn-sm" id="apply-filters">
                        <i class="fas fa-filter"></i> Primeni filtere
                    </button>
                </div>
            </div>

            <div class="table-container">
                <table class="data-table" id="dokumenti-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Datum</th>
                            <th>Partner</th>
                            <th>Tip dokumenta</th>
                            <th>Naziv artikla</th>
                            <th>Magacin</th>
                            <th>Iznos sa PDV (€)</th>
                            <th>Akcije</th>
                        </tr>
                    </thead>
                    <tbody id="dokumenti-tbody">
                        <% dokumenti.forEach((dokument, index) => { %>
                            <tr <%= index === 0 ? 'class="selected"' : '' %>>
                                <td><%= dokument.id %></td>
                                <td class="date-column"><%= new Date(dokument.datum).toLocaleDateString('sr-RS') %></td>
                                <td><%= dokument.partner %></td>
                                <td class="doc-type-column"><%= dokument.tip_dokumenta %></td>
                                <td title="<%= dokument.naziv_artikla %>" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
