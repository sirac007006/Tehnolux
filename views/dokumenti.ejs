                const tipDokumenta = row.cells[3].textContent;
                const partner = row.cells[2].textContent;
                
                const potvrda = confirm(`Da li ste sigurni da želite da obrišete dokument?\n\nTip: ${tipDokumenta}\nPartner: ${partner}\n\n${tipDokumenta.toLowerCase().includes('otpremnica') || tipDokumenta.toLowerCase().includes('kalkulacija') ? 'NAPOMENA: Količina će biti vraćena na lager!' : ''}`);
                
                if (potvrda) {
