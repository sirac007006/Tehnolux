        // Cena sa PDV nakon rabata
        const cenaSaPdvSaRabatom = (iznosSaPdv / item.kolicina) || 0;
        
        totalBezPdvPreRabata += iznosBezPdvPreRabata;
        totalRabat += rabatIznos;
