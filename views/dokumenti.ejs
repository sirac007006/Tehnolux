            const toDate = document.getElementById('date-to').value;
            
            filteredData = dokumentiData.filter(item => {
                let passes = true;
                
                if (searchTerm) {
                    const searchableText = `${item.partner} ${item.naziv_artikla} ${item.tip_dokumenta} ${item.magacin || ''}`.toLowerCase();
                    if (!searchableText.includes(searchTerm)) {
                        passes = false;
                    }
                }
                
                if (partner && item.partner !== partner) {
                    passes = false;
                }
                
                if (tip && !item.tip_dokumenta.toLowerCase().startsWith(tip.toLowerCase())) {
                    passes = false;
                }
                
                if (magacin && item.magacin !== magacin) {
                    passes = false;
                }
                
                if (fromDate && toDate) {
                    const itemDate = new Date(item.datum);
                    const filterFromDate = new Date(fromDate);
                    const filterToDate = new Date(toDate);
                    
                    if (itemDate < filterFromDate || itemDate > filterToDate) {
                        passes = false;
                    }
                }
                
                return passes;
            });
            
            filteredData.sort((a, b) => b.id - a.id);
            
            renderDokumentiTable();
        }

        // Funkcije za formatiranje datuma po srpskom standardu
        function formatDateToSrpski(date) {
            const dan = date.getDate().toString().padStart(2, '0');
            const mjesec = (date.getMonth() + 1).toString().padStart(2, '0');
            const godina = date.getFullYear();
            return `${dan}/${mjesec}/${godina}`;
        }

        function parseSrpskiDate(dateString) {
            const parts = dateString.split('/');
            if (parts.length === 3) {
                const dan = parseInt(parts[0], 10);
                const mjesec = parseInt(parts[1], 10) - 1;
                const godina = parseInt(parts[2], 10);
                return new Date(godina, mjesec, dan);
            }
            return new Date(dateString);
        }

        // Validacija srpskog formata datuma
        function isValidSrpskiDate(dateString) {
            const pattern = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/;
            return pattern.test(dateString);
        }

        // Ažurirajte applyFilters funkciju da koristi srpski format
        function applyFilters() {
            const searchTerm = document.getElementById('search-documents').value.toLowerCase();
            const partner = document.getElementById('partner-filter').value;
            const tip = document.getElementById('tip-filter').value;
            const magacin = document.getElementById('magacin-filter').value;
            const fromDateStr = document.getElementById('date-from').value;
            const toDateStr = document.getElementById('date-to').value;
            
            let fromDate = null;
            let toDate = null;
            
            // Parsiranje srpskog formata datuma
            if (fromDateStr && isValidSrpskiDate(fromDateStr)) {
                fromDate = parseSrpskiDate(fromDateStr);
            }
            
            if (toDateStr && isValidSrpskiDate(toDateStr)) {
                toDate = parseSrpskiDate(toDateStr);
            }
            
            filteredData = dokumentiData.filter(item => {
                let passes = true;
                
                if (searchTerm) {
                    const searchableText = `${item.partner} ${item.naziv_artikla} ${item.tip_dokumenta} ${item.magacin || ''}`.toLowerCase();
                    if (!searchableText.includes(searchTerm)) {
                        passes = false;
                    }
                }
                
                if (partner && item.partner !== partner) {
                    passes = false;
                }
                
                if (tip && !item.tip_dokumenta.toLowerCase().startsWith(tip.toLowerCase())) {
                    passes = false;
                }
                
                if (magacin && item.magacin !== magacin) {
                    passes = false;
                }
                
                if (fromDate && toDate) {
                    const itemDate = new Date(item.datum);
                    
                    if (itemDate < fromDate || itemDate > toDate) {
                        passes = false;
                    }
                }
                
                return passes;
            });
            
            filteredData.sort((a, b) => b.id - a.id);
            
            renderDokumentiTable();
        }

        // Dodajte event listenere za validaciju datuma
        document.addEventListener('DOMContentLoaded', function() {
            const dateInputs = document.querySelectorAll('.date-input');
            
            dateInputs.forEach(input => {
                input.addEventListener('blur', function() {
                    if (this.value && !isValidSrpskiDate(this.value)) {
                        this.style.borderColor = 'var(--accent-color)';
                        alert('Molimo unesite datum u formatu dd/mm/yyyy (npr. 31/01/2025)');
                    } else {
                        this.style.borderColor = '';
                    }
                });
                
                // Opciono: dodajte masku za unos
                input.addEventListener('input', function(e) {
                    let value = e.target.value.replace(/\D/g, '');
                    if (value.length >= 2) {
                        value = value.substring(0, 2) + '/' + value.substring(2);
                    }
                    if (value.length >= 5) {
                        value = value.substring(0, 5) + '/' + value.substring(5, 9);
                    }
                    e.target.value = value;
                });
            });
        });

        function renderDokumentiTable() {
            const tbody = document.getElementById('dokumenti-tbody');
            tbody.innerHTML = '';
            
            filteredData.forEach((item, index) => {
                const row = document.createElement('tr');
                if (index === 0) {
                    row.classList.add('selected');
                }

                // ISPRAVLJENO: Srpski format datuma u tabeli (dan/mjesec/godina)
                const itemDate = new Date(item.datum);
                const formattedDate = `${itemDate.getDate()}.${itemDate.getMonth() + 1}.${itemDate.getFullYear()}`;

                row.innerHTML = `
                    <td>${item.id}</td>
                    <td class="date-column">${formattedDate}</td>
                    <td>${item.partner}</td>
                    <td class="doc-type-column">${item.tip_dokumenta}</td>
                    <td title="${item.naziv_artikla}" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${item.naziv_artikla}</td>
                    <td>${item.magacin || 'N/A'}</td>
                    <td class="price-column">${parseFloat(item.iznos_sa_pdv).toLocaleString('sr-RS', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                    <td>
                        <div class="action-buttons">
                            <button class="btn btn-sm btn-info view-document-btn" data-id="${item.id}" title="Pregled">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="btn btn-sm btn-warning edit-document-btn" data-id="${item.id}" title="Izmeni">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-primary print-document-btn" data-id="${item.id}" title="Štampaj">
                                <i class="fas fa-print"></i>
                            </button>
                            <button class="btn btn-sm btn-danger delete-document-btn" data-id="${item.id}" title="Obriši">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                `;
                
                tbody.appendChild(row);
            });

            document.getElementById('document-count').textContent = `Ukupno: ${filteredData.length} dokumenata`;
        }

        document.getElementById('search-documents').addEventListener('input', applyFilters);
        document.getElementById('partner-filter').addEventListener('change', applyFilters);
        document.getElementById('tip-filter').addEventListener('change', applyFilters);
        document.getElementById('magacin-filter').addEventListener('change', applyFilters);
        document.getElementById('date-from').addEventListener('change', applyFilters);
        document.getElementById('date-to').addEventListener('change', applyFilters);
        document.getElementById('apply-filters').addEventListener('click', applyFilters);

        document.getElementById('print-btn').addEventListener('click', () => {
            window.print();
        });

        document.getElementById('export-btn').addEventListener('click', () => {
            const csvContent = "data:text/csv;charset=utf-8," 
                + "ID,Datum,Partner,Tip dokumenta,Naziv artikla,Iznos sa PDV (€)\n"
                + filteredData.map(item => 
                    `${item.id},${new Date(item.datum).toLocaleDateString('sr-RS')},${item.partner},${item.tip_dokumenta},${item.naziv_artikla},${item.iznos_sa_pdv}`
                ).join("\n");
            
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "dokumenti.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });

        document.getElementById('refresh-btn').addEventListener('click', () => {
            location.reload();
        });

        window.addEventListener('resize', function() {
            if (window.innerWidth > 576) {
                sidebar.classList.remove('mobile-open');
                sidebarOverlay.classList.remove('show');
                document.body.style.overflow = '';
            }
        });

        window.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (document.getElementById('edit-modal').classList.contains('show')) {
                    document.getElementById('edit-modal').classList.remove('show');
                } else if (document.getElementById('document-details-modal').classList.contains('show')) {
                    document.getElementById('document-details-modal').classList.remove('show');
                } else if (sidebar.classList.contains('mobile-open')) {
                    sidebar.classList.remove('mobile-open');
                    sidebarOverlay.classList.remove('show');
                    document.body.style.overflow = '';
                }
            }
        });

        console.log('Tehnolux Pregled dokumenata - SISTEM SA INDIVIDUALNIM RABATIMA I NAPOMENAMA INICIJALIZOVAN');
        console.log('- Cene se učitavaju direktno iz LAGER baze');
        console.log('- Rabati se učitavaju iz PARTNER_ARTIKAL_RABAT tabele');
        console.log('- Napomena se prikazuje u štampanom dokumentu');
    </script>
</body>
</html>