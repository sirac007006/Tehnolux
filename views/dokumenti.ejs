    <script>
        // DOM Elements
        const sidebar = document.getElementById('sidebar');
        const sidebarOverlay = document.getElementById('sidebar-overlay');
        const mainContent = document.getElementById('main-content');
        const header = document.getElementById('header');
        const toggleSidebar = document.getElementById('toggle-sidebar');
        const sidebarIcon = document.getElementById('sidebar-icon');
        const mobileMenuToggle = document.getElementById('mobile-menu-toggle');

        // Header buttons
        const printBtn = document.getElementById('print-btn');
        const exportBtn = document.getElementById('export-btn');
        const refreshBtn = document.getElementById('refresh-btn');

        // Modal elements
        const documentModal = document.getElementById('document-modal');
        const documentDetailsModal = document.getElementById('document-details-modal');
        const closeModal = document.getElementById('close-modal');
        const closeDetailsModal = document.getElementById('close-details-modal');
        const closeDetailsBtn = document.getElementById('close-details-btn');
        const printFromDetailsBtn = document.getElementById('print-from-details-btn');
        const cancelBtn = document.getElementById('cancel-btn');
        const documentForm = document.getElementById('document-form');
        const modalTitle = document.getElementById('modal-title');
        const documentIdInput = document.getElementById('document-id');
        const documentDetailsContent = document.getElementById('document-details-content');

        // Filter elements
        const searchInput = document.getElementById('search-documents');
        const partnerFilter = document.getElementById('partner-filter');
        const tipFilter = document.getElementById('tip-filter');
        const artikalFilter = document.getElementById('artikal-filter');
        const dateFrom = document.getElementById('date-from');
        const dateTo = document.getElementById('date-to');
        const applyFiltersBtn = document.getElementById('apply-filters');
        const documentCount = document.getElementById('document-count');

        // Print elements
        const printDocument = document.getElementById('print-document');

        // Get data from server - read from JSON script tags
        let dokumentiData = [];
        let filteredData = [];

        // Function to load data from JSON script tags
        function loadServerData() {
            try {
                const dokumentiElement = document.getElementById('dokumenti-data');
                const partneriElement = document.getElementById('partneri-data');
                const tipoviElement = document.getElementById('tipovi-data');
                const artikliElement = document.getElementById('artikli-data');

                dokumentiData = dokumentiElement ? JSON.parse(dokumentiElement.textContent) : [];
                window.partneriData = partneriElement ? JSON.parse(partneriElement.textContent) : [];
                window.tipoviData = tipoviElement ? JSON.parse(tipoviElement.textContent) : [];
                window.artikliData = artikliElement ? JSON.parse(artikliElement.textContent) : [];
                
                filteredData = [...dokumentiData];
            } catch (error) {
                console.error('Error loading server data:', error);
                dokumentiData = [];
                filteredData = [];
                window.partneriData = [];
                window.tipoviData = [];
                window.artikliData = [];
            }
        }

        // Function to close mobile sidebar
        function closeMobileSidebar() {
            if (window.innerWidth <= 576) {
                sidebar.classList.remove('mobile-open');
                sidebarOverlay.classList.remove('show');
                document.body.style.overflow = '';
            }
        }

        // Mobile menu functionality
        mobileMenuToggle.addEventListener('click', function() {
            sidebar.classList.toggle('mobile-open');
            sidebarOverlay.classList.toggle('show');
            
            // Prevent body scroll when sidebar is open
            if (sidebar.classList.contains('mobile-open')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = '';
            }
        });

        // Close mobile menu when clicking overlay
        sidebarOverlay.addEventListener('click', function() {
            closeMobileSidebar();
        });

        // Close mobile menu when clicking outside
        document.addEventListener('click', function(e) {
            if (window.innerWidth <= 576) {
                if (!sidebar.contains(e.target) && !mobileMenuToggle.contains(e.target)) {
                    closeMobileSidebar();
                }
            }
        });

        // Toggle sidebar
        toggleSidebar.addEventListener('click', function() {
            sidebar.classList.toggle('collapsed');
            mainContent.classList.toggle('expanded');
            header.classList.toggle('expanded');
            
            if (sidebar.classList.contains('collapsed')) {
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            } else {
                sidebarIcon.classList.remove('fa-chevron-right');
                sidebarIcon.classList.add('fa-chevron-left');
            }
        });

        // Submenu functionality
        document.querySelectorAll('.nav-item.has-submenu > .nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const parent = this.parentElement;
                const submenu = parent.querySelector('.submenu');
                
                // Close other submenus
                document.querySelectorAll('.nav-item.has-submenu').forEach(item => {
                    if (item !== parent) {
                        item.classList.remove('open');
                        item.querySelector('.submenu').classList.remove('open');
                    }
                });
                
                parent.classList.toggle('open');
                submenu.classList.toggle('open');
            });
        });

        // Enhanced navigation - close sidebar on submenu link click
        document.querySelectorAll('.submenu .nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                // Add visual feedback
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 100);
                
                // Close mobile sidebar immediately
                closeMobileSidebar();
            });
        });

        // Format price
        function formatPrice(price) {
            return Number(price).toLocaleString('sr-RS', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        // Get document type for printing
        function getDocumentTypeForPrint(tipDokumenta) {
            const tip = tipDokumenta.toLowerCase();
            if (tip.includes('otpremnica')) return 'Otpremnica';
            if (tip.includes('predracun')) return 'Predračun';
            if (tip.includes('kalkulacija')) return 'Kalkulacija';
            if (tip.includes('ponuda')) return 'Ponuda';
            return 'Dokument';
        }

        // Get signature text based on document type
        function getSignatureText(tipDokumenta) {
            const tip = tipDokumenta.toLowerCase();
            if (tip.includes('otpremnica')) return 'Otpremio,';
            if (tip.includes('predracun')) return 'Izradio,';
            if (tip.includes('kalkulacija')) return 'Kalkulisao,';
            if (tip.includes('ponuda')) return 'Ponudio,';
            return 'Izdao,';
        }

        // Get disclaimer text based on document type
        function getDisclaimerText(tipDokumenta) {
            const tip = tipDokumenta.toLowerCase();
            if (tip.includes('otpremnica')) return 'OVO NIJE PDV RAČUN!!!';
            if (tip.includes('predracun')) return 'OVO NIJE PDV RAČUN - PREDRAČUN!!!';
            if (tip.includes('kalkulacija')) return 'KALKULACIJA - OVO NIJE PDV RAČUN!!!';
            if (tip.includes('ponuda')) return 'PONUDA - OVO NIJE OBAVEZUJUĆI DOKUMENT!!!';
            return 'OVO NIJE PDV RAČUN!!!';
        }

        // Load partner details by name
        async function loadPartnerByName(partnerName) {
            try {
                const response = await fetch('/api/partneri');
                if (response.ok) {
                    const partneri = await response.json();
                    const partner = partneri.find(p => 
                        (p.Naziv_partnera || p.naziv_partnera || '').toLowerCase() === partnerName.toLowerCase()
                    );
                    return partner || null;
                } else {
                    return null;
                }
            } catch (error) {
                console.error('Error loading partner:', error);
                return null;
            }
        }

        // Parse articles from document naziv_artikla field
        function parseArticlesFromDocument(nazivArtikla, kolicina, cenaBezPdv, cenaSaPdv, rabat, pdvStopa) {
            // If it's a combined list of articles, try to parse
            if (nazivArtikla.includes(',') && nazivArtikla.includes(' - ')) {
                const articles = [];
                const parts = nazivArtikla.split(', ');
                let articleIndex = 1;
                
                parts.forEach(part => {
                    const match = part.match(/^(.+?)\s-\s(.+?)\s\((.+?)\s(.+?)\)$/);
                    if (match) {
                        const [, sifra, naziv, qty, jm] = match;
                        articles.push({
                            rb: articleIndex++,
                            sifra: sifra.trim(),
                            naziv: naziv.trim(),
                            jm: jm.trim(),
                            kolicina: parseFloat(qty) || 1,
                            cenaBezPdv: cenaBezPdv / parts.length, // Distribute price equally
                            cenaSaPdv: cenaSaPdv / parts.length,
                            rabat: rabat || 0,
                            pdvStopa: pdvStopa || 21
                        });
                    }
                });
                
                return articles.length > 0 ? articles : [{
                    rb: 1,
                    sifra: 'N/A',
                    naziv: nazivArtikla,
                    jm: 'kom',
                    kolicina: kolicina,
                    cenaBezPdv: cenaBezPdv,
                    cenaSaPdv: cenaSaPdv,
                    rabat: rabat || 0,
                    pdvStopa: pdvStopa || 21
                }];
            } else {
                // Single article
                return [{
                    rb: 1,
                    sifra: 'N/A',
                    naziv: nazivArtikla,
                    jm: 'kom',
                    kolicina: kolicina,
                    cenaBezPdv: cenaBezPdv,
                    cenaSaPdv: cenaSaPdv,
                    rabat: rabat || 0,
                    pdvStopa: pdvStopa || 21
                }];
            }
        }

        // Generate print document from existing document data
        async function generatePrintDocumentFromData(documentData) {
            const today = new Date();
            const formattedDate = `${String(today.getDate()).padStart(2, '0')}.${String(today.getMonth() + 1).padStart(2, '0')}.${today.getFullYear()}`;
            
            // Extract document number from tip_dokumenta
            const docNumberMatch = documentData.tip_dokumenta.match(/(\d{3}-\d{6})/);
            const docNumber = docNumberMatch ? docNumberMatch[1] : 'N/A';
            
            // Get document type
            const documentType = getDocumentTypeForPrint(documentData.tip_dokumenta);
            
            // Try to load partner details
            const partner = await loadPartnerByName(documentData.partner);
            
            // Fill header data
            document.getElementById('print-date').textContent = formattedDate;
            document.getElementById('print-document-type').textContent = documentType;
            document.getElementById('print-doc-number').textContent = docNumber;
            
            if (partner) {
                const sifra = partner.Sifra || partner.sifra || '';
                const naziv = partner.Naziv_partnera || partner.naziv_partnera || documentData.partner;
                const pib = partner.PIB || partner.pib || '';
                const pdv = partner.PDV || partner.pdv || '';
                const adresa = partner.Adresa || partner.adresa || '';
                const grad = partner.Grad || partner.grad || '';
                
                document.getElementById('print-customer-code').textContent = sifra;
                document.getElementById('print-customer-name').textContent = naziv;
                document.getElementById('print-customer-pib').textContent = pib;
                document.getElementById('print-customer-pdv').textContent = pdv;
                document.getElementById('print-customer-address').textContent = adresa;
                document.getElementById('print-customer-city').textContent = grad;
            } else {
                // Fallback if partner not found
                document.getElementById('print-customer-code').textContent = 'N/A';
                document.getElementById('print-customer-name').textContent = documentData.partner;
                document.getElementById('print-customer-pib').textContent = '';
                document.getElementById('print-customer-pdv').textContent = '';
                document.getElementById('print-customer-address').textContent = '';
                document.getElementById('print-customer-city').textContent = '';
            }
            
            // Parse articles from document data
            const articles = parseArticlesFromDocument(
                documentData.naziv_artikla,
                parseFloat(documentData.kolicina),
                parseFloat(documentData.iznos_bez_pdv) / parseFloat(documentData.kolicina),
                parseFloat(documentData.iznos_sa_pdv) / parseFloat(documentData.kolicina),
                parseFloat(documentData.rabat) || 0,
                21 // Default PDV rate
            );
            
            // Fill items table
            let itemsHTML = '';
            let totalBezPdv = 0;
            let totalRabat = parseFloat(documentData.rabat) || 0;
            let totalPdv = parseFloat(documentData.pdv_iznos) || 0;
            let totalSaPdv = parseFloat(documentData.iznos_sa_pdv) || 0;
            
            articles.forEach((item, index) => {
                const vrijednostBezPdv = item.cenaBezPdv * item.kolicina;
                const rabatIznos = vrijednostBezPdv * (item.rabat / 100);
                const vrijednostBezPdvSaRabatom = vrijednostBezPdv - rabatIznos;
                const pdvIznos = vrijednostBezPdvSaRabatom * (item.pdvStopa / 100);
                const vrijednostSaPdv = item.cenaSaPdv * item.kolicina;
                
                totalBezPdv += vrijednostBezPdvSaRabatom;
                
                itemsHTML += `
                    <tr>
                        <td>${item.rb}</td>
                        <td>${item.sifra}</td>
                        <td class="text-left">${item.naziv}</td>
                        <td>${item.jm}</td>
                        <td>${item.kolicina}</td>
                        <td class="text-right">${item.cenaBezPdv.toFixed(3)}</td>
                        <td class="text-right">${vrijednostBezPdv.toFixed(2)}</td>
                        <td class="text-right">${item.rabat.toFixed(1)}%</td>
                        <td class="text-right">${item.pdvStopa.toFixed(0)}%</td>
                        <td class="text-right">${pdvIznos.toFixed(2)}</td>
                        <td class="text-right">${item.cenaSaPdv.toFixed(3)}</td>
                        <td class="text-right">${vrijednostSaPdv.toFixed(2)}</td>
                    </tr>
                `;
            });
            
            document.getElementById('print-items-tbody').innerHTML = itemsHTML;
            
            // Fill totals
            document.getElementById('print-total-bez-pdv').textContent = totalBezPdv.toFixed(2);
            document.getElementById('print-total-rabat').textContent = totalRabat.toFixed(2);
            document.getElementById('print-osnovica').textContent = totalBezPdv.toFixed(2);
            document.getElementById('print-pdv-iznos').textContent = totalPdv.toFixed(2);
            document.getElementById('print-total-sa-pdv').textContent = totalSaPdv.toFixed(2);
            
            // Update signature and disclaimer based on document type
            document.getElementById('print-signature-left').textContent = getSignatureText(documentData.tip_dokumenta);
            document.getElementById('print-disclaimer').innerHTML = `<div><strong>${getDisclaimerText(documentData.tip_dokumenta)}</strong></div>`;
        }

        // Setup event delegation for table buttons
        function setupEventDelegation() {
            const tbody = document.getElementById('dokumenti-tbody');
            tbody.addEventListener('click', handleTableClick);
        }

        // Show document details in modal
        function showDocumentDetails(item) {
            const detailsHTML = `
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                    <div>
                        <strong>ID:</strong> ${item.id}<br>
                        <strong>Datum:</strong> ${new Date(item.datum).toLocaleDateString('sr-RS')}<br>
                        <strong>Tip dokumenta:</strong> ${item.tip_dokumenta}<br>
                        <strong>Partner:</strong> ${item.partner}
                    </div>
                    <div>
                        <strong>Količina:</strong> ${formatPrice(item.kolicina)}<br>
                        <strong>Iznos bez PDV:</strong> ${formatPrice(item.iznos_bez_pdv)} €<br>
                        <strong>PDV iznos:</strong> ${formatPrice(item.pdv_iznos)} €<br>
                        <strong>Iznos sa PDV:</strong> ${formatPrice(item.iznos_sa_pdv)} €<br>
                        <strong>Rabat:</strong> ${formatPrice(item.rabat)} €
                    </div>
                </div>
                <div style="margin-bottom: 1rem;">
                    <strong>Naziv artikla:</strong>
                    <div style="padding: 10px; background-color: #f8f9fa; border-radius: 4px; margin-top: 0.5rem; word-wrap: break-word; white-space: pre-wrap;">${item.naziv_artikla}</div>
                </div>
            `;
            
            documentDetailsContent.innerHTML = detailsHTML;
            
            // Store current item for printing
            window.currentDocumentForPrint = item;
            
            documentDetailsModal.classList.add('show');
        }

        // Handle table clicks
        function handleTableClick(e) {
            const target = e.target.closest('button');
            if (!target) {
                // Row selection
                const row = e.target.closest('tr');
                if (row && row.parentNode.tagName === 'TBODY') {
                    document.querySelectorAll('.data-table tbody tr').forEach(r => r.classList.remove('selected'));
                    row.classList.add('selected');
                }
                return;
            }

            const id = parseInt(target.dataset.id);
            const item = dokumentiData.find(d => d.id === id);
            
            if (target.classList.contains('print-document-btn')) {
                if (item) {
                    generatePrintDocumentFromData(item).then(() => {
                        window.print();
                    });
                }
            } else if (target.classList.contains('edit-document-btn')) {
                if (item) {
                    fillForm(item);
                    modalTitle.textContent = 'Izmeni dokument';
                    documentModal.classList.add('show');
                }
            } else if (target.classList.contains('delete-document-btn')) {
                if (confirm('Da li ste sigurni da želite da obrišete ovaj dokument?')) {
                    // Here you would make a DELETE request to the server
                    alert('Funkcija brisanja će biti implementirana u backend-u');
                }
            } else if (target.classList.contains('view-document-btn')) {
                if (item) {
                    showDocumentDetails(item);
                }
            }
        }

        // Render table
        function renderDokumentiTable(data = filteredData) {
            const tbody = document.getElementById('dokumenti-tbody');
            tbody.innerHTML = '';
            
            data.forEach((item, index) => {
                const row = document.createElement('tr');
                if (index === 0) {
                    row.classList.add('selected');
                }
                
                row.innerHTML = `
                    <td>${item.id}</td>
                    <td class="date-column">${new Date(item.datum).toLocaleDateString('sr-RS')}</td>
                    <td>${item.partner}</td>
                    <td class="doc-type-column">${item.tip_dokumenta}</td>
                    <td title="${item.naziv_artikla}" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${item.naziv_artikla}</td>
                    <td class="price-column">${formatPrice(item.iznos_sa_pdv)}</td>
                    <td>
                        <div class="action-buttons">
                            <button class="btn btn-sm btn-info view-document-btn" data-id="${item.id}" title="Pregled">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="btn btn-sm btn-primary print-document-btn" data-id="${item.id}" title="Štampaj">
                                <i class="fas fa-print"></i>
                            </button>
                            <button class="btn btn-sm btn-primary edit-document-btn" data-id="${item.id}" title="Izmeni">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-danger delete-document-btn" data-id="${item.id}" title="Obriši">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                `;
                
                tbody.appendChild(row);
            });

            // Update document count
            documentCount.textContent = `Ukupno: ${data.length} dokumenata`;
        }

        // Fill form with document data
        function fillForm(item) {
            documentIdInput.value = item.id;
            document.getElementById('doc-tip').value = item.tip_dokumenta;
            document.getElementById('doc-datum').value = new Date(item.datum).toISOString().split('T')[0];
            document.getElementById('doc-partner').value = item.partner;
            document.getElementById('doc-artikal').value = item.naziv_artikla;
            document.getElementById('doc-kolicina').value = item.kolicina;
            document.getElementById('doc-iznos-bez').value = item.iznos_bez_pdv;
            document.getElementById('doc-pdv').value = item.pdv_iznos;
            document.getElementById('doc-iznos-sa').value = item.iznos_sa_pdv;
            document.getElementById('doc-rabat').value = item.rabat;
        }

        // Clear form
        function clearForm() {
            documentForm.reset();
            documentIdInput.value = '';
            document.getElementById('doc-datum').value = new Date().toISOString().split('T')[0];
        }

        // Apply filters
        function applyFilters() {
            const searchTerm = searchInput.value.toLowerCase();
            const partner = partnerFilter.value;
            const tip = tipFilter.value;
            const artikal = artikalFilter.value;
            const fromDate = dateFrom.value;
            const toDate = dateTo.value;
            
            filteredData = dokumentiData.filter(item => {
                let passes = true;
                
                // Search filter
                if (searchTerm) {
                    const searchableText = `${item.partner} ${item.naziv_artikla} ${item.tip_dokumenta}`.toLowerCase();
                    if (!searchableText.includes(searchTerm)) {
                        passes = false;
                    }
                }
                
                // Partner filter
                if (partner && item.partner !== partner) {
                    passes = false;
                }
                
                // Tip filter
                if (tip && item.tip_dokumenta !== tip) {
                    passes = false;
                }
                
                // Artikal filter
                if (artikal && item.naziv_artikla !== artikal) {
                    passes = false;
                }
                
                // Date range filter
                if (fromDate && toDate) {
                    const itemDate = new Date(item.datum);
                    const filterFromDate = new Date(fromDate);
                    const filterToDate = new Date(toDate);
                    
                    if (itemDate < filterFromDate || itemDate > filterToDate) {
                        passes = false;
                    }
                }
                
                return passes;
            });
            
            renderDokumentiTable();
        }

        // Event listeners
        printBtn.addEventListener('click', () => {
            window.print();
        });

        exportBtn.addEventListener('click', () => {
            // Simple CSV export
            const csvContent = "data:text/csv;charset=utf-8," 
                + "ID,Datum,Partner,Tip dokumenta,Naziv artikla,Iznos sa PDV (€)\n"
                + filteredData.map(item => 
                    `${item.id},${new Date(item.datum).toLocaleDateString('sr-RS')},${item.partner},${item.tip_dokumenta},${item.naziv_artikla},${item.iznos_sa_pdv}`
                ).join("\n");
            
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "dokumenti.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });

        refreshBtn.addEventListener('click', () => {
            location.reload();
        });

        // Modal events
        closeModal.addEventListener('click', () => {
            documentModal.classList.remove('show');
        });

        closeDetailsModal.addEventListener('click', () => {
            documentDetailsModal.classList.remove('show');
        });

        closeDetailsBtn.addEventListener('click', () => {
            documentDetailsModal.classList.remove('show');
        });

        printFromDetailsBtn.addEventListener('click', () => {
            if (window.currentDocumentForPrint) {
                generatePrintDocumentFromData(window.currentDocumentForPrint).then(() => {
                    window.print();
                });
            }
        });

        cancelBtn.addEventListener('click', () => {
            documentModal.classList.remove('show');
        });

        documentModal.addEventListener('click', (e) => {
            if (e.target === documentModal) {
                documentModal.classList.remove('show');
            }
        });

        documentDetailsModal.addEventListener('click', (e) => {
            if (e.target === documentDetailsModal) {
                documentDetailsModal.classList.remove('show');
            }
        });

        // Form submission
        documentForm.addEventListener('submit', (e) => {
            e.preventDefault();
            
            const formData = {
                id: documentIdInput.value ? parseInt(documentIdInput.value) : null,
                tip_dokumenta: document.getElementById('doc-tip').value,
                datum: document.getElementById('doc-datum').value,
                partner: document.getElementById('doc-partner').value,
                naziv_artikla: document.getElementById('doc-artikal').value,
                kolicina: parseFloat(document.getElementById('doc-kolicina').value),
                iznos_bez_pdv: parseFloat(document.getElementById('doc-iznos-bez').value),
                pdv_iznos: parseFloat(document.getElementById('doc-pdv').value) || 0,
                iznos_sa_pdv: parseFloat(document.getElementById('doc-iznos-sa').value),
                rabat: parseFloat(document.getElementById('doc-rabat').value) || 0
            };

            // Here you would make POST/PUT request to server
            alert('Funkcija čuvanja će biti implementirana u backend-u');
            documentModal.classList.remove('show');
        });

        // Filter event listeners
        searchInput.addEventListener('input', applyFilters);
        partnerFilter.addEventListener('change', applyFilters);
        tipFilter.addEventListener('change', applyFilters);
        artikalFilter.addEventListener('change', applyFilters);
        dateFrom.addEventListener('change', applyFilters);
        dateTo.addEventListener('change', applyFilters);
        applyFiltersBtn.addEventListener('click', applyFilters);

        // Handle window resize
        window.addEventListener('resize', function() {
            if (window.innerWidth > 576) {
                closeMobileSidebar();
            }
            
            // Auto collapse sidebar on medium screens
            if (window.innerWidth <= 992 && window.innerWidth > 576) {
                if (!sidebar.classList.contains('collapsed')) {
                    sidebar.classList.add('collapsed');
                    mainContent.classList.add('expanded');
                    header.classList.add('expanded');
                    sidebarIcon.classList.remove('fa-chevron-left');
                    sidebarIcon.classList.add('fa-chevron-right');
                }
            }
        });

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // ESC to close modal or mobile menu
            if (e.key === 'Escape') {
                if (documentModal.classList.contains('show')) {
                    documentModal.classList.remove('show');
                } else if (documentDetailsModal.classList.contains('show')) {
                    documentDetailsModal.classList.remove('show');
                } else if (sidebar.classList.contains('mobile-open')) {
                    closeMobileSidebar();
                }
            }
            
            // Ctrl+F to focus search
            if (e.ctrlKey && e.key === 'f') {
                e.preventDefault();
                searchInput.focus();
            }
        });

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            loadServerData(); // Load data from JSON script tags first
            setupEventDelegation();
            populateFilters(); // Populate filter dropdowns
            
            // Auto collapse sidebar on medium screens on load
            if (window.innerWidth <= 992 && window.innerWidth > 576) {
                sidebar.classList.add('collapsed');
                mainContent.classList.add('expanded');
                header.classList.add('expanded');
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            }
            
            console.log('Tehnolux Pregled dokumenata initialized - EJS version with database integration and print functionality');
        });
    </script>

    <script>
        // Initialize data from server
        dokumentiData = window.dokumentiData || [];
        filteredData = [...dokumentiData];
        
        // Populate filters with server data
        function populateFilters() {
            const partnerFilter = document.getElementById('partner-filter');
            const tipFilter = document.getElementById('tip-filter');
            const artikalFilter = document.getElementById('artikal-filter');
            
            // Clear existing options (except first "All" option)
            partnerFilter.innerHTML = '<option value="">Svi partneri</option>';
            tipFilter.innerHTML = '<option value="">Svi tipovi</option>';
            artikalFilter.innerHTML = '<option value="">Svi artikli</option>';
            
            // Add partners
            if (window.partneriData) {
                window.partneriData.forEach(partner => {
                    const option = document.createElement('option');
                    option.value = partner;
                    option.textContent = partner;
                    partnerFilter.appendChild(option);
                });
            }
            
            // Add document types
            if (window.tipoviData) {
                window.tipoviData.forEach(tip => {
                    const option = document.createElement('option');
                    option.value = tip;
                    option.textContent = tip;
                    tipFilter.appendChild(option);
                });
            }
            
            // Add articles
            if (window.artikliData) {
                window.artikliData.forEach(artikal => {
                    const option = document.createElement('option');
                    option.value = artikal;
                    option.textContent = artikal;
                    artikalFilter.appendChild(option);
                });
            }
        }
    </script>
</body>
</html>