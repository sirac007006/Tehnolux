        // Summary elements
        const totalRecords = document.getElementById('total-records');
        const totalBalance = document.getElementById('total-balance');
        const positiveBalance = document.getElementById('positive-balance');
        const negativeBalance = document.getElementById('negative-balance');
        
        // Print elements
        const printBtn = document.getElementById('print-btn');
        const printModal = document.getElementById('print-modal');
        const closePrintModal = document.getElementById('close-print-modal');
        const cancelPrintBtn = document.getElementById('cancel-print-btn');
        const confirmPrintBtn = document.getElementById('confirm-print-btn');
        const printContainer = document.getElementById('print-container');

        // Transaction modal elements
        const transactionModal = document.getElementById('transaction-modal');
        const closeTransactionModal = document.getElementById('close-transaction-modal');
        const printTransactionsBtn = document.getElementById('print-transactions-btn');
        const printTransactionsModal = document.getElementById('print-transactions-modal');
        const closePrintTransactionsModal = document.getElementById('close-print-transactions-modal');
        const cancelPrintTransactionsBtn = document.getElementById('cancel-print-transactions-btn');
        const confirmPrintTransactionsBtn = document.getElementById('confirm-print-transactions-btn');

        // Function to close mobile sidebar
        function closeMobileSidebar() {
            if (window.innerWidth <= 576) {
                sidebar.classList.remove('mobile-open');
                sidebarOverlay.classList.remove('show');
                document.body.style.overflow = '';
            }
        }

        // Mobile menu functionality
        mobileMenuToggle.addEventListener('click', function() {
            sidebar.classList.toggle('mobile-open');
            sidebarOverlay.classList.toggle('show');
            
            // Prevent body scroll when sidebar is open
            if (sidebar.classList.contains('mobile-open')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = '';
            }
        });

        // Close mobile menu when clicking overlay
        sidebarOverlay.addEventListener('click', function() {
            closeMobileSidebar();
        });

        // Close mobile menu when clicking outside
        document.addEventListener('click', function(e) {
            if (window.innerWidth <= 576) {
                if (!sidebar.contains(e.target) && !mobileMenuToggle.contains(e.target)) {
                    closeMobileSidebar();
                }
            }
        });

        // Toggle sidebar
        toggleSidebar.addEventListener('click', function() {
            sidebar.classList.toggle('collapsed');
            mainContent.classList.toggle('expanded');
            header.classList.toggle('expanded');
            
            if (sidebar.classList.contains('collapsed')) {
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            } else {
                sidebarIcon.classList.remove('fa-chevron-right');
                sidebarIcon.classList.add('fa-chevron-left');
            }
        });

        // Submenu functionality - without closing sidebar for main categories
        document.querySelectorAll('.nav-item.has-submenu > .nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const parent = this.parentElement;
                const submenu = parent.querySelector('.submenu');
                
                // Close other submenus
                document.querySelectorAll('.nav-item.has-submenu').forEach(item => {
                    if (item !== parent) {
                        item.classList.remove('open');
                        item.querySelector('.submenu').classList.remove('open');
                    }
                });
                
                parent.classList.toggle('open');
                submenu.classList.toggle('open');
            });
        });

        // Enhanced navigation - close sidebar on submenu link click
        document.querySelectorAll('.submenu .nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                // Add visual feedback
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 100);
                
                // Close mobile sidebar immediately
                closeMobileSidebar();
            });
        });

        // Search functionality
        searchInput.addEventListener('input', function() {
            const term = this.value.toLowerCase();
            const rows = customersTable.querySelectorAll('tr');
            let visibleCount = 0;
            let visibleTotal = 0;
            let visiblePositive = 0;
            let visibleNegative = 0;
            
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const visible = text.includes(term);
                row.style.display = visible ? '' : 'none';
                
                if (visible) {
                    visibleCount++;
                    const saldoText = row.cells[3].textContent.replace(/[^\d.,-]/g, '').replace(',', '.');
                    const saldo = parseFloat(saldoText) || 0;
                    visibleTotal += saldo;
                    
                    if (saldo > 0) {
                        visiblePositive += saldo;
                    } else {
                        visibleNegative += saldo;
                    }
                }
            });
            
            // Update summary
            totalRecords.textContent = visibleCount;
            totalBalance.textContent = visibleTotal.toLocaleString('sr-RS', { minimumFractionDigits: 2 });
            positiveBalance.textContent = visiblePositive.toLocaleString('sr-RS', { minimumFractionDigits: 2 });
            negativeBalance.textContent = visibleNegative.toLocaleString('sr-RS', { minimumFractionDigits: 2 });
        });

        // Filter functionality with period validation
        applyFilterBtn.addEventListener('click', function() {
            const fromDate = new Date(dateFrom.value);
            const toDate = new Date(dateTo.value);
            
            if (fromDate > toDate) {
                alert('Početni datum ne može biti veći od krajnjeg datuma!');
                return;
            }
            
            // Filter customers based on last transaction date within period
            const rows = customersTable.querySelectorAll('tr');
            let visibleCount = 0;
            let visibleTotal = 0;
            let visiblePositive = 0;
            let visibleNegative = 0;
            
            rows.forEach(row => {
                const lastTransactionDate = new Date(row.cells[4].textContent.split('.').reverse().join('-'));
                const shouldShow = (!dateFrom.value || lastTransactionDate >= fromDate) && 
                                 (!dateTo.value || lastTransactionDate <= toDate) &&
                                 (!onlyWithBalanceCheckbox.checked || parseFloat(row.cells[3].textContent.replace(/[^\d.,-]/g, '').replace(',', '.')) !== 0);
                
                row.style.display = shouldShow ? '' : 'none';
                
                if (shouldShow) {
                    visibleCount++;
                    const saldoText = row.cells[3].textContent.replace(/[^\d.,-]/g, '').replace(',', '.');
                    const saldo = parseFloat(saldoText) || 0;
                    visibleTotal += saldo;
                    
                    if (saldo > 0) {
                        visiblePositive += saldo;
                    } else {
                        visibleNegative += saldo;
                    }
                }
            });
            
            // Update summary
            totalRecords.textContent = visibleCount;
            totalBalance.textContent = visibleTotal.toLocaleString('sr-RS', { minimumFractionDigits: 2 });
            positiveBalance.textContent = visiblePositive.toLocaleString('sr-RS', { minimumFractionDigits: 2 });
            negativeBalance.textContent = visibleNegative.toLocaleString('sr-RS', { minimumFractionDigits: 2 });
            
            console.log('Filter applied:', {
                rj: rjSelect.value,
                dateFrom: dateFrom.value,
                dateTo: dateTo.value,
                onlyWithBalance: onlyWithBalanceCheckbox.checked,
                visibleCustomers: visibleCount
            });
        });

        // Customer row click to show transactions
        document.addEventListener('click', function(e) {
            const customerRow = e.target.closest('.customer-row');
            if (customerRow) {
                // Remove previous selection
                document.querySelectorAll('.customer-row').forEach(row => row.classList.remove('selected'));
                
                // Select current row
                customerRow.classList.add('selected');
                
                // Get customer data
                const customerCode = customerRow.cells[0].textContent;
                const customerName = customerRow.cells[1].textContent;
                const customerCity = customerRow.cells[2].textContent;
                const customerBalance = customerRow.cells[3].textContent;
                
                // Show transaction modal
                showTransactionModal(customerCode, customerName, customerCity, customerBalance);
            }
        });

        function showTransactionModal(code, name, city, balance) {
            // Set customer info
            document.getElementById('customer-code').textContent = code;
            document.getElementById('customer-name').textContent = name;
            document.getElementById('customer-city').textContent = city || 'N/A';
            document.getElementById('customer-balance').textContent = balance;
            document.getElementById('transaction-modal-title').textContent = `Transakcije kupca - ${name}`;
            
            // Load sample transactions (in real app, this would come from API)
            loadSampleTransactions(code);
            
            // Show modal
            transactionModal.classList.add('show');
        }

        function loadSampleTransactions(customerCode) {
            const transactionsTbody = document.getElementById('transactions-tbody');
            
            // Sample transaction data (in real app, this would come from API)
            const sampleTransactions = [
                { date: '25.07.2025', document: 'RAC-001234', description: 'Prodaja robe', debit: '', credit: '2.500,00', balance: '2.500,00' },
                { date: '20.07.2025', document: 'UPL-005678', description: 'Uplata na račun', debit: '1.500,00', credit: '', balance: '1.000,00' },
                { date: '15.07.2025', document: 'RAC-001189', description: 'Prodaja materijala', debit: '', credit: '3.200,00', balance: '2.500,00' },
                { date: '10.07.2025', document: 'UPL-005432', description: 'Delimična uplata', debit: '2.000,00', credit: '', balance: '-700,00' },
                { date: '05.07.2025', document: 'RAC-001098', description: 'Servisne usluge', debit: '', credit: '1.300,00', balance: '1.300,00' },
            ];
            
            // Clear previous data
            transactionsTbody.innerHTML = '';
            
            let totalDebit = 0;
            let totalCredit = 0;
            
            sampleTransactions.forEach(transaction => {
                const row = document.createElement('tr');
                
                const debitValue = transaction.debit ? parseFloat(transaction.debit.replace(/[^\d.,-]/g, '').replace(',', '.')) : 0;
                const creditValue = transaction.credit ? parseFloat(transaction.credit.replace(/[^\d.,-]/g, '').replace(',', '.')) : 0;
                
                totalDebit += debitValue;
                totalCredit += creditValue;
                
                row.innerHTML = `
                    <td>${transaction.date}</td>
                    <td>${transaction.document}</td>
                    <td>${transaction.description}</td>
                    <td class="${transaction.debit ? 'saldo-negative' : ''}" style="text-align: right;">${transaction.debit}</td>
                    <td class="${transaction.credit ? 'saldo-positive' : ''}" style="text-align: right;">${transaction.credit}</td>
                    <td style="text-align: right; font-weight: 600;">${transaction.balance}</td>
                `;
                transactionsTbody.appendChild(row);
            });
            
            // Update summary
            document.getElementById('total-debit').textContent = totalDebit.toLocaleString('sr-RS', { minimumFractionDigits: 2 });
            document.getElementById('total-credit').textContent = totalCredit.toLocaleString('sr-RS', { minimumFractionDigits: 2 });
            const finalBalance = totalCredit - totalDebit;
            const finalBalanceElement = document.getElementById('final-balance');
            finalBalanceElement.textContent = finalBalance.toLocaleString('sr-RS', { minimumFractionDigits: 2 });
            finalBalanceElement.className = finalBalance >= 0 ? 'summary-value saldo-positive' : 'summary-value saldo-negative';
        }

        // Transaction modal controls
        closeTransactionModal.addEventListener('click', function() {
            transactionModal.classList.remove('show');
        });

        transactionModal.addEventListener('click', function(e) {
            if (e.target === this) {
                this.classList.remove('show');
            }
        });

        // Print functionality for customer list
        printBtn.addEventListener('click', function() {
            printModal.classList.add('show');
        });

        closePrintModal.addEventListener('click', function() {
            printModal.classList.remove('show');
        });

        cancelPrintBtn.addEventListener('click', function() {
            printModal.classList.remove('show');
        });

        printModal.addEventListener('click', function(e) {
            if (e.target === printModal) {
                printModal.classList.remove('show');
            }
        });

        confirmPrintBtn.addEventListener('click', function() {
            const selectedOption = document.querySelector('input[name="print-option"]:checked').value;
            preparePrintData(selectedOption);
            printModal.classList.remove('show');
            window.print();
        });

        function preparePrintData(option) {
            const printTbody = document.getElementById('print-tbody');
            const printPeriod = document.getElementById('print-period');
            const printRj = document.getElementById('print-rj');
            const printTotalRecords = document.getElementById('print-total-records');
            const printTotalBalance = document.getElementById('print-total-balance');
            
            // Set period and RJ
            printPeriod.textContent = `${dateFrom.value} - ${dateTo.value}`;
            printRj.textContent = rjSelect.value || 'Svi';
            
            // Clear previous data
            printTbody.innerHTML = '';
            
            let rowsToPrint = [];
            const allRows = Array.from(customersTable.querySelectorAll('tr'));
            
            switch(option) {
                case 'all':
                    rowsToPrint = allRows;
                    break;
                case 'filtered':
                    rowsToPrint = allRows.filter(row => row.style.display !== 'none');
                    break;
                case 'positive':
                    rowsToPrint = allRows.filter(row => {
                        const saldoCell = row.cells[3];
                        return saldoCell && saldoCell.classList.contains('saldo-positive');
                    });
                    break;
                case 'negative':
                    rowsToPrint = allRows.filter(row => {
                        const saldoCell = row.cells[3];
                        return saldoCell && saldoCell.classList.contains('saldo-negative');
                    });
                    break;
            }
            
            let totalRecordsCount = 0;
            let totalBalanceSum = 0;
            
            rowsToPrint.forEach(row => {
                const newRow = document.createElement('tr');
                newRow.innerHTML = `
                    <td style="padding: 3px; border: 1px solid #000;">${row.cells[0].textContent}</td>
                    <td style="padding: 3px; border: 1px solid #000;">${row.cells[1].textContent}</td>
                    <td style="padding: 3px; border: 1px solid #000;">${row.cells[2].textContent}</td>
                    <td style="padding: 3px; border: 1px solid #000; text-align: right;">${row.cells[3].textContent}</td>
                    <td style="padding: 3px; border: 1px solid #000;">${row.cells[4].textContent}</td>
                `;
                printTbody.appendChild(newRow);
                
                totalRecordsCount++;
                const saldoText = row.cells[3].textContent.replace(/[^\d.,-]/g, '').replace(',', '.');
                const saldo = parseFloat(saldoText) || 0;
                totalBalanceSum += saldo;
            });
            
            printTotalRecords.textContent = totalRecordsCount;
            printTotalBalance.textContent = totalBalanceSum.toLocaleString('sr-RS', { minimumFractionDigits: 2 });
        }

        // Print transactions functionality
        printTransactionsBtn.addEventListener('click', function() {
            printTransactionsModal.classList.add('show');
        });

        closePrintTransactionsModal.addEventListener('click', function() {
            printTransactionsModal.classList.remove('show');
        });

        cancelPrintTransactionsBtn.addEventListener('click', function() {
            printTransactionsModal.classList.remove('show');
        });

        printTransactionsModal.addEventListener('click', function(e) {
            if (e.target === this) {
                this.classList.remove('show');
            }
        });

        confirmPrintTransactionsBtn.addEventListener('click', function() {
            const selectedOption = document.querySelector('input[name="print-transaction-option"]:checked').value;
            prepareTransactionPrintData(selectedOption);
            printTransactionsModal.classList.remove('show');
            window.print();
        });

        function prepareTransactionPrintData(option) {
            const printTbody = document.getElementById('print-transactions-tbody');
            const printCustomerInfo = document.getElementById('print-customer-info');
            const printTransactionPeriod = document.getElementById('print-transaction-period');
            const printTotalDebit = document.getElementById('print-total-debit');
            const printTotalCredit = document.getElementById('print-total-credit');
            const printFinalBalance = document.getElementById('print-final-balance');
            
            // Set customer info
            const customerName = document.getElementById('customer-name').textContent;
            const customerCode = document.getElementById('customer-code').textContent;
            printCustomerInfo.textContent = `${customerCode} - ${customerName}`;
            
            const transactionDateFrom = '2025-01-01';
            const transactionDateTo = '2025-12-31';
            printTransactionPeriod.textContent = `${transactionDateFrom} - ${transactionDateTo}`;
            
            // Clear previous data
            printTbody.innerHTML = '';
            
            let rowsToPrint = [];
            const allTransactionRows = Array.from(document.querySelectorAll('#transactions-tbody tr'));
            
            switch(option) {
                case 'all':
                    rowsToPrint = allTransactionRows;
                    break;
                case 'debit':
                    rowsToPrint = allTransactionRows.filter(row => {
                        const debitCell = row.cells[3];
                        return debitCell && debitCell.textContent.trim() !== '';
                    });
                    break;
                case 'credit':
                    rowsToPrint = allTransactionRows.filter(row => {
                        const creditCell = row.cells[4];
                        return creditCell && creditCell.textContent.trim() !== '';
                    });
                    break;
            }
            
            let totalDebitSum = 0;
            let totalCreditSum = 0;
            
            rowsToPrint.forEach(row => {
                const newRow = document.createElement('tr');
                newRow.innerHTML = `
                    <td style="padding: 3px; border: 1px solid #000;">${row.cells[0].textContent}</td>
                    <td style="padding: 3px; border: 1px solid #000;">${row.cells[1].textContent}</td>
                    <td style="padding: 3px; border: 1px solid #000;">${row.cells[2].textContent}</td>
                    <td style="padding: 3px; border: 1px solid #000; text-align: right;">${row.cells[3].textContent}</td>
                    <td style="padding: 3px; border: 1px solid #000; text-align: right;">${row.cells[4].textContent}</td>
                    <td style="padding: 3px; border: 1px solid #000; text-align: right;">${row.cells[5].textContent}</td>
                `;
                printTbody.appendChild(newRow);
                
                const debitText = row.cells[3].textContent.replace(/[^\d.,-]/g, '').replace(',', '.');
                const creditText = row.cells[4].textContent.replace(/[^\d.,-]/g, '').replace(',', '.');
                totalDebitSum += parseFloat(debitText) || 0;
                totalCreditSum += parseFloat(creditText) || 0;
            });
            
            printTotalDebit.textContent = totalDebitSum.toLocaleString('sr-RS', { minimumFractionDigits: 2 });
            printTotalCredit.textContent = totalCreditSum.toLocaleString('sr-RS', { minimumFractionDigits: 2 });
            printFinalBalance.textContent = (totalCreditSum - totalDebitSum).toLocaleString('sr-RS', { minimumFractionDigits: 2 });
        }

        // Pagination functionality
        document.querySelectorAll('.page-item').forEach(item => {
            item.addEventListener('click', function() {
                if (this.classList.contains('active')) return;
                
                // Remove active from all
                document.querySelectorAll('.page-item').forEach(p => p.classList.remove('active'));
                
                // Add active to clicked (if it's a number)
                if (!this.querySelector('i')) {
                    this.classList.add('active');
                }
                
                // Here you would typically load new page data
                console.log('Loading page:', this.textContent);
            });
        });

        // Handle window resize
        window.addEventListener('resize', function() {
            if (window.innerWidth > 576) {
                closeMobileSidebar();
            }
            
            // Auto collapse sidebar on medium screens
            if (window.innerWidth <= 992 && window.innerWidth > 576) {
                if (!sidebar.classList.contains('collapsed')) {
                    sidebar.classList.add('collapsed');
                    mainContent.classList.add('expanded');
                    header.classList.add('expanded');
                    sidebarIcon.classList.remove('fa-chevron-left');
                    sidebarIcon.classList.add('fa-chevron-right');
                }
            }
        });

        // Calculate initial summary
        function calculateSummary() {
            const rows = customersTable.querySelectorAll('tr');
            let count = 0;
            let total = 0;
            let positive = 0;
            let negative = 0;
            
            rows.forEach(row => {
                if (row.style.display !== 'none') {
                    count++;
                    const saldoText = row.cells[3].textContent.replace(/[^\d.,-]/g, '').replace(',', '.');
                    const saldo = parseFloat(saldoText) || 0;
                    total += saldo;
                    
                    if (saldo > 0) {
                        positive += saldo;
                    } else {
                        negative += saldo;
                    }
                }
            });
            
            totalRecords.textContent = count;
            totalBalance.textContent = total.toLocaleString('sr-RS', { minimumFractionDigits: 2 });
            positiveBalance.textContent = positive.toLocaleString('sr-RS', { minimumFractionDigits: 2 });
            negativeBalance.textContent = negative.toLocaleString('sr-RS', { minimumFractionDigits: 2 });
        }

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // ESC to close modal or mobile menu
            if (e.key === 'Escape') {
                if (transactionModal.classList.contains('show')) {
                    transactionModal.classList.remove('show');
                } else if (printModal.classList.contains('show')) {
                    printModal.classList.remove('show');
                } else if (printTransactionsModal.classList.contains('show')) {
                    printTransactionsModal.classList.remove('show');
                } else if (sidebar.classList.contains('mobile-open')) {
                    closeMobileSidebar();
                }
            }
            
            // Ctrl+F to focus search
            if (e.ctrlKey && e.key === 'f') {
                e.preventDefault();
                searchInput.focus();
            }
        });

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            // Calculate initial summary
            calculateSummary();
            
            // Auto collapse sidebar on medium screens on load
            if (window.innerWidth <= 992 && window.innerWidth > 576) {
                sidebar.classList.add('collapsed');
                mainContent.classList.add('expanded');
                header.classList.add('expanded');
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            }
            
            console.log('Tehnolux Kartica kupca initialized - improved mobile navigation');
        });
    </script>
</body>
</html>