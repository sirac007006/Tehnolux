    <script>
        // DOM Elements
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.getElementById('main-content');
        const header = document.getElementById('header');
        const toggleSidebar = document.getElementById('toggle-sidebar');
        const sidebarIcon = document.getElementById('sidebar-icon');
        const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
        const searchInput = document.getElementById('search-customers');
        const customerModal = document.getElementById('customer-modal');
        const closeModal = document.getElementById('close-modal');

        // Global variables
        let partnersData = [];
        let filteredPartnersData = [];

        // Mobile menu functionality
        mobileMenuToggle.addEventListener('click', function() {
            sidebar.classList.toggle('mobile-open');
        });

        // Toggle sidebar
        toggleSidebar.addEventListener('click', function() {
            sidebar.classList.toggle('collapsed');
            mainContent.classList.toggle('expanded');
            header.classList.toggle('expanded');
            
            if (sidebar.classList.contains('collapsed')) {
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            } else {
                sidebarIcon.classList.remove('fa-chevron-right');
                sidebarIcon.classList.add('fa-chevron-left');
            }
        });

        // Search functionality
        searchInput.addEventListener('input', function() {
            const term = this.value.toLowerCase();
            const rows = document.querySelectorAll('.customer-row');
            let visibleCount = 0;
            
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const visible = text.includes(term);
                row.style.display = visible ? '' : 'none';
                if (visible) visibleCount++;
            });
            
            document.getElementById('total-records').textContent = visibleCount;
            updateSummaryStats();
        });

        // Customer row click handler
        document.addEventListener('click', function(e) {
            const customerRow = e.target.closest('.customer-row');
            if (customerRow) {
                const partnerId = customerRow.dataset.partnerId;
                const partnerName = customerRow.dataset.partnerName;
                showCustomerDetails(partnerId, partnerName);
            }
        });
        // Print modal functionality
document.getElementById('print-modal-btn').addEventListener('click', function() {
    printModal();
});
// Submenu functionality - DODAJTE OVAJ KOD
document.querySelectorAll('.nav-item.has-submenu > .nav-link').forEach(link => {
    link.addEventListener('click', function(e) {
        e.preventDefault();
        const parent = this.parentElement;
        const submenu = parent.querySelector('.submenu');
        
        // Zatvori druge submenije
        document.querySelectorAll('.nav-item.has-submenu').forEach(item => {
            if (item !== parent) {
                item.classList.remove('open');
                item.querySelector('.submenu').classList.remove('open');
            }
        });
        
        parent.classList.toggle('open');
        submenu.classList.toggle('open');
    });
});

// Enhanced navigation - zatvori sidebar pri kliku na submenu linkove
document.querySelectorAll('.submenu .nav-link').forEach(link => {
    link.addEventListener('click', function(e) {
        // Dodaj vizuelnu povratnu informaciju
        this.style.transform = 'scale(0.95)';
        setTimeout(() => {
            this.style.transform = 'scale(1)';
        }, 100);
        
        // Zatvori mobile sidebar odmah
        closeMobileSidebar();
    });
});
function printModal() {
    const modalContent = document.querySelector('.modal-content').cloneNode(true);
    
    // Remove buttons from print version
    const buttons = modalContent.querySelectorAll('.btn, .close-modal');
    buttons.forEach(btn => btn.remove());
    
    // Create print window
    const printWindow = window.open('', '_blank');
    printWindow.document.write(`
        <!DOCTYPE html>
        <html>
        <head>
            <title>Kartica Kupca - Print</title>
            <style>
                body { 
                    font-family: Arial, sans-serif; 
                    margin: 20px;
                    color: #000;
                }
                .modal-header { 
                    border-bottom: 2px solid #000; 
                    margin-bottom: 20px; 
                    padding-bottom: 10px;
                }
                .modal-title { 
                    font-size: 24px; 
                    margin: 0;
                    color: #000;
                }
                .partner-info-card { 
                    background: #f8f9fa; 
                    padding: 15px; 
                    border: 1px solid #000; 
                    margin-bottom: 20px;
                }
                .partner-details { 
                    display: grid; 
                    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); 
                    gap: 10px;
                }
                .partner-detail-item strong { 
                    display: block; 
                    font-weight: bold;
                    color: #000;
                }
                .saldo-info { 
                    background: #e9ecef; 
                    padding: 15px; 
                    border: 1px solid #000; 
                    margin-bottom: 20px;
                }
                .saldo-value { 
                    font-size: 18px; 
                    font-weight: bold;
                }
                table { 
                    width: 100%; 
                    border-collapse: collapse; 
                    margin-top: 10px;
                }
                th, td { 
                    border: 1px solid #000; 
                    padding: 8px; 
                    text-align: left;
                }
                th { 
                    background-color: #f8f9fa; 
                    font-weight: bold;
                }
                .transaction-type { 
                    padding: 2px 6px; 
                    border-radius: 3px; 
                    font-size: 11px; 
                    font-weight: bold;
                }
                .transaction-otpremnica { 
                    background-color: #e3f2fd; 
                    color: #1976d2;
                }
                .transaction-uplata { 
                    background-color: #e8f5e8; 
                    color: #2e7d32;
                }
                @media print {
                    body { margin: 0; }
                }
            </style>
        </head>
        <body>
            ${modalContent.innerHTML}
        </body>
        </html>
    `);
    
    printWindow.document.close();
    printWindow.focus();
    
    // Wait for content to load then print
    setTimeout(() => {
        printWindow.print();
        printWindow.close();
    }, 500);
}
        // Load partner saldos on page load
        async function loadPartnerSaldos() {
            try {
                const response = await fetch('/api/karticekupca/saldos');
                const data = await response.json();
                
                if (data.success) {
                    // Update saldo values in table
                    data.saldos.forEach(saldo => {
                        const row = document.querySelector(`[data-partner-id="${saldo.sifra}"]`);
                        if (row) {
                            const saldoCell = row.querySelector('.saldo-cell');
                            const saldoValue = row.querySelector('.saldo-value');
                            
                            const saldoAmount = parseFloat(saldo.saldo) || 0;
                            saldoCell.dataset.saldo = saldoAmount;
                            saldoValue.textContent = formatCurrency(saldoAmount);
                            
                            // Add appropriate class for styling
                            saldoValue.classList.remove('saldo-positive', 'saldo-negative');
                            if (saldoAmount > 0) {
                                saldoValue.classList.add('saldo-positive');
                            } else if (saldoAmount < 0) {
                                saldoValue.classList.add('saldo-negative');
                            }
                        }
                    });
                    
                    updateSummaryStats();
                }
            } catch (error) {
                console.error('Error loading partner saldos:', error);
            }
        }

        // Update summary statistics
        function updateSummaryStats() {
            const visibleRows = document.querySelectorAll('.customer-row:not([style*="display: none"])');
            let positiveSaldo = 0;
            let negativeSaldo = 0;
            let totalSaldo = 0;
            
            visibleRows.forEach(row => {
                const saldoValue = parseFloat(row.querySelector('.saldo-cell').dataset.saldo) || 0;
                totalSaldo += saldoValue;
                
                if (saldoValue > 0) {
                    positiveSaldo++;
                } else if (saldoValue < 0) {
                    negativeSaldo++;
                }
            });
            
            document.getElementById('positive-saldo').textContent = positiveSaldo;
            document.getElementById('negative-saldo').textContent = negativeSaldo;
            document.getElementById('total-saldo').textContent = formatCurrency(totalSaldo);
        }


        // Show customer details modal
async function showCustomerDetails(partnerId, partnerName) {
    try {
        const dateFrom = document.getElementById('date-from').value;
        const dateTo = document.getElementById('date-to').value;
        
        const url = `/api/karticekupca/partner/${partnerId}?datum_od=${dateFrom}&datum_do=${dateTo}`;
        const response = await fetch(url);
        const data = await response.json();
        
        if (data.success) {
            // Fill partner info
            document.getElementById('partner-sifra').textContent = data.partner.Sifra || '';
            document.getElementById('partner-naziv').textContent = data.partner.Naziv_partnera || '';
            document.getElementById('partner-grad').textContent = data.partner.Grad || '';
            document.getElementById('partner-pib').textContent = data.partner.PIB || '';
            document.getElementById('partner-pdv').textContent = data.partner.PDV || '';
            document.getElementById('partner-adresa').textContent = data.partner.Adresa || '';
            document.getElementById('partner-telefon').textContent = data.partner.Telefon || '';
            document.getElementById('partner-fax').textContent = data.partner.Fax || '';
            document.getElementById('partner-email').textContent = data.partner.E_mail || '';
            
            // Calculate and display financial overview
            const otpremniceTotal = data.otpremnice.reduce((sum, doc) => sum + (parseFloat(doc.iznos_sa_pdv) || 0), 0);
            const uplateTotal = data.uplate.reduce((sum, payment) => sum + (parseFloat(payment.iznos) || 0), 0);
            const saldo = uplateTotal - otpremniceTotal;
            
            document.getElementById('partner-otpremnice').textContent = formatCurrency(otpremniceTotal);
            document.getElementById('partner-uplate').textContent = formatCurrency(uplateTotal);
            document.getElementById('partner-saldo').textContent = formatCurrency(saldo);
            
            // Style saldo based on value
            const saldoElement = document.getElementById('partner-saldo');
            saldoElement.classList.remove('saldo-positive', 'saldo-negative');
            if (saldo > 0) {
                saldoElement.classList.add('saldo-positive');
            } else if (saldo < 0) {
                saldoElement.classList.add('saldo-negative');
            }
            
            // Combine and sort transactions
            const transactionsTbody = document.getElementById('transactions-tbody');
            transactionsTbody.innerHTML = '';
            
            // Create combined array of all transactions
            const allTransactions = [];
            
            // Add otpremnice
            if (data.otpremnice && data.otpremnice.length > 0) {
                data.otpremnice.forEach(doc => {
                    allTransactions.push({
                        type: 'otpremnica',
                        datum: doc.datum,
                        tip_dokumenta: doc.tip_dokumenta,
                        kolicina: doc.kolicina,
                        iznos_bez_pdv: doc.iznos_bez_pdv,
                        iznos_sa_pdv: doc.iznos_sa_pdv,
                        pdv_iznos: doc.pdv_iznos,
                        nacin_placanja: '',
                        status: '',
                        dokument: '',
                        napomene: ''
                    });
                });
            }
            
            // Add uplate
            if (data.uplate && data.uplate.length > 0) {
                data.uplate.forEach(payment => {
                    allTransactions.push({
                        type: 'uplata',
                        datum: payment.datum,
                        tip_dokumenta: '',
                        kolicina: '',
                        iznos_bez_pdv: '',
                        iznos_sa_pdv: '',
                        pdv_iznos: '',
                        nacin_placanja: payment.nacin,
                        status: payment.status,
                        dokument: payment.dokument,
                        napomene: payment.napomene,
                        iznos: payment.iznos
                    });
                });
            }
            
            // Sort transactions by date (oldest first)
            allTransactions.sort((a, b) => new Date(a.datum) - new Date(b.datum));
            
            // Populate the combined table
            if (allTransactions.length > 0) {
                allTransactions.forEach(transaction => {
                    const row = document.createElement('tr');
                    const datum = transaction.datum ? new Date(transaction.datum).toLocaleDateString('sr-RS') : '';
                    
                    let statusClass = '';
                    if (transaction.type === 'uplata') {
                        switch(transaction.status) {
                            case 'primljena':
                                statusClass = 'style="color: var(--success-color); font-weight: 600;"';
                                break;
                            case 'odbijena':
                                statusClass = 'style="color: var(--accent-color); font-weight: 600;"';
                                break;
                            case 'cekanje':
                                statusClass = 'style="color: var(--warning-color); font-weight: 600;"';
                                break;
                        }
                    }
                    
                    // Format amounts
                    const iznosBezPdv = transaction.type === 'otpremnica' ? 
                        formatCurrency(parseFloat(transaction.iznos_bez_pdv) || 0) : '';
                    const iznosSaPdv = transaction.type === 'otpremnica' ? 
                        formatCurrency(parseFloat(transaction.iznos_sa_pdv) || 0) : 
                        formatCurrency(parseFloat(transaction.iznos) || 0);
                    const pdvIznos = transaction.type === 'otpremnica' ? 
                        formatCurrency(parseFloat(transaction.pdv_iznos) || 0) : '';
                    
                    row.innerHTML = `
                        <td>${datum}</td>
                        <td>
                            <span class="transaction-type ${transaction.type === 'otpremnica' ? 'transaction-otpremnica' : 'transaction-uplata'}">
                                ${transaction.type === 'otpremnica' ? 'Otpremnica' : 'Uplata'}
                            </span>
                        </td>
                        <td>${transaction.tip_dokumenta || ''}</td>
                        <td>${transaction.kolicina || ''}</td>
                        <td>${iznosBezPdv}</td>
                        <td>${iznosSaPdv}</td>
                        <td>${pdvIznos}</td>
                        <td>${transaction.nacin_placanja || ''}</td>
                        <td ${statusClass}>${transaction.status || ''}</td>
                        <td>${transaction.dokument || ''}</td>
                        <td>${transaction.napomene || ''}</td>
                    `;
                    transactionsTbody.appendChild(row);
                });
            } else {
                const row = document.createElement('tr');
                row.innerHTML = '<td colspan="11" style="text-align: center; color: #666;">Nema pronađenih transakcija</td>';
                transactionsTbody.appendChild(row);
            }
            
            // Show modal
            customerModal.classList.add('show');
        } else {
            alert('Greška pri učitavanju podataka o partneru');
        }
    } catch (error) {
        console.error('Error fetching partner details:', error);
        alert('Greška pri učitavanju podataka o partneru');
    }
}


        closeModal.addEventListener('click', function() {
            customerModal.classList.remove('show');
        });

        customerModal.addEventListener('click', function(e) {
            if (e.target === this) {
                this.classList.remove('show');
            }
        });

        // Print functionality
        document.getElementById('print-btn').addEventListener('click', function() {
            window.print();
        });

        // Filter functionality
        document.getElementById('apply-filter').addEventListener('click', function() {
            const fromDate = document.getElementById('date-from').value;
            const toDate = document.getElementById('date-to').value;
            
            if (fromDate && toDate && new Date(fromDate) > new Date(toDate)) {
                alert('Početni datum ne može biti veći od krajnjeg datuma!');
                return;
            }
            
            loadPartnerSaldos();
        });

        // Utility function to format currency
        function formatCurrency(amount) {
            return new Intl.NumberFormat('sr-RS', {
                style: 'currency',
                currency: 'EUR',
                minimumFractionDigits: 2
            }).format(amount);
        }

        // Handle window resize
        window.addEventListener('resize', function() {
            if (window.innerWidth > 576) {
                sidebar.classList.remove('mobile-open');
            }
            
            if (window.innerWidth <= 992 && window.innerWidth > 576) {
                if (!sidebar.classList.contains('collapsed')) {
                    sidebar.classList.add('collapsed');
                    mainContent.classList.add('expanded');
                    header.classList.add('expanded');
                    sidebarIcon.classList.remove('fa-chevron-left');
                    sidebarIcon.classList.add('fa-chevron-right');
                }
            }
        });

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            // Auto collapse sidebar on medium screens on load
            if (window.innerWidth <= 992 && window.innerWidth > 576) {
                sidebar.classList.add('collapsed');
                mainContent.classList.add('expanded');
                header.classList.add('expanded');
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            }
            
            // Load initial saldos
            loadPartnerSaldos();
        });
    </script>
