    <!-- Add/Edit Komercijalist Modal -->
    <div class="modal" id="salesperson-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="modal-title">Novi komercijalist</h2>
                <button class="close-btn" id="close-modal">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <form id="salesperson-form">
                <input type="hidden" id="salesperson-id">
                
                <div class="form-group">
                    <label class="form-label" for="ime-prezime">Ime i prezime *</label>
                    <input type="text" class="form-control" id="ime-prezime" required>
                </div>
                
                <div class="form-group">
                    <label class="form-label" for="status">Status</label>
                    <select class="form-control" id="status">
                        <option value="aktivan">Aktivan</option>
                        <option value="neaktivan">Neaktivan</option>
                        <option value="pauza">Pauza</option>
                    </select>
                </div>
                
                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" id="cancel-btn">Otkaži</button>
                    <button type="submit" class="btn btn-success" id="save-btn">
                        <i class="fas fa-save"></i>
                        <span>Sačuvaj</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Global variables
        let komercijalisti = [];
        let dokumentiData = [];
        let currentEditId = null;
        let currentFilters = {
            dateFrom: null,
            dateTo: null
        };

        // DOM elements
        const sidebar = document.getElementById('sidebar');
        const sidebarOverlay = document.getElementById('sidebar-overlay');
        const mainContent = document.getElementById('main-content');
        const header = document.getElementById('header');
        const toggleSidebar = document.getElementById('toggle-sidebar');
        const sidebarIcon = document.getElementById('sidebar-icon');
        const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
        const searchInput = document.getElementById('search-salespeople');
        const statusFilter = document.getElementById('status-filter');
        const dateFromInput = document.getElementById('date-from');
        const dateToInput = document.getElementById('date-to');
        const applyFiltersBtn = document.getElementById('apply-filters');
        const salespersonModal = document.getElementById('salesperson-modal');
        const salespersonForm = document.getElementById('salesperson-form');

        // Load data from server-side rendered EJS
        function loadKomercijalistiData() {
            // This will be populated by EJS template
            komercijalisti = <%- JSON.stringify(komercijalisti || []) %>;
            console.log('Loaded komercijalisti:', komercijalisti.length);
            
            // Load documents data and calculate performance
            loadDocumentiData();
        }

        // Load documents data from API
        async function loadDocumentiData() {
            try {
                const response = await fetch('/api/pravljenjedokumenta/dokumenti?limit=1000');
                if (!response.ok) throw new Error('Failed to fetch documents');
                
                dokumentiData = await response.json();
                console.log('Loaded dokumenti:', dokumentiData.length);
                
                calculatePerformanceData();
                renderTable();
                updateStats();
            } catch (error) {
                console.error('Error loading documents data:', error);
                // Fallback to basic rendering without performance data
                renderTable();
                updateStats();
            }
        }

        // Calculate performance data from documents
        function calculatePerformanceData() {
            const filteredDocuments = filterDocumentsByDate(dokumentiData);
            
            // Calculate performance metrics for each komercijalist
            komercijalisti.forEach(komercijalist => {
                const komercijalistDocs = filteredDocuments.filter(doc => 
                    doc.komercijalist_id === komercijalist.id
                );
                
                komercijalist.broj_dokumenata = komercijalistDocs.length;
                komercijalist.ukupan_promet = komercijalistDocs.reduce((sum, doc) => 
                    sum + (parseFloat(doc.iznos_sa_pdv) || 0), 0
                );
                komercijalist.broj_kupaca = new Set(komercijalistDocs.map(doc => doc.partner)).size;
            });
            
            // Calculate performance percentages (0-100% based on relative performance)
            const maxPromet = Math.max(...komercijalisti.map(k => k.ukupan_promet || 0));
            const maxDokumenti = Math.max(...komercijalisti.map(k => k.broj_dokumenata || 0));
            
            komercijalisti.forEach(komercijalist => {
                let performanceScore = 0;
                
                if (maxPromet > 0 && maxDokumenti > 0) {
                    const prometScore = ((komercijalist.ukupan_promet || 0) / maxPromet) * 60; // 60% weight for revenue
                    const dokumentiScore = ((komercijalist.broj_dokumenata || 0) / maxDokumenti) * 40; // 40% weight for document count
                    performanceScore = prometScore + dokumentiScore;
                }
                
                komercijalist.calculated_performanse = Math.round(performanceScore);
            });
        }

        // Filter documents by date range
        function filterDocumentsByDate(documents) {
            if (!currentFilters.dateFrom && !currentFilters.dateTo) {
                return documents;
            }
            
            return documents.filter(doc => {
                const docDate = new Date(doc.datum);
                const fromDate = currentFilters.dateFrom ? new Date(currentFilters.dateFrom) : null;
                const toDate = currentFilters.dateTo ? new Date(currentFilters.dateTo) : null;
                
                if (fromDate && docDate < fromDate) return false;
                if (toDate && docDate > toDate) return false;
                return true;
            });
        }

        // Calculate stats from komercijalisti data
        function updateStats() {
            const statsGrid = document.getElementById('stats-grid');
            
            const totalKomercijalisti = komercijalisti.length;
            const aktivniKomercijalisti = komercijalisti.filter(k => k.status === 'aktivan').length;
            const totalPromet = komercijalisti.reduce((sum, k) => sum + (k.ukupan_promet || 0), 0);
            const totalDokumenti = komercijalisti.reduce((sum, k) => sum + (k.broj_dokumenata || 0), 0);
            
            // Find best performer by performance percentage
            const najboljiKomercijalist = komercijalisti.reduce((best, current) => {
                return (current.calculated_performanse || 0) > (best.calculated_performanse || 0) ? current : best;
            }, { ime_prezime: 'N/A', calculated_performanse: 0 });

            const najboljiNaziv = najboljiKomercijalist.ime_prezime !== 'N/A' 
                ? najboljiKomercijalist.ime_prezime.split(' ').slice(0, 2).join(' ')
                : 'N/A';

            const dateRangeText = currentFilters.dateFrom || currentFilters.dateTo 
                ? ` (${currentFilters.dateFrom || 'početak'} - ${currentFilters.dateTo || 'danas'})`
                : '';

            statsGrid.innerHTML = `
                <div class="stat-card">
                    <i class="fas fa-users stat-icon"></i>
                    <div class="stat-number">${totalKomercijalisti}</div>
                    <div class="stat-label">Ukupno komercijalista</div>
                </div>
                <div class="stat-card success">
                    <i class="fas fa-user-check stat-icon"></i>
                    <div class="stat-number">${aktivniKomercijalisti}</div>
                    <div class="stat-label">Aktivni komercijalisti</div>
                </div>
                <div class="stat-card info">
                    <i class="fas fa-euro-sign stat-icon"></i>
                    <div class="stat-number">€${Math.round(totalPromet / 1000)}K</div>
                    <div class="stat-label">Ukupan promet${dateRangeText}</div>
                </div>
                <div class="stat-card warning">
                    <i class="fas fa-file-alt stat-icon"></i>
                    <div class="stat-number">${totalDokumenti}</div>
                    <div class="stat-label">Ukupno dokumenata${dateRangeText}</div>
                </div>
            `;
        }

        // Render table with komercijalisti data
        function renderTable() {
            const tbody = document.getElementById('salespeople-tbody');
            tbody.innerHTML = '';

            if (komercijalisti.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 2rem; color: #999;">
                            Nema komercijalista za prikaz
                        </td>
                    </tr>
                `;
                return;
            }

            komercijalisti.forEach(komercijalist => {
                const row = document.createElement('tr');
                
                const performanse = komercijalist.calculated_performanse || 0;
                const performanseClass = 
                    performanse >= 80 ? 'performance-excellent' :
                    performanse >= 60 ? 'performance-good' :
                    performanse >= 40 ? 'performance-average' : 'performance-poor';

                const statusClass = 
                    komercijalist.status === 'aktivan' ? 'status-active' :
                    komercijalist.status === 'pauza' ? 'status-vacation' : 'status-inactive';

                const dateRangeText = currentFilters.dateFrom || currentFilters.dateTo 
                    ? ` (${currentFilters.dateFrom || ''} - ${currentFilters.dateTo || ''})`
                    : '';

                row.innerHTML = `
                    <td>${komercijalist.id}</td>
                    <td>${komercijalist.ime_prezime}</td>
                    <td>${komercijalist.broj_dokumenata || 0}</td>
                    <td class="currency">€${(komercijalist.ukupan_promet || 0).toLocaleString('de-DE', {minimumFractionDigits: 2})}</td>
                    <td>
                        <div class="performance-indicator">
                            <div class="performance-bar">
                                <div class="performance-fill ${performanseClass}" style="width: ${Math.min(performanse, 100)}%"></div>
                            </div>
                            <span style="font-size: 12px; font-weight: 500; min-width: 35px;">${performanse}%</span>
                        </div>
                    </td>
                    <td>
                        <span class="status-badge ${statusClass}" onclick="toggleStatus(${komercijalist.id}, '${komercijalist.status}')" title="Kliknite da promenite status">
                            ${komercijalist.status}
                        </span>
                    </td>
                    <td>
                        <div class="action-buttons">
                            <button class="btn btn-primary btn-sm" onclick="editKomercijalist(${komercijalist.id})" title="Uredi">
                                <i class="fas fa-edit"></i>
                                <span>Uredi</span>
                            </button>
                            <button class="btn btn-danger btn-sm" onclick="deleteKomercijalist(${komercijalist.id})" title="Obriši">
                                <i class="fas fa-trash"></i>
                                <span>Obriši</span>
                            </button>
                        </div>
                    </td>
                `;
                tbody.appendChild(row);
            });
        }

        // Filter table based on search and status
        function filterTable() {
            const searchTerm = searchInput.value.toLowerCase();
            const statusValue = statusFilter.value;
            const rows = document.querySelectorAll('#salespeople-tbody tr');
            
            rows.forEach(row => {
                if (row.cells.length === 1) return; // Skip empty state row
                
                const name = row.cells[1].textContent.toLowerCase();
                const status = row.querySelector('.status-badge').textContent.trim();
                
                const matchesSearch = name.includes(searchTerm);
                const matchesStatus = !statusValue || status === statusValue;
                
                row.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
            });
        }

        // Apply date filters
        function applyDateFilters() {
            currentFilters.dateFrom = dateFromInput.value || null;
            currentFilters.dateTo = dateToInput.value || null;
            
            console.log('Applying filters:', currentFilters);
            
            // Recalculate performance with new date filters
            calculatePerformanceData();
            renderTable();
            updateStats();
            
            showNotification('Filtri primenjeni', 'success');
        }

        // Modal functions
        function openModal(title = 'Novi komercijalist', komercijalist = null) {
            document.getElementById('modal-title').textContent = title;
            
            if (komercijalist) {
                document.getElementById('salesperson-id').value = komercijalist.id;
                document.getElementById('ime-prezime').value = komercijalist.ime_prezime || '';
                document.getElementById('status').value = komercijalist.status || 'aktivan';
                currentEditId = komercijalist.id;
            } else {
                salespersonForm.reset();
                document.getElementById('salesperson-id').value = '';
                currentEditId = null;
            }
            
            salespersonModal.classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            salespersonModal.classList.remove('show');
            document.body.style.overflow = '';
            salespersonForm.reset();
            currentEditId = null;
        }

        function editKomercijalist(id) {
            const komercijalist = komercijalisti.find(k => k.id === id);
            if (komercijalist) {
                openModal('Uredi komercijalista', komercijalist);
            }
        }

        // Status toggle function
        function toggleStatus(id, currentStatus) {
            const statuses = ['aktivan', 'neaktivan', 'pauza'];
            const currentIndex = statuses.indexOf(currentStatus);
            const newStatus = statuses[(currentIndex + 1) % statuses.length];
            
            // Send status update to server
            updateStatus(id, newStatus);
        }

        // API functions for CRUD operations
        async function saveKomercijalist(data, id = null) {
            try {
                showLoading(true);
                const url = id ? `/komercijalisti/${id}` : '/komercijalisti';
                const method = id ? 'PUT' : 'POST';
                
                const response = await fetch(url, {
                    method: method,
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                
                if (!response.ok) {
                    throw new Error(result.error || 'Greška pri čuvanju');
                }

                showNotification(result.message || 'Uspešno sačuvano', 'success');
                closeModal();
                
                // Refresh page to get updated data
                window.location.reload();
                
            } catch (error) {
                console.error('Error saving komercijalist:', error);
                showNotification(error.message || 'Greška pri čuvanju', 'error');
            } finally {
                showLoading(false);
            }
        }

        async function deleteKomercijalist(id) {
            if (!confirm('Da li ste sigurni da želite da obrišete ovog komercijalista?')) {
                return;
            }

            try {
                showLoading(true);
                const response = await fetch(`/komercijalisti/${id}`, {
                    method: 'DELETE'
                });

                const result = await response.json();
                
                if (!response.ok) {
                    throw new Error(result.error || 'Greška pri brisanju');
                }

                showNotification(result.message || 'Uspešno obrisano', 'success');
                
                // Refresh page to get updated data
                window.location.reload();
                
            } catch (error) {
                console.error('Error deleting komercijalist:', error);
                showNotification(error.message || 'Greška pri brisanju', 'error');
            } finally {
                showLoading(false);
            }
        }

        async function updateStatus(id, newStatus) {
            try {
                showLoading(true);
                const response = await fetch(`/komercijalisti/${id}/status`, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ status: newStatus })
                });

                const result = await response.json();
                
                if (!response.ok) {
                    throw new Error(result.error || 'Greška pri ažuriranju statusa');
                }

                showNotification(result.message || 'Status ažuriran', 'success');
                
                // Refresh page to get updated data
                window.location.reload();
                
            } catch (error) {
                console.error('Error updating status:', error);
                showNotification(error.message || 'Greška pri ažuriranju statusa', 'error');
            } finally {
                showLoading(false);
            }
        }

        // Utility functions
        function showLoading(show) {
            if (show) {
                document.body.classList.add('loading');
            } else {
                document.body.classList.remove('loading');
            }
        }

        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.textContent = message;
            document.body.appendChild(notification);
            
            setTimeout(() => notification.classList.add('show'), 100);
            setTimeout(() => {
                notification.classList.remove('show');
                setTimeout(() => document.body.removeChild(notification), 300);
            }, 3000);
        }

        // Event listeners
        document.addEventListener('DOMContentLoaded', function() {
            // Set default date range to current month
            const now = new Date();
            const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
            const lastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0);
            
            dateFromInput.value = firstDay.toISOString().split('T')[0];
            dateToInput.value = lastDay.toISOString().split('T')[0];
            
            currentFilters.dateFrom = dateFromInput.value;
            currentFilters.dateTo = dateToInput.value;
            
            loadKomercijalistiData();
            
            // Responsive setup
            if (window.innerWidth <= 992 && window.innerWidth > 576) {
                sidebar.classList.add('collapsed');
                mainContent.classList.add('expanded');
                header.classList.add('expanded');
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            }
        });

        // Mobile sidebar functions
        function closeMobileSidebar() {
            if (window.innerWidth <= 576) {
                sidebar.classList.remove('mobile-open');
                sidebarOverlay.classList.remove('show');
                document.body.style.overflow = '';
            }
        }

        mobileMenuToggle.addEventListener('click', function() {
            sidebar.classList.toggle('mobile-open');
            sidebarOverlay.classList.toggle('show');
            if (sidebar.classList.contains('mobile-open')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = '';
            }
        });

        sidebarOverlay.addEventListener('click', closeMobileSidebar);

        document.addEventListener('click', function(e) {
            if (window.innerWidth <= 576) {
                if (!sidebar.contains(e.target) && !mobileMenuToggle.contains(e.target)) {
                    closeMobileSidebar();
                }
            }
        });

        // Sidebar toggle
        toggleSidebar.addEventListener('click', function() {
            sidebar.classList.toggle('collapsed');
            mainContent.classList.toggle('expanded');
            header.classList.toggle('expanded');
            
            if (sidebar.classList.contains('collapsed')) {
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            } else {
                sidebarIcon.classList.remove('fa-chevron-right');
                sidebarIcon.classList.add('fa-chevron-left');
            }
        });

        // Submenu toggle
        document.querySelectorAll('.nav-item.has-submenu > .nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const parent = this.parentElement;
                const submenu = parent.querySelector('.submenu');
                
                document.querySelectorAll('.nav-item.has-submenu').forEach(item => {
                    if (item !== parent) {
                        item.classList.remove('open');
                        item.querySelector('.submenu').classList.remove('open');
                    }
                });
                
                parent.classList.toggle('open');
                submenu.classList.toggle('open');
            });
        });

        // Search and filter
        searchInput.addEventListener('input', filterTable);
        statusFilter.addEventListener('change', filterTable);
        applyFiltersBtn.addEventListener('click', applyDateFilters);

        // Header actions
        document.getElementById('add-salesperson-btn').addEventListener('click', () => openModal());
        document.getElementById('refresh-btn').addEventListener('click', () => window.location.reload());

        // Modal events
        document.getElementById('close-modal').addEventListener('click', closeModal);
        document.getElementById('cancel-btn').addEventListener('click', closeModal);

        // Form submission
        salespersonForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = {
                ime_prezime: document.getElementById('ime-prezime').value.trim(),
                status: document.getElementById('status').value
            };

            if (!formData.ime_prezime) {
                showNotification('Ime i prezime je obavezno', 'error');
                return;
            }

            saveKomercijalist(formData, currentEditId);
        });

        // Close modals on escape
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeModal();
            }
        });

        // Navigation link clicks
        document.querySelectorAll('.submenu .nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 100);
                closeMobileSidebar();
            });
        });

        // Responsive handling
        window.addEventListener('resize', function() {
            if (window.innerWidth > 576) {
                closeMobileSidebar();
            }
            if (window.innerWidth <= 992 && window.innerWidth > 576) {
                if (!sidebar.classList.contains('collapsed')) {
                    sidebar.classList.add('collapsed');
                    mainContent.classList.add('expanded');
                    header.classList.add('expanded');
                    sidebarIcon.classList.remove('fa-chevron-left');
                    sidebarIcon.classList.add('fa-chevron-right');
                }
            }
        });

        // Make functions globally available
        window.editKomercijalist = editKomercijalist;
        window.deleteKomercijalist = deleteKomercijalist;
        window.toggleStatus = toggleStatus;
    </script>
</body>
</html>