    <main class="main-content" id="main-content">
        <div class="stats-grid" id="stats-grid">
            <!-- Stats will be populated dynamically from komercijalisti data -->
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Lista komercijalista</h3>
                <div class="search-filter-container">
                    <div class="search-box">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" class="form-control" id="search-salespeople" placeholder="Pretraži komercijaliste...">
                    </div>
                    <select class="form-control" id="status-filter" style="width: auto; min-width: 150px;">
                        <option value="">Svi statusi</option>
                        <option value="aktivan">Aktivni</option>
                        <option value="neaktivan">Neaktivni</option>
                        <option value="pauza">Na pauzi</option>
                    </select>
                    <div class="date-filter-group">
                        <label>Od:</label>
                        <input type="date" class="form-control" id="date-from" style="width: auto; min-width: 140px;">
                    </div>
                    <div class="date-filter-group">
                        <label>Do:</label>
                        <input type="date" class="form-control" id="date-to" style="width: auto; min-width: 140px;">
