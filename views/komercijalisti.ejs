                <table class="data-table" id="salespeople-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Ime i prezime</th>
                            <th>Broj dokumenata</th>
                            <th>Ukupan promet (€)</th>
                            <th>Performanse</th>
                            <th>Status</th>
                            <th>Akcije</th>
                        </tr>
                    </thead>
                    <tbody id="salespeople-tbody">
                        <!-- Data will be populated dynamically -->
                    </tbody>
