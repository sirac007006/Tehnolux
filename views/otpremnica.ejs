    <script>
        // DOM Elements
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.getElementById('main-content');
        const header = document.getElementById('header');
        const toggleSidebar = document.getElementById('toggle-sidebar');
        const sidebarIcon = document.getElementById('sidebar-icon');
        const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
        
        // Modal elements
        const partnerModal = document.getElementById('partner-modal');
        const closePartnerModal = document.getElementById('close-partner-modal');
        const cancelPartnerBtn = document.getElementById('cancel-partner-btn');
        const confirmPartnerBtn = document.getElementById('confirm-partner-btn');
        const searchPartnersInput = document.getElementById('search-partners');
        const partnersGrid = document.getElementById('partners-grid');
        
        // Discount elements
        const discountSection = document.getElementById('discount-section');
        const partnerDiscountInput = document.getElementById('partner-discount');
        const discountInfo = document.getElementById('discount-info');
        const resetDiscountBtn = document.getElementById('reset-discount-btn');
        
        // Article selection elements
        const createOtpremnicaBtn = document.getElementById('create-otpremnica-btn');
        const selectedCount = document.getElementById('selected-count');
        const selectedItemsCount = document.getElementById('selected-items-count');
        const selectAllBtn = document.getElementById('select-all-btn');
        const deselectAllBtn = document.getElementById('deselect-all-btn');
        
        // Search
        const searchInput = document.getElementById('search-articles');
        
        // Print elements
        const printDocument = document.getElementById('print-document');
        
        // Data
        let selectedPartner = null;
        let allPartners = [];
        let currentDiscount = 0;

        // Function to close mobile sidebar
        function closeMobileSidebar() {
            if (window.innerWidth <= 576) {
                sidebar.classList.remove('mobile-open');
                document.body.style.overflow = '';
            }
        }

        // Mobile menu functionality
        if (mobileMenuToggle) {
            mobileMenuToggle.addEventListener('click', function() {
                sidebar.classList.toggle('mobile-open');
                
                if (sidebar.classList.contains('mobile-open')) {
                    document.body.style.overflow = 'hidden';
                } else {
                    document.body.style.overflow = '';
                }
            });
        }

        document.addEventListener('click', function(e) {
            if (window.innerWidth <= 576) {
                if (!sidebar.contains(e.target) && !mobileMenuToggle.contains(e.target)) {
                    closeMobileSidebar();
                }
            }
        });

        // Toggle sidebar
        toggleSidebar.addEventListener('click', function() {
            sidebar.classList.toggle('collapsed');
            mainContent.classList.toggle('expanded');
            header.classList.toggle('expanded');
            
            if (sidebar.classList.contains('collapsed')) {
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            } else {
                sidebarIcon.classList.remove('fa-chevron-right');
                sidebarIcon.classList.add('fa-chevron-left');
            }
        });

        // Submenu functionality
        document.querySelectorAll('.nav-item.has-submenu > .nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const parent = this.parentElement;
                const submenu = parent.querySelector('.submenu');
                
                document.querySelectorAll('.nav-item.has-submenu').forEach(item => {
                    if (item !== parent) {
                        item.classList.remove('open');
                        item.querySelector('.submenu').classList.remove('open');
                    }
                });
                
                parent.classList.toggle('open');
                submenu.classList.toggle('open');
            });
        });

        // Checkbox functionality
        function updateSelectedCount() {
            const checkedBoxes = document.querySelectorAll('.article-checkbox:checked');
            const count = checkedBoxes.length;
            
            if (count > 0) {
                selectedCount.style.display = 'block';
                selectedItemsCount.textContent = count;
                createOtpremnicaBtn.disabled = false;
            } else {
                selectedCount.style.display = 'none';
                createOtpremnicaBtn.disabled = true;
            }
        }

        function attachCheckboxListeners() {
            // Individual checkboxes
            document.querySelectorAll('.article-checkbox').forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    const row = this.closest('tr');
                    const quantityInput = row.querySelector('.quantity-input');
                    
                    if (this.checked) {
                        row.classList.add('selected');
                        quantityInput.disabled = false;
                        quantityInput.focus();
                    } else {
                        row.classList.remove('selected');
                        quantityInput.disabled = true;
                        quantityInput.value = 1;
                    }
                    
                    updateSelectedCount();
                });
            });
        }

        // Select all / Deselect all
        selectAllBtn.addEventListener('click', function() {
            document.querySelectorAll('.article-checkbox').forEach(checkbox => {
                if (!checkbox.checked) {
                    checkbox.checked = true;
                    const row = checkbox.closest('tr');
                    const quantityInput = row.querySelector('.quantity-input');
                    row.classList.add('selected');
                    quantityInput.disabled = false;
                }
            });
            updateSelectedCount();
        });

        deselectAllBtn.addEventListener('click', function() {
            document.querySelectorAll('.article-checkbox').forEach(checkbox => {
                checkbox.checked = false;
                const row = checkbox.closest('tr');
                const quantityInput = row.querySelector('.quantity-input');
                row.classList.remove('selected');
                quantityInput.disabled = true;
                quantityInput.value = 1;
            });
            updateSelectedCount();
        });

        // Load partners from database
        async function loadPartners() {
            try {
                console.log('Loading partners...'); // Debug log
                const response = await fetch('/api/partneri');
                if (response.ok) {
                    allPartners = await response.json();
                    console.log('Loaded partners:', allPartners.length); // Debug log
                    console.log('Sample partner:', allPartners[0]); // Debug log
                } else {
                    console.error('Error loading partners - Response not OK:', response.status);
                    // Fallback to test data if API fails
                    allPartners = [
                        {
                            Sifra: '0610',
                            Naziv_partnera: 'HARIS BALIC',
                            Grad: 'Podgorica',
                            PIB: '02390264',
                            Adresa: 'Bulevar Pera Cetkovica 36',
                            Telefon: '020/656-411',
                            Fax: '',
                            E_mail: 'haris@example.com',
                            rabat: '5.0'
                        },
                        {
                            Sifra: '0611',
                            Naziv_partnera: 'MILAN JOVANOVIĆ DOO',
                            Grad: 'Nikšić',
                            PIB: '12345678',
                            Adresa: 'Njegoševa 25',
                            Telefon: '040/123-456',
                            Fax: '040/123-457',
                            E_mail: 'milan@example.com',
                            rabat: '10.0'
                        },
                        {
                            Sifra: '0612',
                            Naziv_partnera: 'TECH SOLUTIONS',
                            Grad: 'Podgorica',
                            PIB: '87654321',
                            Adresa: 'Vojvode Mićuna 12',
                            Telefon: '020/789-123',
                            Fax: '',
                            E_mail: 'info@techsolutions.me',
                            rabat: '15.0'
                        }
                    ];
                }
                
                // Clear search input when modal opens
                searchPartnersInput.value = '';
                
                displayPartners(allPartners);
            } catch (error) {
                console.error('Error loading partners:', error);
                // Fallback to test data on error
                allPartners = [
                    {
                        Sifra: '0610',
                        Naziv_partnera: 'HARIS BALIC',
                        Grad: 'Podgorica',
                        PIB: '02390264',
                        Adresa: 'Bulevar Pera Cetkovica 36',
                        Telefon: '020/656-411',
                        Fax: '',
                        E_mail: 'haris@example.com',
                        rabat: '5.0'
                    }
                ];
                displayPartners(allPartners);
            }
        }

        // Display partners
        function displayPartners(partners) {
            let partnersHTML = '';
            
            if (partners.length === 0) {
                partnersHTML = '<div style="text-align: center; padding: 20px; color: #666;">Nema pronađenih partnera.</div>';
            } else {
                partners.forEach(partner => {
                    // Handle different possible column names (case insensitive)
                    const sifra = partner.Sifra || partner.sifra || 'N/A';
                    const naziv = partner.Naziv_partnera || partner.naziv_partnera || 'N/A';
                    const grad = partner.Grad || partner.grad || 'N/A';
                    const pib = partner.PIB || partner.pib || 'N/A';
                    const adresa = partner.Adresa || partner.adresa || 'N/A';
                    const telefon = partner.Telefon || partner.telefon || 'N/A';
                    const rabat = partner.rabat || partner.Rabat || '0';
                    
                    partnersHTML += `
                        <div class="partner-item" data-sifra="${sifra}" data-partner='${JSON.stringify(partner)}'>
                            <div class="partner-name">${naziv} 
                                <span style="color: var(--success-color); font-weight: bold; margin-left: 10px;">
                                    <i class="fas fa-percent"></i> ${parseFloat(rabat).toFixed(1)}%
                                </span>
                            </div>
                            <div class="partner-details">
                                Šifra: ${sifra} | PIB: ${pib} | ${grad}
                                <br>Adresa: ${adresa} | Tel: ${telefon}
                            </div>
                        </div>
                    `;
                });
            }
            
            partnersGrid.innerHTML = partnersHTML;
            
            // Remove previous selection when displaying new results
            selectedPartner = null;
            confirmPartnerBtn.disabled = true;
            discountSection.style.display = 'none';
            
            // Add click listeners to partner items
            document.querySelectorAll('.partner-item').forEach(item => {
                item.addEventListener('click', function() {
                    console.log('Partner clicked:', this.dataset.sifra); // Debug log
                    
                    // Remove previous selection
                    document.querySelectorAll('.partner-item').forEach(p => p.classList.remove('selected'));
                    
                    // Select current item
                    this.classList.add('selected');
                    
                    // Get selected partner data from data attribute
                    try {
                        selectedPartner = JSON.parse(this.dataset.partner);
                        console.log('Selected partner:', selectedPartner); // Debug log
                        
                        // Show discount section and set default discount
                        showDiscountSection();
                        
                        // Enable confirm button
                        confirmPartnerBtn.disabled = false;
                    } catch (error) {
                        console.error('Error parsing partner data:', error);
                        selectedPartner = null;
                        confirmPartnerBtn.disabled = true;
                        discountSection.style.display = 'none';
                    }
                });
            });
        }

        // Show discount section with partner's default discount
        function showDiscountSection() {
            if (!selectedPartner) return;
            
            const partnerRabat = selectedPartner.rabat || '0'; // Koristimo malo slovo 'rabat'
            const defaultDiscount = parseFloat(partnerRabat);
            
            // Set default discount
            partnerDiscountInput.value = defaultDiscount.toFixed(1);
            currentDiscount = defaultDiscount;
            
            // Update info text with calculation example
            const naziv = selectedPartner.Naziv_partnera || selectedPartner.naziv_partnera || 'N/A';
            discountInfo.innerHTML = `
                <i class="fas fa-info-circle"></i> 
                Predloženi rabat za "${naziv}": ${defaultDiscount.toFixed(1)}%
                <br>
                <strong>Formula:</strong> Cena bez PDV - Rabat (${defaultDiscount.toFixed(1)}%) + PDV
                <br>
                <em>Primer: 100€ - ${defaultDiscount.toFixed(1)}% = ${(100 - defaultDiscount).toFixed(1)}€ + 21% PDV = ${((100 - defaultDiscount) * 1.21).toFixed(2)}€</em>
            `;
            
            // Show section
            discountSection.style.display = 'block';
        }

        // Reset discount to partner's default
        resetDiscountBtn.addEventListener('click', function() {
            if (selectedPartner) {
                const partnerRabat = selectedPartner.rabat || '0'; // Koristimo malo slovo 'rabat'
                const defaultDiscount = parseFloat(partnerRabat);
                partnerDiscountInput.value = defaultDiscount.toFixed(1);
                currentDiscount = defaultDiscount;
            }
        });

        // Update current discount when input changes
        partnerDiscountInput.addEventListener('input', function() {
            const newDiscount = parseFloat(this.value) || 0;
            
            // Ensure discount is within valid range
            if (newDiscount < 0) {
                currentDiscount = 0;
                this.value = '0.0';
            } else if (newDiscount > 100) {
                currentDiscount = 100;
                this.value = '100.0';
            } else {
                currentDiscount = newDiscount;
            }
            
            // Update example calculation in real-time
            if (selectedPartner) {
                const naziv = selectedPartner.Naziv_partnera || selectedPartner.naziv_partnera || 'N/A';
                const originalRabat = parseFloat(selectedPartner.rabat || '0'); // Koristimo malo slovo 'rabat'
                const examplePrice = 100;
                const afterDiscount = examplePrice - (examplePrice * currentDiscount / 100);
                const withPDV = afterDiscount * 1.21;
                
                // Show if discount has changed
                const isChanged = currentDiscount !== originalRabat;
                const changeIndicator = isChanged ? 
                    `<span style="color: var(--warning-color); font-weight: bold;"> (PROMENJEN sa ${originalRabat.toFixed(1)}%)</span>` : 
                    '';
                
                discountInfo.innerHTML = `
                    <i class="fas fa-info-circle"></i> 
                    Rabat za "${naziv}": ${currentDiscount.toFixed(1)}%${changeIndicator}
                    <br>
                    <strong>Formula:</strong> Cena bez PDV - Rabat (${currentDiscount.toFixed(1)}%) + PDV
                    <br>
                    <em>Primer: ${examplePrice}€ - ${currentDiscount.toFixed(1)}% = ${afterDiscount.toFixed(2)}€ + 21% PDV = ${withPDV.toFixed(2)}€</em>
                    ${isChanged ? '<br><small style="color: var(--warning-color);">💾 Novi rabat će biti sačuvan za ovog partnera</small>' : ''}
                `;
            }
        });

        // Search partners
        searchPartnersInput.addEventListener('input', function() {
            const term = this.value.toLowerCase().trim();
            console.log('Searching for:', term); // Debug log
            
            if (term === '') {
                // If search is empty, show all partners
                displayPartners(allPartners);
            } else {
                // Filter partners based on search term
                const filteredPartners = allPartners.filter(partner => {
                    // Handle different possible column names (case insensitive)
                    const naziv = (partner.Naziv_partnera || partner.naziv_partnera || '').toString().toLowerCase();
                    const sifra = (partner.Sifra || partner.sifra || '').toString().toLowerCase();
                    const pib = (partner.PIB || partner.pib || '').toString().toLowerCase();
                    const grad = (partner.Grad || partner.grad || '').toString().toLowerCase();
                    const adresa = (partner.Adresa || partner.adresa || '').toString().toLowerCase();
                    const telefon = (partner.Telefon || partner.telefon || '').toString().toLowerCase();
                    const fax = (partner.Fax || partner.fax || '').toString().toLowerCase();
                    const email = (partner.E_mail || partner.e_mail || partner.email || '').toString().toLowerCase();
                    
                    const result = naziv.includes(term) || 
                           sifra.includes(term) || 
                           pib.includes(term) || 
                           grad.includes(term) ||
                           adresa.includes(term) ||
                           telefon.includes(term) ||
                           fax.includes(term) ||
                           email.includes(term);
                    
                    console.log(`Checking partner ${naziv}: ${result}`); // Debug log
                    return result;
                });
                
                console.log('Filtered results:', filteredPartners.length); // Debug log
                displayPartners(filteredPartners);
            }
        });

        // Create otpremnica
        createOtpremnicaBtn.addEventListener('click', function() {
            const checkedBoxes = document.querySelectorAll('.article-checkbox:checked');
            if (checkedBoxes.length === 0) {
                alert('Molimo izaberite artikle za otpremnicu.');
                return;
            }
            
            loadPartners();
            partnerModal.classList.add('show');
        });

        // Close partner modal
        function closeModal() {
            partnerModal.classList.remove('show');
            selectedPartner = null;
            confirmPartnerBtn.disabled = true;
            discountSection.style.display = 'none';
            currentDiscount = 0;
            partnerDiscountInput.value = '';
        }

        closePartnerModal.addEventListener('click', closeModal);
        cancelPartnerBtn.addEventListener('click', closeModal);

        // Confirm partner and generate otpremnica
        confirmPartnerBtn.addEventListener('click', async function() {
            if (!selectedPartner) {
                alert('Molimo izaberite kupca.');
                return;
            }
            
            try {
                // First, update partner's discount in database if it changed
                const originalRabat = parseFloat(selectedPartner.rabat || selectedPartner.Rabat || '0');
                if (currentDiscount !== originalRabat) {
                    await updatePartnerDiscount(selectedPartner.Sifra || selectedPartner.sifra, currentDiscount);
                    console.log(`Updated partner discount from ${originalRabat}% to ${currentDiscount}%`);
                }
                
                // Get selected articles with quantities
                const selectedArticles = [];
                document.querySelectorAll('.article-checkbox:checked').forEach(checkbox => {
                    const row = checkbox.closest('tr');
                    const quantityInput = row.querySelector('.quantity-input');
                    const quantity = parseFloat(quantityInput.value) || 1;
                    
                    selectedArticles.push({
                        id: checkbox.dataset.id,
                        sifra: checkbox.dataset.sifra,
                        naziv: checkbox.dataset.naziv,
                        jm: checkbox.dataset.jm,
                        cenaBeaPdv: parseFloat(checkbox.dataset.cenaBezPdv),
                        cenaSaPdv: parseFloat(checkbox.dataset.cenaSaPdv),
                        rabat: currentDiscount, // Use the manually set discount
                        originalRabat: parseFloat(checkbox.dataset.rabat), // Keep original for reference
                        pdv: parseFloat(checkbox.dataset.pdv),
                        quantity: quantity,
                        maxQty: parseFloat(checkbox.dataset.maxQty)
                    });
                });
                
                // Generate otpremnica number
                const otpremnicaNumber = await generateOtpremnicaNumber();
                
                // Save documents to database
                await saveDocuments(otpremnicaNumber, selectedArticles);
                
                // Update article quantities (allow negative)
                await updateArticleQuantities(selectedArticles);
                
                // Generate print document
                generatePrintDocument(otpremnicaNumber, selectedArticles);
                
                // Print
                window.print();
                
                // Clear selections and close modal
                deselectAllBtn.click();
                closeModal();
                
                alert('Otpremnica je uspešno kreirana i štampana!\nRabat za partnera je ažuriran u bazi podataka.');
                
                // Reload page to refresh quantities
                setTimeout(() => {
                    location.reload();
                }, 1000);
                
            } catch (error) {
                console.error('Error creating otpremnica:', error);
                alert('Greška pri kreiranju otpremnice: ' + error.message);
            }
        });

        // Function to update partner's discount in database
        async function updatePartnerDiscount(partnerSifra, newDiscount) {
            try {
                const response = await fetch(`/partneri/${partnerSifra}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        ...selectedPartner,
                        rabat: newDiscount.toFixed(1) // Koristimo malo slovo 'rabat'
                    })
                });
                
                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.error || 'Failed to update partner discount');
                }
                
                // Update local partner data
                selectedPartner.rabat = newDiscount.toFixed(1);
                
            } catch (error) {
                console.error('Error updating partner discount:', error);
                // Don't throw error - document creation should continue even if discount update fails
                console.warn('Partner discount update failed, but continuing with document creation');
            }
        }

        // Generate otpremnica number
        async function generateOtpremnicaNumber() {
            const today = new Date();
            const year = today.getFullYear();
            const month = String(today.getMonth() + 1).padStart(2, '0');
            
            try {
                const response = await fetch(`/api/dokumenti/count?year=${year}&month=${month}`);
                let count = 1;
                if (response.ok) {
                    const data = await response.json();
                    count = data.count + 1;
                }
                
                return `${String(count).padStart(3, '0')}-${year}${month}`;
            } catch (error) {
                // Fallback to simple numbering
                return `${String(Math.floor(Math.random() * 1000)).padStart(3, '0')}-${year}${month}`;
            }
        }

        // Save documents to database - ONE DOCUMENT with multiple items
        async function saveDocuments(otpremnicaNumber, selectedArticles) {
            const today = new Date().toISOString().split('T')[0];
            
            // Handle different column names for partner name
            const partnerName = selectedPartner.Naziv_partnera || selectedPartner.naziv_partnera || 'N/A';
            
            // Create ONE document entry with ALL selected articles
            let totalIznosBezPdv = 0;
            let totalIznosSaPdv = 0;
            let totalPdvIznos = 0;
            let totalRabat = 0;
            let totalKolicina = 0;
            
            // Calculate totals and create article list using the manual discount
            // Formula: (Cena bez PDV - Rabat) + PDV
            const articlesList = selectedArticles.map(item => {
                const iznosBezPdv = item.cenaBeaPdv * item.quantity;
                const rabatIznos = iznosBezPdv * (currentDiscount / 100);
                const iznosBezPdvSaRabatom = iznosBezPdv - rabatIznos; // Cena posle rabata
                const pdvIznos = iznosBezPdvSaRabatom * (item.pdv / 100); // PDV na cenu sa rabatom
                const iznosSaPdv = iznosBezPdvSaRabatom + pdvIznos; // Finalna cena
                
                totalIznosBezPdv += iznosBezPdvSaRabatom;
                totalIznosSaPdv += iznosSaPdv;
                totalPdvIznos += pdvIznos;
                totalRabat += rabatIznos;
                totalKolicina += item.quantity;
                
                return `${item.sifra} - ${item.naziv} (${item.quantity} ${item.jm})`;
            }).join(', ');
            
            const documentData = {
                datum: today,
                partner: partnerName,
                tip_dokumenta: `Otpremnica ${otpremnicaNumber}`,
                naziv_artikla: articlesList, // All articles in one field
                kolicina: totalKolicina,
                iznos_bez_pdv: totalIznosBezPdv.toFixed(2),
                iznos_sa_pdv: totalIznosSaPdv.toFixed(2),
                pdv_iznos: totalPdvIznos.toFixed(2),
                rabat: totalRabat.toFixed(2)
            };
            
            const response = await fetch('/dokumenti', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(documentData)
            });
            
            if (!response.ok) {
                throw new Error('Failed to save document');
            }
        }

        // Update article quantities (allow negative)
        async function updateArticleQuantities(selectedArticles) {
            for (const item of selectedArticles) {
                // Get current article data
                const response = await fetch(`/artikli/${item.id}`);
                if (response.ok) {
                    const articleData = await response.json();
                    
                    // Update quantity (allow negative)
                    articleData.kolicina = parseFloat(articleData.kolicina) - item.quantity;
                    
                    // Recalculate values using the manual discount
                    // Formula: (Cena bez PDV - Rabat) + PDV
                    const cijena_bez_pdv = parseFloat(articleData.cijena_bez_pdv);
                    const kolicina = articleData.kolicina;
                    const rabat_percent = currentDiscount; // Use manual discount
                    const pdv_stopa = parseFloat(articleData.pdv_stopa);

                    const vrijednost_bez_pdv = cijena_bez_pdv * kolicina;
                    const rabat_iznos = vrijednost_bez_pdv * (rabat_percent / 100);
                    const vrijednost_bez_pdv_sa_rabatom = vrijednost_bez_pdv - rabat_iznos; // Osnovica posle rabata
                    const pdv_iznos = vrijednost_bez_pdv_sa_rabatom * (pdv_stopa / 100); // PDV na osnovicu sa rabatom
                    const cijena_sa_pdv = (cijena_bez_pdv - (cijena_bez_pdv * rabat_percent / 100)) * (1 + pdv_stopa / 100);
                    const vrijednost_sa_pdv = vrijednost_bez_pdv_sa_rabatom + pdv_iznos;

                    articleData.vrijednost_bez_pdv = vrijednost_bez_pdv_sa_rabatom;
                    articleData.pdv_iznos = pdv_iznos;
                    articleData.cijena_sa_pdv = cijena_sa_pdv;
                    articleData.vrijednost_sa_pdv = vrijednost_sa_pdv;
                    
                    // Update in database
                    const updateResponse = await fetch(`/artikli/${item.id}`, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(articleData)
                    });
                    
                    if (!updateResponse.ok) {
                        throw new Error('Failed to update article quantity');
                    }
                }
            }
        }

        // Generate print document
        function generatePrintDocument(otpremnicaNumber, selectedArticles) {
            const today = new Date();
            const formattedDate = `${String(today.getDate()).padStart(2, '0')}.${String(today.getMonth() + 1).padStart(2, '0')}.${today.getFullYear()}`;
            
            // Fill header data - handle different column names
            const sifra = selectedPartner.Sifra || selectedPartner.sifra || '';
            const naziv = selectedPartner.Naziv_partnera || selectedPartner.naziv_partnera || '';
            const pib = selectedPartner.PIB || selectedPartner.pib || '';
            const pdv = selectedPartner.PDV || selectedPartner.pdv || '';
            const adresa = selectedPartner.Adresa || selectedPartner.adresa || '';
            const grad = selectedPartner.Grad || selectedPartner.grad || '';
            
            document.getElementById('print-date').textContent = formattedDate;
            document.getElementById('print-doc-number').textContent = otpremnicaNumber;
            document.getElementById('print-customer-code').textContent = sifra;
            document.getElementById('print-customer-name').textContent = naziv;
            document.getElementById('print-customer-pib').textContent = pib;
            document.getElementById('print-customer-pdv').textContent = pdv;
            document.getElementById('print-customer-address').textContent = adresa;
            document.getElementById('print-customer-city').textContent = grad;
            
            // Fill items table using the manual discount
            // Formula: (Cena bez PDV - Rabat) + PDV
            let itemsHTML = '';
            let totalBezPdv = 0;
            let totalRabat = 0;
            let totalPdv = 0;
            let totalSaPdv = 0;
            
            selectedArticles.forEach((item, index) => {
                const vrijednostBeaPdv = item.cenaBeaPdv * item.quantity; // Ukupno bez PDV
                const rabatIznos = vrijednostBeaPdv * (currentDiscount / 100); // Iznos rabata
                const vrijednostBeaPdvSaRabatom = vrijednostBeaPdv - rabatIznos; // Osnovica posle rabata
                const pdvIznos = vrijednostBeaPdvSaRabatom * (item.pdv / 100); // PDV na osnovicu sa rabatom
                const cenaSaPdvSaRabatom = (item.cenaBeaPdv - (item.cenaBeaPdv * currentDiscount / 100)) * (1 + item.pdv / 100); // Jedinična cena sa rabatom i PDV
                const vrijednostSaPdv = vrijednostBeaPdvSaRabatom + pdvIznos; // Konačna vrednost
                
                totalBezPdv += vrijednostBeaPdvSaRabatom;
                totalRabat += rabatIznos;
                totalPdv += pdvIznos;
                totalSaPdv += vrijednostSaPdv;
                
                itemsHTML += `
                    <tr>
                        <td>${index + 1}</td>
                        <td>${item.sifra}</td>
                        <td class="text-left">${item.naziv}</td>
                        <td>${item.jm}</td>
                        <td>${item.quantity}</td>
                        <td class="text-right">${item.cenaBeaPdv.toFixed(3)}</td>
                        <td class="text-right">${vrijednostBeaPdv.toFixed(2)}</td>
                        <td class="text-right">${currentDiscount.toFixed(1)}%</td>
                        <td class="text-right">${item.pdv.toFixed(0)}%</td>
                        <td class="text-right">${pdvIznos.toFixed(2)}</td>
                        <td class="text-right">${cenaSaPdvSaRabatom.toFixed(3)}</td>
                        <td class="text-right">${vrijednostSaPdv.toFixed(2)}</td>
                    </tr>
                `;
            });
            
            document.getElementById('print-items-tbody').innerHTML = itemsHTML;
            
            // Fill totals - show original values first, then discounted values
            const totalVrijednostBezPdvOriginal = selectedArticles.reduce((sum, item) => sum + (item.cenaBeaPdv * item.quantity), 0);
            
            document.getElementById('print-total-bez-pdv').textContent = totalVrijednostBezPdvOriginal.toFixed(2); // Original 150€
            document.getElementById('print-total-rabat').textContent = totalRabat.toFixed(2); // Discount 15€  
            document.getElementById('print-osnovica').textContent = totalBezPdv.toFixed(2); // After discount 135€
            document.getElementById('print-pdv-iznos').textContent = totalPdv.toFixed(2); // PDV on 135€
            document.getElementById('print-total-sa-pdv').textContent = totalSaPdv.toFixed(2); // Final total
        }

        // Search functionality
        searchInput.addEventListener('input', function() {
            const term = this.value.toLowerCase();
            const rows = document.querySelectorAll('#articles-tbody tr');
            
            rows.forEach(row => {
                if (row.cells.length > 1) {
                    const sifra = row.cells[2].textContent.toLowerCase();
                    const naziv = row.cells[3].textContent.toLowerCase();
                    
                    if (sifra.includes(term) || naziv.includes(term)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                }
            });
        });

        // Close modals on click outside
        partnerModal.addEventListener('click', (e) => {
            if (e.target === partnerModal) {
                closeModal();
            }
        });

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            attachCheckboxListeners();
            
            // Auto collapse sidebar on medium screens on load
            if (window.innerWidth <= 992 && window.innerWidth > 576) {
                sidebar.classList.add('collapsed');
                mainContent.classList.add('expanded');
                header.classList.add('expanded');
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            }
            
            console.log('Tehnolux Otpremnica with manual discount initialized');
        });

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            
            // Ctrl+F to focus search
            if (e.ctrlKey && e.key === 'f') {
                e.preventDefault();
                searchInput.focus();
            }
            
            // Ctrl+A to select all
            if (e.ctrlKey && e.key === 'a') {
                e.preventDefault();
                selectAllBtn.click();
            }
            
            // Escape to close modal
            if (e.key === 'Escape') {
                if (partnerModal.classList.contains('show')) {
                    closeModal();
                }
            }
        });
    </script>
</body>
</html>