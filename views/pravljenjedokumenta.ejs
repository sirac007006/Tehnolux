    <script>
        // GLOBALNE VARIJABLE
        let currentStep = 1;
        let selectedDocumentType = null;
        let selectedMagacin = null;
        let selectedKomercijalist = null;
        let selectedPartner = null;
        let selectedArtikli = [];
        let createdDocumentData = null;
        let artikalRabatCache = {};

        // DOM elementi
        const sidebar = document.getElementById('sidebar');
        const sidebarOverlay = document.getElementById('sidebar-overlay');
        const mainContent = document.getElementById('main-content');
        const header = document.getElementById('header');
        const toggleSidebar = document.getElementById('toggle-sidebar');
        const sidebarIcon = document.getElementById('sidebar-icon');
        const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
        
        const createDocumentBtn = document.getElementById('create-document-btn');
        const createDocumentModal = document.getElementById('create-document-modal');
        const closeDocumentModal = document.getElementById('close-document-modal');
        const refreshBtn = document.getElementById('refresh-btn');
        const printDocument = document.getElementById('print-document');

        document.addEventListener('DOMContentLoaded', function() {
            attachEventListeners();
            initializeFilters();
        });

        // Function to close mobile sidebar
        function closeMobileSidebar() {
            if (window.innerWidth <= 576) {
                sidebar.classList.remove('mobile-open');
                sidebarOverlay.classList.remove('show');
                document.body.style.overflow = '';
            }
        }

        // Mobile menu functionality
        mobileMenuToggle.addEventListener('click', function() {
            sidebar.classList.toggle('mobile-open');
            sidebarOverlay.classList.toggle('show');
            
            if (sidebar.classList.contains('mobile-open')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = '';
            }
        });

        // Close mobile menu when clicking overlay
        sidebarOverlay.addEventListener('click', function() {
            closeMobileSidebar();
        });

        // TOGGLE SIDEBAR
        toggleSidebar.addEventListener('click', function() {
            sidebar.classList.toggle('collapsed');
            mainContent.classList.toggle('expanded');
            header.classList.toggle('expanded');
            
            if (sidebar.classList.contains('collapsed')) {
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            } else {
                sidebarIcon.classList.remove('fa-chevron-right');
                sidebarIcon.classList.add('fa-chevron-left');
            }
        });

        // Submenu functionality
        document.querySelectorAll('.nav-item.has-submenu > .nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const parent = this.parentElement;
                const submenu = parent.querySelector('.submenu');
                
                document.querySelectorAll('.nav-item.has-submenu').forEach(item => {
                    if (item !== parent) {
                        item.classList.remove('open');
                        item.querySelector('.submenu').classList.remove('open');
                    }
                });
                
                parent.classList.toggle('open');
                submenu.classList.toggle('open');
            });
        });

        // Navigation - close sidebar on submenu link click
        document.querySelectorAll('.submenu .nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                closeMobileSidebar();
            });
        });

        createDocumentBtn.addEventListener('click', function() {
            resetModal();
            createDocumentModal.classList.add('show');
        });

        function closeModal() {
            createDocumentModal.classList.remove('show');
            resetModal();
        }

        closeDocumentModal.addEventListener('click', closeModal);

        function resetModal() {
            currentStep = 1;
            selectedDocumentType = null;
            selectedMagacin = null;
            selectedKomercijalist = null;
            selectedPartner = null;
            selectedArtikli = [];
            artikalRabatCache = {};
            createdDocumentData = null;

            document.querySelectorAll('.step').forEach(step => {
                step.classList.remove('active', 'completed');
            });
            document.getElementById('step-1').classList.add('active');

            document.querySelectorAll('.modal-step').forEach(step => {
                step.classList.remove('active');
            });
            document.getElementById('modal-step-1').classList.add('active');

            document.querySelectorAll('.document-type').forEach(type => {
                type.classList.remove('selected');
            });
            document.querySelectorAll('.komercijalist-item').forEach(item => {
                item.classList.remove('selected');
            });
            document.querySelectorAll('.partner-item').forEach(item => {
                item.classList.remove('selected');
            });
            document.querySelectorAll('.artikal-checkbox').forEach(checkbox => {
                checkbox.checked = false;
                const row = checkbox.closest('tr');
                row.classList.remove('selected');
                const quantityInput = row.querySelector('.kolicina-input');
                const rabatInput = row.querySelector('.rabat-input');
                quantityInput.disabled = true;
                rabatInput.disabled = true;
                quantityInput.value = 1;
                rabatInput.value = 0;
                
                row.querySelector('.total-bez-pdv').textContent = '0.00';
                row.querySelector('.total-sa-pdv').textContent = '0.00';
            });

            document.getElementById('next-step-1').disabled = true;
            document.getElementById('next-step-2').disabled = true;
            document.getElementById('next-step-3').disabled = true;
            document.getElementById('next-step-4').disabled = true;
            document.getElementById('selected-count').style.display = 'none';
        }

        function goToStep(stepNumber) {
            if (stepNumber < 1 || stepNumber > 7) return;

            document.querySelectorAll('.step').forEach((step, index) => {
                step.classList.remove('active');
                if (index + 1 < stepNumber) {
                    step.classList.add('completed');
                } else {
                    step.classList.remove('completed');
                }
            });
            document.getElementById(`step-${stepNumber}`).classList.add('active');

            document.querySelectorAll('.modal-step').forEach(step => {
                step.classList.remove('active');
            });
            document.getElementById(`modal-step-${stepNumber}`).classList.add('active');

            currentStep = stepNumber;

            if (stepNumber === 5 && selectedPartner) {
                loadPartnerRabati();
            }

            if (stepNumber === 6) {
                updateReviewSection();
                updateArticlesReviewTable();
            }
        }

        async function loadPartnerRabati() {
            if (!selectedPartner || !selectedPartner.Sifra) return;
            
            try {
                const response = await fetch(`/api/rabat/partner/${selectedPartner.Sifra}`);
                const data = await response.json();
                
                if (data.success) {
                    artikalRabatCache = {};
                    data.rabati.forEach(r => {
                        artikalRabatCache[r.artikal_sifra] = parseFloat(r.rabat);
                    });
                    
                    console.log(`Loaded ${data.rabati.length} saved rabats for partner ${selectedPartner.Sifra}`);
                }
            } catch (error) {
                console.error('Error loading partner rabati:', error);
            }
        }

        async function getRabatForArtikal(artikalSifra) {
            if (!selectedPartner || !selectedPartner.Sifra) return 0;
            
            if (artikalRabatCache.hasOwnProperty(artikalSifra)) {
                return artikalRabatCache[artikalSifra];
            }
            
            try {
                const response = await fetch(`/api/rabat/${selectedPartner.Sifra}/${artikalSifra}`);
                const data = await response.json();
                
                if (data.success) {
                    const rabat = parseFloat(data.rabat) || 0;
                    artikalRabatCache[artikalSifra] = rabat;
                    return rabat;
                }
            } catch (error) {
                console.error('Error fetching rabat:', error);
            }
            
            return 0;
        }

        async function saveRabatForArtikal(artikalSifra, rabat) {
            if (!selectedPartner || !selectedPartner.Sifra) return;
            
            try {
                const response = await fetch('/api/rabat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        partnerSifra: selectedPartner.Sifra,
                        artikalSifra: artikalSifra,
                        rabat: rabat
                    })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    artikalRabatCache[artikalSifra] = parseFloat(rabat);
                    console.log(`Saved rabat ${rabat}% for partner ${selectedPartner.Sifra}, artikal ${artikalSifra}`);
                }
            } catch (error) {
                console.error('Error saving rabat:', error);
            }
        }

        function attachEventListeners() {
            // Step 1
            document.querySelectorAll('.document-type[data-type]').forEach(type => {
                type.addEventListener('click', function() {
                    document.querySelectorAll('.document-type[data-type]').forEach(t => t.classList.remove('selected'));
                    this.classList.add('selected');
                    selectedDocumentType = this.dataset.type;
                    document.getElementById('next-step-1').disabled = false;
                });
            });

            document.getElementById('next-step-1').addEventListener('click', () => goToStep(2));
            document.getElementById('cancel-step-1').addEventListener('click', closeModal);

            // Step 2
            document.querySelectorAll('.document-type[data-magacin]').forEach(mag => {
                mag.addEventListener('click', function() {
                    document.querySelectorAll('.document-type[data-magacin]').forEach(m => m.classList.remove('selected'));
                    this.classList.add('selected');
                    selectedMagacin = this.dataset.magacin;
                    document.getElementById('next-step-2').disabled = false;
                });
            });

            document.getElementById('prev-step-2').addEventListener('click', () => goToStep(1));
            document.getElementById('next-step-2').addEventListener('click', () => goToStep(3));
            document.getElementById('cancel-step-2').addEventListener('click', closeModal);

            // Step 3 - Partner selection
            document.querySelectorAll('.partner-item').forEach(item => {
                item.addEventListener('click', function() {
                    document.querySelectorAll('.partner-item').forEach(i => i.classList.remove('selected'));
                    this.classList.add('selected');
                    selectedPartner = JSON.parse(this.dataset.partner);
                    artikalRabatCache = {};
                    document.getElementById('next-step-3').disabled = false;
                });
            });

            document.getElementById('prev-step-3').addEventListener('click', () => goToStep(2));
            document.getElementById('next-step-3').addEventListener('click', () => goToStep(4));
            document.getElementById('cancel-step-3').addEventListener('click', closeModal);

            // Step 4
            document.querySelectorAll('.komercijalist-item').forEach(item => {
                item.addEventListener('click', function() {
                    document.querySelectorAll('.komercijalist-item').forEach(i => i.classList.remove('selected'));
                    this.classList.add('selected');
                    selectedKomercijalist = JSON.parse(this.dataset.komercijalist);
                    document.getElementById('next-step-4').disabled = false;
                });
            });

            document.getElementById('prev-step-4').addEventListener('click', () => goToStep(3));
            document.getElementById('next-step-4').addEventListener('click', () => goToStep(5));
            document.getElementById('cancel-step-4').addEventListener('click', closeModal);

            // Step 5 - Artikli selection
            document.querySelectorAll('.artikal-checkbox').forEach(checkbox => {
                checkbox.addEventListener('change', async function() {
                    const row = this.closest('tr');
                    const quantityInput = row.querySelector('.kolicina-input');
                    const rabatInput = row.querySelector('.rabat-input');
                    const artikalSifra = this.dataset.sifra;
                    
                    if (this.checked) {
                        row.classList.add('selected');
                        quantityInput.disabled = false;
                        rabatInput.disabled = false;
                        quantityInput.focus();
                        
                        const savedRabat = await getRabatForArtikal(artikalSifra);
                        rabatInput.value = savedRabat.toFixed(1);
                        
                        console.log(`Loaded rabat for ${artikalSifra}: ${savedRabat}%`);
                    } else {
                        row.classList.remove('selected');
                        quantityInput.disabled = true;
                        rabatInput.disabled = true;
                        quantityInput.value = 1;
                        rabatInput.value = 0;
                        
                        row.querySelector('.total-bez-pdv').textContent = '0.00';
                        row.querySelector('.total-sa-pdv').textContent = '0.00';
                    }
                    
                    updateArticleTotals(row);
                    updateSelectedArtikli();
                });
            });

            document.querySelectorAll('.rabat-input').forEach(input => {
                input.addEventListener('blur', async function() {
                    const row = this.closest('tr');
                    const checkbox = row.querySelector('.artikal-checkbox');
                    
                    if (checkbox.checked) {
                        const artikalSifra = checkbox.dataset.sifra;
                        const rabat = parseFloat(this.value) || 0;
                        await saveRabatForArtikal(artikalSifra, rabat);
                    }
                });
            });

            document.querySelectorAll('.kolicina-input, .rabat-input').forEach(input => {
                input.addEventListener('input', function() {
                    const row = this.closest('tr');
                    updateArticleTotals(row);
                    updateSelectedArtikli();
                });
            });

            document.getElementById('select-all-artikli').addEventListener('click', async function() {
                for (const checkbox of document.querySelectorAll('.artikal-checkbox')) {
                    checkbox.checked = true;
                    const row = checkbox.closest('tr');
                    const quantityInput = row.querySelector('.kolicina-input');
                    const rabatInput = row.querySelector('.rabat-input');
                    const artikalSifra = checkbox.dataset.sifra;
                    
                    row.classList.add('selected');
                    quantityInput.disabled = false;
                    rabatInput.disabled = false;
                    
                    const savedRabat = await getRabatForArtikal(artikalSifra);
                    rabatInput.value = savedRabat.toFixed(1);
                    
                    updateArticleTotals(row);
                }
                updateSelectedArtikli();
            });

            document.getElementById('deselect-all-artikli').addEventListener('click', function() {
                document.querySelectorAll('.artikal-checkbox').forEach(checkbox => {
                    checkbox.checked = false;
                    const row = checkbox.closest('tr');
                    const quantityInput = row.querySelector('.kolicina-input');
                    const rabatInput = row.querySelector('.rabat-input');
                    row.classList.remove('selected');
                    quantityInput.disabled = true;
                    rabatInput.disabled = true;
                    quantityInput.value = 1;
                    rabatInput.value = 0;
                    
                    row.querySelector('.total-bez-pdv').textContent = '0.00';
                    row.querySelector('.total-sa-pdv').textContent = '0.00';
                });
                updateSelectedArtikli();
            });

            document.getElementById('prev-step-5').addEventListener('click', () => goToStep(4));
            document.getElementById('next-step-5').addEventListener('click', () => goToStep(6));
            document.getElementById('cancel-step-5').addEventListener('click', closeModal);

            // Step 6
            document.getElementById('prev-step-6').addEventListener('click', () => goToStep(5));
            document.getElementById('cancel-step-6').addEventListener('click', closeModal);
            document.getElementById('create-document-final').addEventListener('click', createDocument);

            // Step 7
            document.getElementById('close-without-print').addEventListener('click', closeModal);
            document.getElementById('preview-print').addEventListener('click', previewPrint);
            document.getElementById('print-document').addEventListener('click', printCreatedDocument);

            // Search
            document.getElementById('search-komercijalisti').addEventListener('input', searchKomercijalisti);
            document.getElementById('search-partners').addEventListener('input', searchPartners);
            document.getElementById('search-artikli').addEventListener('input', searchArtikli);

            document.getElementById('search-documents').addEventListener('input', filterDocuments);
            document.getElementById('filter-document-type').addEventListener('change', filterDocuments);
            document.getElementById('filter-date-from').addEventListener('change', filterDocuments);
            document.getElementById('filter-date-to').addEventListener('change', filterDocuments);

            refreshBtn.addEventListener('click', function() {
                location.reload();
            });
        }

        // ISPRAVLJENA FUNKCIJA - čuva ORIGINALNU cenu, primenjuje rabat samo na kalkulaciju
        function updateArticleTotals(row) {
            const checkbox = row.querySelector('.artikal-checkbox');
            if (!checkbox.checked) return;

            const quantity = parseFloat(row.querySelector('.kolicina-input').value) || 0;
            const rabat = parseFloat(row.querySelector('.rabat-input').value) || 0;
            
            // ORIGINALNE CENE iz lagera (BEZ primenjenog rabata)
            const cenaBezPdv = parseFloat(checkbox.dataset.cenaBezPdv) || 0;
            const cenaSaPdv = parseFloat(checkbox.dataset.cenaSaPdv) || 0;
            
            // Ukupno BEZ rabata
            const iznosBezPdvBefore = cenaBezPdv * quantity;
            const iznosSaPdvBefore = cenaSaPdv * quantity;
            
            // Primeni rabat na ukupne iznose
            const rabatIznosBezPdv = iznosBezPdvBefore * (rabat / 100);
            const rabatIznosSaPdv = iznosSaPdvBefore * (rabat / 100);
            
            // Konačni iznosi SA rabatom
            const totalBezPdv = iznosBezPdvBefore - rabatIznosBezPdv;
            const totalSaPdv = iznosSaPdvBefore - rabatIznosSaPdv;

            row.querySelector('.total-bez-pdv').textContent = totalBezPdv.toFixed(2);
            row.querySelector('.total-sa-pdv').textContent = totalSaPdv.toFixed(2);
        }

        function updateSelectedArtikli() {
            selectedArtikli = [];
            const selectedCount = document.querySelectorAll('.artikal-checkbox:checked').length;
            
            document.querySelectorAll('.artikal-checkbox:checked').forEach(checkbox => {
                const row = checkbox.closest('tr');
                const quantityInput = row.querySelector('.kolicina-input');
                const rabatInput = row.querySelector('.rabat-input');
                const quantity = parseFloat(quantityInput.value) || 1;
                const rabat = parseFloat(rabatInput.value) || 0;
                
                // Čuvaj ORIGINALNE cene
                const cenaBezPdv = parseFloat(checkbox.dataset.cenaBezPdv);
                const cenaSaPdv = parseFloat(checkbox.dataset.cenaSaPdv);
                
                selectedArtikli.push({
                    sifra: checkbox.dataset.sifra,
                    naziv: checkbox.dataset.naziv,
                    jm: checkbox.dataset.jm || 'kom',
                    dostupnaKolicina: parseFloat(checkbox.dataset.kolicina),
                    kolicina: quantity,
                    cena_bez_pdv: cenaBezPdv,  // ORIGINALNA CENA
                    cena_sa_pdv: cenaSaPdv,    // ORIGINALNA CENA
                    rabat: rabat
                });
            });

            if (selectedCount > 0) {
                document.getElementById('selected-count').style.display = 'block';
                document.getElementById('selected-items-count').textContent = selectedCount;
                document.getElementById('next-step-5').disabled = false;
            } else {
                document.getElementById('selected-count').style.display = 'none';
                document.getElementById('next-step-5').disabled = true;
            }
        }

        // ISPRAVLJENA FUNKCIJA - tačna računica za pregled
        function updateReviewSection() {
            document.getElementById('review-doc-type').textContent = selectedDocumentType.toUpperCase();
            document.getElementById('review-komercijalist').textContent = selectedKomercijalist.ime_prezime;
            document.getElementById('review-partner').textContent = selectedPartner.Naziv_partnera || selectedPartner.naziv_partnera;
            document.getElementById('review-artikli-count').textContent = selectedArtikli.length;

            let totalKolicina = 0;
            let totalIznosBezPdv = 0;
            let totalPdvIznos = 0;
            let totalIznosSaPdv = 0;
            let sumaRabata = 0;

            selectedArtikli.forEach(artikal => {
                const kolicina = parseFloat(artikal.kolicina) || 0;
                const cenaBezPdv = parseFloat(artikal.cena_bez_pdv) || 0;  // ORIGINALNA
                const cenaSaPdv = parseFloat(artikal.cena_sa_pdv) || 0;    // ORIGINALNA
                const rabat = parseFloat(artikal.rabat) || 0;

                sumaRabata += rabat;

                // Ukupno BEZ rabata
                const iznosBezPdvBefore = cenaBezPdv * kolicina;
                const iznosSaPdvBefore = cenaSaPdv * kolicina;
                
                // Primeni rabat
                const rabatAmount = iznosBezPdvBefore * (rabat / 100);
                const rabatAmountSaPdv = iznosSaPdvBefore * (rabat / 100);
                
                // Konačni iznosi
                const iznosBezPdv = iznosBezPdvBefore - rabatAmount;
                const iznosSaPdv = iznosSaPdvBefore - rabatAmountSaPdv;
                const pdvIznos = iznosSaPdv - iznosBezPdv;

                totalKolicina += kolicina;
                totalIznosBezPdv += iznosBezPdv;
                totalPdvIznos += pdvIznos;
                totalIznosSaPdv += iznosSaPdv;
            });

            const prosecniRabat = selectedArtikli.length > 0 ? sumaRabata / selectedArtikli.length : 0;

            document.getElementById('review-total-kolicina').textContent = totalKolicina.toFixed(2);
            document.getElementById('review-iznos-bez-pdv').textContent = totalIznosBezPdv.toFixed(2) + ' €';
            document.getElementById('review-globalni-rabat').textContent = prosecniRabat.toFixed(1) + '% (prosek)';
            document.getElementById('review-pdv').textContent = totalPdvIznos.toFixed(2) + ' €';
            document.getElementById('review-iznos-sa-pdv').textContent = totalIznosSaPdv.toFixed(2) + ' €';
        }

        // ISPRAVLJENA FUNKCIJA - tačna tabela za pregled
        function updateArticlesReviewTable() {
            const tbody = document.getElementById('review-articles-tbody');
            tbody.innerHTML = '';

            selectedArtikli.forEach((artikal, index) => {
                const kolicina = parseFloat(artikal.kolicina) || 0;
                const cenaBezPdv = parseFloat(artikal.cena_bez_pdv) || 0;  // ORIGINALNA
                const cenaSaPdv = parseFloat(artikal.cena_sa_pdv) || 0;    // ORIGINALNA
                const rabat = parseFloat(artikal.rabat) || 0;

                // Ukupno BEZ rabata
                const iznosBezPdvBefore = cenaBezPdv * kolicina;
                const iznosSaPdvBefore = cenaSaPdv * kolicina;
                
                // Primeni rabat
                const rabatAmount = iznosBezPdvBefore * (rabat / 100);
                const rabatAmountSaPdv = iznosSaPdvBefore * (rabat / 100);
                
                // Konačni iznosi
                const iznosBezPdv = iznosBezPdvBefore - rabatAmount;
                const iznosSaPdv = iznosSaPdvBefore - rabatAmountSaPdv;
                const pdvAmount = iznosSaPdv - iznosBezPdv;

                const row = `
                    <tr>
                        <td class="text-center">${index + 1}</td>
                        <td>${artikal.sifra}</td>
                        <td>${artikal.naziv}</td>
                        <td class="text-center">${artikal.jm}</td>
                        <td class="text-center">${kolicina.toFixed(2)}</td>
                        <td class="text-right">${cenaBezPdv.toFixed(2)} €</td>
                        <td class="text-right">${rabat.toFixed(1)}%</td>
                        <td class="text-right">${iznosBezPdv.toFixed(2)} €</td>
                        <td class="text-right">21%</td>
                        <td class="text-right">${pdvAmount.toFixed(2)} €</td>
                        <td class="text-right"><strong>${iznosSaPdv.toFixed(2)} €</strong></td>
                    </tr>
                `;
                tbody.innerHTML += row;
            });
        }


async function createDocument() {
    const createBtn = document.getElementById('create-document-final');
    createBtn.disabled = true;
    createBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Kreira se...';

    try {
        const totals = calculateTotals();

        const partnerIdent = selectedPartner?.Sifra ?? selectedPartner?.sifra ?? selectedPartner?.id ?? null;
        const komercijalistIdent = selectedKomercijalist?.id ?? selectedKomercijalist?.ID ?? null;

        // Uzimanje vrednosti iz textarea za napomenu
        const napomena = document.getElementById('document-napomena').value.trim();

        const documentData = {
            datum: new Date().toISOString(),
            tipDokumenta: selectedDocumentType,
            magacin: selectedMagacin,
            partner: partnerIdent,
            komercijalist_id: komercijalistIdent,
            artikli: Array.isArray(selectedArtikli) ? selectedArtikli : [],
            ukupanIznos: totals.iznosSaPdv,
            ukupnoBezPdv: totals.iznosBezPdv,
            ukupnoSaPdv: totals.iznosSaPdv,
            ukupanPdv: totals.pdvIznos,
            napomena: napomena
        };

        const missing = [];
        if (!documentData.tipDokumenta) missing.push('tip dokumenta');
        if (!documentData.partner) missing.push('partner');
        if (!documentData.komercijalist_id) missing.push('komercijalist');
        if (!documentData.artikli || documentData.artikli.length === 0) missing.push('artikli');
        if (!documentData.magacin) missing.push('magacin');

        if (missing.length > 0) {
            alert('Nedostaju sledeća polja: ' + missing.join(', '));
            createBtn.disabled = false;
            createBtn.innerHTML = '<i class="fas fa-save"></i> Kreiraj dokument';
            return;
        }

        const response = await fetch('/api/pravljenjedokumenta', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(documentData)
        });

        if (!response.ok) {
            const contentType = response.headers.get('content-type') || '';
            let errText;
            if (contentType.includes('application/json')) {
                const j = await response.json();
                errText = j.error || JSON.stringify(j);
            } else {
                errText = await response.text();
            }
            throw new Error(errText);
        }

        const result = await response.json();
        
        const fullDocumentNumber = result.fullDocumentNumber;

        createdDocumentData = {
            ...documentData,
            documentNumber: fullDocumentNumber,
            id: result.id || result.documentId,
            napomena: result.napomena
        };

        const displayDocNumber = fullDocumentNumber.replace(/(ponuda|predracun|otpremnica|kalkulacija)/, '');
        document.getElementById('created-doc-number').textContent = displayDocNumber;
        
        goToStep(7);

    } catch (error) {
        console.error('Error creating document:', error);
        alert('Greška pri kreiranju dokumenta: ' + error.message);
    } finally {
        createBtn.disabled = false;
        createBtn.innerHTML = '<i class="fas fa-save"></i> Kreiraj dokument';
    }
}


function calculateTotals() {
    let totalBezPdv = 0;
    let totalPdv = 0;
    let totalSaPdv = 0;

    selectedArtikli.forEach(artikal => {
        const kolicina = parseFloat(artikal.kolicina) || 0;
        const cenaBezPdv = parseFloat(artikal.cena_bez_pdv) || 0;  // ORIGINALNA
        const cenaSaPdv = parseFloat(artikal.cena_sa_pdv) || 0;    // ORIGINALNA
        const rabat = parseFloat(artikal.rabat) || 0;

        // Ukupno BEZ rabata
        const iznosBezPdvBefore = cenaBezPdv * kolicina;
        const iznosSaPdvBefore = cenaSaPdv * kolicina;
        
        // Primeni rabat
        const rabatAmount = iznosBezPdvBefore * (rabat / 100);
        const rabatAmountSaPdv = iznosSaPdvBefore * (rabat / 100);
        
        // Konačni iznosi
        const iznosBezPdv = iznosBezPdvBefore - rabatAmount;
        const iznosSaPdv = iznosSaPdvBefore - rabatAmountSaPdv;
        const pdvAmount = iznosSaPdv - iznosBezPdv;

        totalBezPdv += iznosBezPdv;
        totalPdv += pdvAmount;
        totalSaPdv += iznosSaPdv;
    });

    return {
        iznosBezPdv: totalBezPdv,
        pdvIznos: totalPdv,
        iznosSaPdv: totalSaPdv
    };
}

        function getDocumentTypeForPrint(tipDokumenta) {
            const tip = tipDokumenta.toLowerCase();
            if (tip.includes('otpremnica')) return 'Otpremnica';
            if (tip.includes('predracun')) return 'Predračun';
            if (tip.includes('kalkulacija')) return 'Kalkulacija';
            if (tip.includes('ponuda')) return 'Ponuda';
            return 'Dokument';
        }

        function getSignatureText(tipDokumenta) {
            const tip = tipDokumenta.toLowerCase();
            if (tip.includes('otpremnica')) return 'Otpremio,';
            if (tip.includes('predracun')) return 'Izradio,';
            if (tip.includes('kalkulacija')) return 'Kalkulisao,';
            if (tip.includes('ponuda')) return 'Ponudio,';
            return 'Izdao,';
        }

        function getDisclaimerText(tipDokumenta) {
            const tip = tipDokumenta.toLowerCase();
            if (tip.includes('otpremnica')) return 'OVO NIJE PDV RAČUN!!!';
            if (tip.includes('predracun')) return 'OVO NIJE PDV RAČUN - PREDRAČUN!!!';
            if (tip.includes('kalkulacija')) return 'KALKULACIJA - OVO NIJE PDV RAČUN!!!';
            if (tip.includes('ponuda')) return 'PONUDA - OVO NIJE OBAVEZUJUĆI DOKUMENT!!!';
            return 'OVO NIJE PDV RAČUN!!!';
        }




async function generatePrintDocumentFromCreatedData() {
    if (!createdDocumentData) return;

    const today = new Date();
    const formattedDate = `${String(today.getDate()).padStart(2, '0')}.${String(today.getMonth() + 1).padStart(2, '0')}.${today.getFullYear()}`;
    
    const documentType = getDocumentTypeForPrint(createdDocumentData.tipDokumenta);
    
    document.getElementById('print-date').textContent = formattedDate;
    document.getElementById('print-document-type').textContent = documentType;
    
    const printDocNumber = (createdDocumentData.documentNumber || '').replace(/(ponuda|predracun|otpremnica|kalkulacija)/, '');
    document.getElementById('print-doc-number').textContent = printDocNumber;
    
    // Populate the komercijalist field
    if (selectedKomercijalist) {
        document.getElementById('print-komercijalist').textContent = selectedKomercijalist.ime_prezime;
    }
    
    if (selectedPartner) {
        const sifra = selectedPartner.Sifra || selectedPartner.sifra || '';
        const naziv = selectedPartner.Naziv_partnera || selectedPartner.naziv_partnera || '';
        const pib = selectedPartner.PIB || selectedPartner.pib || '';
        const pdv = selectedPartner.PDV || selectedPartner.pdv || '';
        const adresa = selectedPartner.Adresa || selectedPartner.adresa || '';
        const grad = selectedPartner.Grad || selectedPartner.grad || '';
        
        document.getElementById('print-customer-code').textContent = sifra;
        document.getElementById('print-customer-name').textContent = naziv;
        document.getElementById('print-customer-pib').textContent = pib;
        document.getElementById('print-customer-pdv').textContent = pdv;
        document.getElementById('print-customer-address').textContent = adresa;
        document.getElementById('print-customer-city').textContent = grad;
    }
    
    // Prikaz napomene ako postoji
    const napomenaContainer = document.getElementById('print-napomena-container');
    const napomenaText = document.getElementById('print-napomena-text');
    
    if (createdDocumentData.napomena && createdDocumentData.napomena.trim() !== '') {
        napomenaText.textContent = createdDocumentData.napomena;
        napomenaContainer.style.display = 'block';
    } else {
        napomenaContainer.style.display = 'none';
    }
    
    let itemsHTML = '';
    let totalBezPdvBefore = 0;
    let totalRabat = 0;
    let totalBezPdv = 0;
    let totalPdv = 0;
    let totalSaPdv = 0;

    selectedArtikli.forEach((item, index) => {
        const kolicina = parseFloat(item.kolicina) || 0;
        const cenaBezPdv = parseFloat(item.cena_bez_pdv) || 0;
        const rabat = parseFloat(item.rabat) || 0;
        const pdvStopa = 21;
        
        // Vrednosti BEZ rabata
        const vrijednostBezPdv = cenaBezPdv * kolicina;
        
        // Rabat iznosi
        const rabatIznos = vrijednostBezPdv * (rabat / 100);
        
        // Konačne vrednosti
        const iznosBezPdv = vrijednostBezPdv - rabatIznos;
        const pdvIznos = iznosBezPdv * (pdvStopa / 100);
        const iznosSaPdv = iznosBezPdv + pdvIznos;
        
        // CIJENA SA PDV PO JEDINICI
        const cenaBezPdvNakonRabata = cenaBezPdv * (1 - rabat / 100);
        const cenaSaPdvPoJedinici = cenaBezPdvNakonRabata * (1 + pdvStopa / 100);

        totalBezPdvBefore += vrijednostBezPdv;
        totalRabat += rabatIznos;
        totalBezPdv += iznosBezPdv;
        totalPdv += pdvIznos;
        totalSaPdv += iznosSaPdv;

        itemsHTML += `
            <tr>
                <td>${index + 1}</td>
                <td>${item.sifra}</td>
                <td class="text-left">${item.naziv}</td>
                <td>${item.jm}</td>
                <td>${kolicina.toFixed(2)}</td>
                <td class="text-right">${cenaBezPdv.toFixed(3)}</td>
                <td class="text-right">${vrijednostBezPdv.toFixed(2)}</td>
                <td class="text-right">${rabat.toFixed(1)}%</td>
                <td class="text-right">${pdvStopa}%</td>
                <td class="text-right">${pdvIznos.toFixed(2)}</td>
                <td class="text-right">${cenaSaPdvPoJedinici.toFixed(2)}</td>
                <td class="text-right">${iznosSaPdv.toFixed(2)}</td>
            </tr>
        `;
    });

    document.getElementById('print-items-tbody').innerHTML = itemsHTML;
    document.getElementById('print-total-bez-pdv').textContent = totalBezPdvBefore.toFixed(2);
    document.getElementById('print-total-rabat').textContent = totalRabat.toFixed(2);
    document.getElementById('print-osnovica').textContent = totalBezPdv.toFixed(2);
    document.getElementById('print-pdv-iznos').textContent = totalPdv.toFixed(2);
    document.getElementById('print-total-sa-pdv').textContent = totalSaPdv.toFixed(2);
    
    document.getElementById('print-signature-left').textContent = getSignatureText(createdDocumentData.tipDokumenta);
    document.getElementById('print-disclaimer').innerHTML = `<div><strong>${getDisclaimerText(createdDocumentData.tipDokumenta)}</strong></div>`;
}


