    <!-- Header -->
    <header class="header" id="header">
        <h1 class="page-title">Pravljenje Dokumenata</h1>
        
        <div class="header-actions">
            <button class="btn btn-success" id="create-document-btn">
                <i class="fas fa-plus"></i>
                <span>Novi Dokument</span>
            </button>
            <button class="btn btn-primary" id="refresh-btn">
                <i class="fas fa-sync-alt"></i>
                <span>Osvježi</span>
            </button>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="main-content" id="main-content">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Kreirana dokumenta</h3>
                <div class="search-filter-container">
                    <div class="search-box">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" class="form-control" id="search-documents" placeholder="Pretraži dokumenta...">
                    </div>
                    <select class="form-control" id="filter-document-type" style="max-width: 200px;">
                        <option value="">Svi tipovi</option>
                        <option value="Ponuda">Ponuda</option>
                        <option value="Predračun">Predračun</option>
                        <option value="Otpremnica">Otpremnica</option>
                        <option value="Kalkulacija">Kalkulacija</option>
                    </select>
                    <input type="date" class="form-control" id="filter-date-from" style="max-width: 150px;">
                    <input type="date" class="form-control" id="filter-date-to" style="max-width: 150px;">
                </div>
            </div>

            <div class="table-container">
                <table class="data-table" id="documents-table">
    <thead>
        <tr>
            <th>Šifra dokumenta</th>
            <th>Datum</th>
            <th>Tip dokumenta</th>
            <th>Magacin</th> <!-- Dodajte ovu kolonu -->
            <th>Partner</th>
            <th>Komercijalist</th>
            <th>Artikli</th>
            <th>Količina</th>
            <th>Iznos bez PDV</th>
            <th>PDV</th>
            <th>Iznos sa PDV</th>
        </tr>
    </thead>
    <tbody id="documents-tbody">
        <% dokumenti.forEach(function(dokument) { %>
            <tr>
                <td><strong><%= dokument.tip_dokumenta %></strong></td>
                <td><%= new Date(dokument.datum).toLocaleDateString('sr-RS') %></td>
                <td><%= dokument.tip_dokumenta.split('-')[0] %></td> <!-- Prikaži samo osnovni tip -->
                <td><%= dokument.magacin || 'N/A' %></td> <!-- Prikaži magacin -->
                <td><%= dokument.partner %></td>
                <td><%= dokument.komercijalist_id || 'N/A' %></td>
                <td title="<%= dokument.naziv_artikla %>"><%= dokument.naziv_artikla %></td>
                <td class="numeric-column"><%= dokument.kolicina %></td>
                <td class="price-column"><%= parseFloat(dokument.iznos_bez_pdv || 0).toFixed(2) %></td>
                <td class="price-column"><%= parseFloat(dokument.pdv_iznos || 0).toFixed(2) %></td>
                <td class="price-column"><strong><%= parseFloat(dokument.iznos_sa_pdv || 0).toFixed(2) %></strong></td>
            </tr>
        <% }); %>
    </tbody>
</table>
            </div>
        </div>
    </main>

    <!-- Modal for document creation -->
    <div class="modal" id="create-document-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Kreiranje novog dokumenta</h3>
                <button class="close-modal" id="close-document-modal">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            
            <div class="step-indicator">
                <div class="step active" id="step-1">
                    <div class="step-number">1</div>
                    <div class="step-title">Tip dokumenta</div>
                </div>
                <div class="step" id="step-2">
                    <div class="step-number">2</div>
                    <div class="step-title">Magacin</div>
                </div>
                <div class="step" id="step-3">
                    <div class="step-number">3</div>
                    <div class="step-title">Partner</div>
                </div>
                <div class="step" id="step-4">
                    <div class="step-number">4</div>
                    <div class="step-title">Komercijalist</div>
                </div>
                <div class="step" id="step-5">
                    <div class="step-number">5</div>
                    <div class="step-title">Artikli</div>
                </div>
                <div class="step" id="step-6">
                    <div class="step-number">6</div>
                    <div class="step-title">Pregled i potvrda</div>
                </div>
                <div class="step" id="step-7">
                    <div class="step-number">7</div>
                    <div class="step-title">Štampa</div>
                </div>
            </div>

            <!-- Step 1: Document Type Selection -->
            <div class="modal-step active" id="modal-step-1">
                <h4>Izaberite tip dokumenta:</h4>
                <div class="document-types">
                    <div class="document-type" data-type="ponuda">
                        <div class="icon"><i class="fas fa-file-signature"></i></div>
                        <h4>Ponuda</h4>
                        <p>Ne utiče na stanje lagera</p>
                    </div>
                    <div class="document-type" data-type="predracun">
                        <div class="icon"><i class="fas fa-file-invoice"></i></div>
                        <h4>Predračun</h4>
                        <p>Ne utiče na stanje lagera</p>
                    </div>
                    <div class="document-type" data-type="otpremnica">
                        <div class="icon"><i class="fas fa-truck"></i></div>
                        <h4>Otpremnica</h4>
                        <p>Oduzima sa lagera</p>
                    </div>
                    <div class="document-type" data-type="kalkulacija">
                        <div class="icon"><i class="fas fa-calculator"></i></div>
                        <h4>Kalkulacija</h4>
                        <p>Oduzima sa lagera</p>
                    </div>
                </div>
                <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem;">
                    <button type="button" class="btn btn-secondary" id="cancel-step-1">Otkaži</button>
                    <button type="button" class="btn btn-primary" id="next-step-1" disabled>Dalje</button>
                </div>
            </div>


            <!-- Step 2: Warehouse Selection -->
            <div class="modal-step" id="modal-step-2">
                <h4>Izaberite magacin:</h4>
                <div class="document-types">
                    <div class="document-type" data-magacin="VEL001">
                        <div class="icon"><i class="fas fa-warehouse"></i></div>
                        <h4>VELEPRODAJA MAGACIN</h4>
                    </div>
                    <div class="document-type" data-magacin="VEL002">
                        <div class="icon"><i class="fas fa-warehouse"></i></div>
                        <h4>VELEPRODAJA DOPUNA</h4>
                    </div>

                    <!-- MALOPRODAJA 1. SMJENA -->
                    <div class="document-type" data-magacin="MAL001">
                        <div class="icon"><i class="fas fa-warehouse"></i></div>
                        <h4>MALOPRODAJA KEŠ 1. SMJENA</h4>
                    </div>
                    <div class="document-type" data-magacin="MAL002">
                        <div class="icon"><i class="fas fa-warehouse"></i></div>
                        <h4>MALOPRODAJA RATE 1. SMJENA</h4>
                    </div>

                    <!-- MALOPRODAJA 2. SMJENA -->
                    <div class="document-type" data-magacin="MAL003">
                        <div class="icon"><i class="fas fa-warehouse"></i></div>
                        <h4>MALOPRODAJA KEŠ 2. SMJENA</h4>
                    </div>
                    <div class="document-type" data-magacin="MAL004">
                        <div class="icon"><i class="fas fa-warehouse"></i></div>
                        <h4>MALOPRODAJA RATE 2. SMJENA</h4>
                    </div>
                </div>

                <div style="display: flex; justify-content: space-between; margin-top: 2rem;">
                    <button type="button" class="btn btn-secondary" id="prev-step-2">Nazad</button>
                    <div>
                        <button type="button" class="btn btn-secondary" id="cancel-step-2">Otkaži</button>
                        <button type="button" class="btn btn-primary" id="next-step-2" disabled>Dalje</button>
                    </div>
                </div>
            </div>



            <!-- Step 3: Partner Selection -->
            <div class="modal-step" id="modal-step-3">
                <h4>Izaberite partnera:</h4>
                <div class="form-group">
                    <input type="text" class="form-control" id="search-partners" placeholder="Pretraži partnere...">
                </div>
                <div class="items-grid" id="partners-grid">
                    <% if (partneri && partneri.length > 0) { %>
                        <% partneri.forEach(function(partner) { %>
                            <div class="partner-item" data-sifra="<%= partner.Sifra || partner.sifra %>" data-partner='<%= JSON.stringify(partner) %>'>
                                <div class="partner-name">
                                    <%= partner.Naziv_partnera || partner.naziv_partnera %>
                                </div>
                                <div class="partner-details">
                                    Šifra: <%= partner.Sifra || partner.sifra %> | 
                                    PIB: <%= partner.PIB || partner.pib %> | 
                                    <%= partner.Grad || partner.grad %>
                                    <br>Adresa: <%= partner.Adresa || partner.adresa %> | 
                                    Tel: <%= partner.Telefon || partner.telefon %>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
                
                <div style="display: flex; justify-content: space-between; margin-top: 2rem;">
                    <button type="button" class="btn btn-secondary" id="prev-step-3">Nazad</button>
                    <div>
                        <button type="button" class="btn btn-secondary" id="cancel-step-3">Otkaži</button>
                        <button type="button" class="btn btn-primary" id="next-step-3" disabled>Dalje</button>
                    </div>
                </div>
            </div>

            <!-- Step 4: Komercijalist Selection -->
            <div class="modal-step" id="modal-step-4">
                <h4>Izaberite komercijalista:</h4>
                <div class="form-group">
                    <input type="text" class="form-control" id="search-komercijalisti" placeholder="Pretraži komercijalistu...">
                </div>
                <div class="items-grid" id="komercijalisti-grid">
                    <% if (komercijalisti && komercijalisti.length > 0) { %>
                        <% komercijalisti.forEach(function(komercijalist) { %>
                            <div class="komercijalist-item" data-id="<%= komercijalist.id %>" data-komercijalist='<%= JSON.stringify(komercijalist) %>'>
                                <div class="komercijalist-name"><%= komercijalist.ime_prezime %></div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
                <div style="display: flex; justify-content: space-between; margin-top: 2rem;">
                    <button type="button" class="btn btn-secondary" id="prev-step-4">Nazad</button>
                    <div>
                        <button type="button" class="btn btn-secondary" id="cancel-step-4">Otkaži</button>
                        <button type="button" class="btn btn-primary" id="next-step-4" disabled>Dalje</button>
                    </div>
                </div>
            </div>

            <!-- Step 5: Articles Selection -->
            <div class="modal-step" id="modal-step-5">
                <h4>Izaberite artikle:</h4>
                <div class="search-filter-container" style="margin-bottom: 1rem;">
                    <div class="search-box">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" class="form-control" id="search-artikli" placeholder="Pretraži artikle...">
                    </div>
                    <button class="btn btn-secondary" id="select-all-artikli">
                        <i class="fas fa-check-square"></i> Izaberi sve
                    </button>
                    <button class="btn btn-secondary" id="deselect-all-artikli">
                        <i class="fas fa-square"></i> Poništi sve
                    </button>
                    <div class="selected-count" id="selected-count" style="display: none;">
                        <span id="selected-items-count">0</span> izabranih artikala
                    </div>
                </div>

                <div class="table-container" style="max-height: 400px; overflow-y: auto;">
                    <table class="data-table" id="artikli-table">
                        <thead>
                            <tr>
                                <th>Izaberi</th>
                                <th>Šifra</th>
                                <th>Naziv</th>
                                <th>JM</th>
                                <th>Dostupno</th>
                                <th>Količina</th>
                                <th>Rabat (%)</th>
                                <th>Cijena bez PDV</th>
                                <th>Cijena sa PDV</th>
                                <th>Ukupno bez PDV</th>
                                <th>Ukupno sa PDV</th>
                            </tr>
                        </thead>
                        <tbody id="artikli-tbody">
                            <% if (lagerArtikli && lagerArtikli.length > 0) { %>
                                <% lagerArtikli.forEach(function(artikal) { %>
                                    <tr data-sifra="<%= artikal.sifra %>">
                                        <td>
                                            <input type="checkbox" class="custom-checkbox artikal-checkbox" 
                                                   data-sifra="<%= artikal.sifra %>"
                                                   data-naziv="<%= artikal.naziv %>"
                                                   data-jm="<%= artikal.JM || artikal.jm || 'kom' %>"
                                                   data-kolicina="<%= artikal.kolicina %>"
                                                   data-cena-bez-pdv="<%= artikal.cena_bez_PDV %>"
                                                   data-cena-sa-pdv="<%= artikal.cena_sa_PDV %>">
                                        </td>
                                        <td><%= artikal.sifra %></td>
                                        <td><%= artikal.naziv %></td>
                                        <td><%= artikal.JM %></td>
                                        <td class="numeric-column <%= artikal.kolicina <= 0 ? 'text-danger' : '' %>">
                                            <%= artikal.kolicina %>
                                        </td>
                                        <td>
                                            <input type="number" class="form-control kolicina-input" 
                                                   value="1" min="0.01" step="0.01" 
                                                   style="width: 80px; font-size: 11px; padding: 2px 4px;" 
                                                   disabled>
                                        </td>
                                        <td>
                                            <input type="number" class="form-control rabat-input" 
                                                   value="0" min="0" max="100" step="0.1" 
                                                   disabled>
                                        </td>
                                        <td class="price-column"><%= parseFloat(artikal.cena_bez_PDV || 0).toFixed(2) %></td>
                                        <td class="price-column"><%= parseFloat(artikal.cena_sa_PDV || 0).toFixed(2) %></td>
                                        <td class="price-column total-bez-pdv">0.00</td>
                                        <td class="price-column total-sa-pdv">0.00</td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
                
                <div style="display: flex; justify-content: space-between; margin-top: 2rem;">
                    <button type="button" class="btn btn-secondary" id="prev-step-5">Nazad</button>
                    <div>
                        <button type="button" class="btn btn-secondary" id="cancel-step-5">Otkaži</button>
                        <button type="button" class="btn btn-primary" id="next-step-5" disabled>Dalje</button>
                    </div>
                </div>
            </div>

            <!-- Step 6: Review and Confirm -->
            <div class="modal-step" id="modal-step-6">
                <h4>Pregled i potvrda dokumenta:</h4>
                
                <div class="summary-section">
                    <div class="summary-row">
                        <span><strong>Tip dokumenta:</strong></span>
                        <span id="review-doc-type"></span>
                    </div>
                    <div class="summary-row">
                        <span><strong>Komercijalist:</strong></span>
                        <span id="review-komercijalist"></span>
                    </div>
                    <div class="summary-row">
                        <span><strong>Partner:</strong></span>
                        <span id="review-partner"></span>
                    </div>
                    <div class="summary-row">
                        <span><strong>Broj artikala:</strong></span>
                        <span id="review-artikli-count"></span>
                    </div>
                    <div class="summary-row">
                        <span><strong>Ukupna količina:</strong></span>
                        <span id="review-total-kolicina"></span>
                    </div>
                    <div class="summary-row">
                        <span><strong>Iznos bez PDV:</strong></span>
                        <span id="review-iznos-bez-pdv"></span>
                    </div>
                    <div class="summary-row">
                        <span><strong>Prosečan rabat:</strong></span>
                        <span id="review-globalni-rabat"></span>
                    </div>
                    <div class="summary-row">
                        <span><strong>PDV:</strong></span>
                        <span id="review-pdv"></span>
                    </div>
                    <div class="summary-row total">
                        <span><strong>Ukupan iznos sa PDV:</strong></span>
                        <span id="review-iznos-sa-pdv"></span>
                    </div>
                </div>

                <div class="articles-overview">
                    <div class="articles-overview-header">
                        <i class="fas fa-list-alt"></i>
                        <h4 class="articles-overview-title">Uvid u artikle</h4>
                    </div>
                    <div class="articles-overview-body">
                        <table class="review-articles-table" id="review-articles-table">
                            <thead>
                                <tr>
                                    <th>Rb.</th>
                                    <th>Šifra</th>
                                    <th>Naziv artikla</th>
                                    <th>JM</th>
                                    <th class="text-center">Količina</th>
                                    <th class="text-right">Cena bez PDV</th>
                                    <th class="text-right">Rabat (%)</th>
                                    <th class="text-right">Iznos bez PDV</th>
                                    <th class="text-right">PDV (21%)</th>
                                    <th class="text-right">Iznos PDV</th>
                                    <th class="text-right">Ukupan iznos</th>
                                </tr>
                            </thead>
                            <tbody id="review-articles-tbody"></tbody>
                        </table>
                    </div>
                </div>

                <div class="form-group">
    <label class="form-label">Napomena (opciono):</label>
    <textarea class="form-control" id="document-napomena" rows="3" 
              placeholder="Unesite napomenu za ovaj dokument..."></textarea>
</div>
                
                <div style="display: flex; justify-content: space-between; margin-top: 2rem;">
                    <button type="button" class="btn btn-secondary" id="prev-step-6">Nazad</button>
                    <div>
                        <button type="button" class="btn btn-secondary" id="cancel-step-6">Otkaži</button>
                        <button type="button" class="btn btn-success" id="create-document-final">
                            <i class="fas fa-save"></i> Kreiraj Dokument
                        </button>
                    </div>
                </div>
            </div>

            <!-- Step 7: Print Preview and Print -->
            <div class="modal-step" id="modal-step-7">
                <h4>Dokument je kreiran uspešno!</h4>
                
                <div class="summary-section">
