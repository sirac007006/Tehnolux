        function searchKomercijalisti() {
            const term = document.getElementById('search-komercijalisti').value.toLowerCase();
            document.querySelectorAll('.komercijalist-item').forEach(item => {
                const text = item.textContent.toLowerCase();
                item.style.display = text.includes(term) ? 'block' : 'none';
            });
        }

        function searchPartners() {
            const term = document.getElementById('search-partners').value.toLowerCase();
            document.querySelectorAll('.partner-item').forEach(item => {
                const text = item.textContent.toLowerCase();
                item.style.display = text.includes(term) ? 'block' : 'none';
            });
        }

        function searchArtikli() {
            const term = document.getElementById('search-artikli').value.toLowerCase();
            document.querySelectorAll('#artikli-tbody tr').forEach(row => {
                if (row.children.length > 1) {
                    const sifra = row.children[1].textContent.toLowerCase();
                    const naziv = row.children[2].textContent.toLowerCase();
                    row.style.display = (sifra.includes(term) || naziv.includes(term)) ? '' : 'none';
                }
            });
        }

        function filterDocuments() {
            const searchTerm = document.getElementById('search-documents').value.toLowerCase();
            const docType = document.getElementById('filter-document-type').value;
            const dateFrom = document.getElementById('filter-date-from').value;
            const dateTo = document.getElementById('filter-date-to').value;

            document.querySelectorAll('#documents-tbody tr').forEach(row => {
                if (row.children.length > 1) {
                    const tipDokumenta = row.children[2].textContent;
                    const partner = row.children[4].textContent.toLowerCase();
                    const komercijalist = row.children[5].textContent.toLowerCase();
                    const artikli = row.children[6].textContent.toLowerCase();
                    const datum = row.children[1].textContent;

                    let showRow = true;

                    if (searchTerm && !partner.includes(searchTerm) && !komercijalist.includes(searchTerm) && !artikli.includes(searchTerm)) {
                        showRow = false;
                    }

                    if (docType && !tipDokumenta.includes(docType)) {
                        showRow = false;
                    }

                    if (dateFrom || dateTo) {
                        const rowDate = new Date(datum.split('.').reverse().join('-'));
                        if (dateFrom && rowDate < new Date(dateFrom)) showRow = false;
                        if (dateTo && rowDate > new Date(dateTo)) showRow = false;
                    }

                    row.style.display = showRow ? '' : 'none';
                }
            });
        }

        function initializeFilters() {
            const today = new Date();
            const monthAgo = new Date();
            monthAgo.setMonth(monthAgo.getMonth() - 1);

            document.getElementById('filter-date-from').value = monthAgo.toISOString().split('T')[0];
            document.getElementById('filter-date-to').value = today.toISOString().split('T')[0];
        }

        createDocumentModal.addEventListener('click', (e) => {
            if (e.target === createDocumentModal) {
                closeModal();
            }
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (createDocumentModal.classList.contains('show')) {
                    closeModal();
                } else if (sidebar.classList.contains('mobile-open')) {
                    closeMobileSidebar();
                }
            }
        });

        // Auto collapse sidebar on medium screens
        if (window.innerWidth <= 992 && window.innerWidth > 576) {
            sidebar.classList.add('collapsed');
            mainContent.classList.add('expanded');
            header.classList.add('expanded');
            sidebarIcon.classList.remove('fa-chevron-left');
            sidebarIcon.classList.add('fa-chevron-right');
        }

        // Handle window resize
        window.addEventListener('resize', function() {
            if (window.innerWidth > 576) {
                sidebar.classList.remove('mobile-open');
                sidebarOverlay.classList.remove('show');
                document.body.style.overflow = '';
            }
        });
        
        console.log('Pravljenje Dokumenata initialized with complete sidebar from lager.ejs');
    </script>
