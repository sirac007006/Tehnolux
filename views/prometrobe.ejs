                    <div class="kartica-field">
                        <div class="kartica-label">Datum:</div>
                        <div class="kartica-value">${cells[0].textContent}</div>
                    </div>
                    <div class="kartica-field">
                        <div class="kartica-label">Grupa:</div>
                        <div class="kartica-value">${cells[1].textContent}</div>
                    </div>
                    <div class="kartica-field">
                        <div class="kartica-label">Šifra:</div>
                        <div class="kartica-value">${cells[2].textContent}</div>
                    </div>
                    <div class="kartica-field">
                        <div class="kartica-label">EAN:</div>
                        <div class="kartica-value">${cells[3].textContent || 'N/A'}</div>
                    </div>
                    <div class="kartica-field" style="grid-column: 1/-1;">
                        <div class="kartica-label">Naziv artikla:</div>
                        <div class="kartica-value">${cells[4].textContent}</div>
                    </div>
                    <div class="kartica-field">
                        <div class="kartica-label">Magacin:</div>
                        <div class="kartica-value">${cells[5].textContent}</div>
                    </div>
                    <div class="kartica-field">
                        <div class="kartica-label">Partner:</div>
                        <div class="kartica-value">${cells[6].textContent}</div>
                    </div>
                    <div class="kartica-field">
                        <div class="kartica-label">Jedinica mere:</div>
                        <div class="kartica-value">${cells[7].textContent || 'N/A'}</div>
                    </div>
                    <div class="kartica-field">
                        <div class="kartica-label">Količina ulaz:</div>
                        <div class="kartica-value">${cells[8].textContent || '0'}</div>
                    </div>
                    <div class="kartica-field">
                        <div class="kartica-label">Količina izlaz:</div>
                        <div class="kartica-value">${cells[9].textContent || '0'}</div>
                    </div>
                `;
                
                karticaModal.classList.add('show');
            } else {
                alert('Molimo izaberite red u tabeli.');
            }
        });

        // Modal close events
        closeKarticaModal.addEventListener('click', () => {
            karticaModal.classList.remove('show');
        });

        closeSortModal.addEventListener('click', () => {
            sortModal.classList.remove('show');
        });

        cancelSort.addEventListener('click', () => {
            sortModal.classList.remove('show');
        });

        karticaModal.addEventListener('click', (e) => {
            if (e.target === karticaModal) {
                karticaModal.classList.remove('show');
            }
        });

        sortModal.addEventListener('click', (e) => {
            if (e.target === sortModal) {
                sortModal.classList.remove('show');
            }
        });

        // Sort functionality
        applySort.addEventListener('click', function() {
            const selectedSort = document.querySelector('input[name="sort-by"]:checked').value;
            
            filteredData.sort((a, b) => {
                switch(selectedSort) {
                    case 'datum':
                        return new Date(a.datum) - new Date(b.datum);
                    case 'sifra':
                        return a.sifra.localeCompare(b.sifra);
                    case 'naziv':
                        return a.naziv.localeCompare(b.naziv);
                    case 'magacin':
                        return a.magacin.localeCompare(b.magacin);
                    case 'partner':
                        return a.partner.localeCompare(b.partner);
                    case 'kolizlaz':
                        const aVal = parseFloat(a.kolIzlaz.replace(',', '.')) || 0;
                        const bVal = parseFloat(b.kolIzlaz.replace(',', '.')) || 0;
                        return bVal - aVal; // Descending order for quantities
                    default:
                        return 0;
                }
            });
            
            renderPrometTable();
            sortModal.classList.remove('show');
        });

        // Keyboard shortcuts - stejn kao u artikli
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (karticaModal.classList.contains('show')) {
                    karticaModal.classList.remove('show');
                } else if (sortModal.classList.contains('show')) {
                    sortModal.classList.remove('show');
                } else if (sidebar.classList.contains('mobile-open')) {
                    closeMobileSidebar();
                }
            }
            
            if (e.ctrlKey && e.key === 'p') {
                e.preventDefault();
                printBtn.click();
            }
        });

        // Smooth scrolling for sidebar navigation - stejn kao u artikli
        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 150);
            });
        });

        // Handle window resize
        window.addEventListener('resize', function() {
            if (window.innerWidth > 576) {
                sidebar.classList.remove('mobile-open');
                sidebarOverlay.classList.remove('show');
                document.body.style.overflow = '';
            }
        });

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            renderPrometTable();
            
            // Auto collapse sidebar on medium screens on load - stejn kao u artikli
            if (window.innerWidth <= 992 && window.innerWidth > 576) {
                sidebar.classList.add('collapsed');
                mainContent.classList.add('expanded');
                header.classList.add('expanded');
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            }
            
            console.log('Tehnolux Promet robe panel initialized - updated responsive design');
        });
    </script>
</body>
</html>