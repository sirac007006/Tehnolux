        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                padding: 12px 20px;
                border-radius: 4px;
                color: white;
                font-weight: 500;
                z-index: 3000;
                animation: slideIn 0.3s ease;
            `;
            
            switch(type) {
                case 'success':
                    notification.style.backgroundColor = '#2ecc71';
                    break;
                case 'error':
                    notification.style.backgroundColor = '#e74c3c';
                    break;
                case 'warning':
                    notification.style.backgroundColor = '#f1c40f';
                    notification.style.color = '#2c3e50';
                    break;
                default:
                    notification.style.backgroundColor = '#3498db';
            }
            
            notification.textContent = message;
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.style.animation = 'slideOut 0.3s ease';
                setTimeout(() => notification.remove(), 300);
            }, 3000);
        }

        // Add animation styles
        const style = document.createElement('style');
        style.textContent = `
            @keyframes slideIn {
                from { transform: translateX(100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
            @keyframes slideOut {
                from { transform: translateX(0); opacity: 1; }
                to { transform: translateX(100%); opacity: 0; }
            }
        `;
        document.head.appendChild(style);

        // Add new service
        addServiceBtn.addEventListener('click', async () => {
            await clearServiceForm();
            modalTitle.textContent = 'Unos novog servisnog zahteva';
            serviceModal.classList.add('show');
        });

        // Add new serviser
        addServiserBtn.addEventListener('click', () => {
            document.getElementById('serviser-name').value = '';
            serviserModal.classList.add('show');
        });

        // Close modals
        closeModal.addEventListener('click', () => {
            serviceModal.classList.remove('show');
        });

        closeStatusModal.addEventListener('click', () => {
            statusModal.classList.remove('show');
        });

        closeServiserModal.addEventListener('click', () => {
            serviserModal.classList.remove('show');
        });

        cancelBtn.addEventListener('click', () => {
            serviceModal.classList.remove('show');
        });

        cancelStatusBtn.addEventListener('click', () => {
            statusModal.classList.remove('show');
        });

        cancelServiserBtn.addEventListener('click', () => {
            serviserModal.classList.remove('show');
        });

        serviceModal.addEventListener('click', (e) => {
            if (e.target === serviceModal) {
                serviceModal.classList.remove('show');
            }
        });

        statusModal.addEventListener('click', (e) => {
            if (e.target === statusModal) {
                statusModal.classList.remove('show');
            }
        });

        serviserModal.addEventListener('click', (e) => {
            if (e.target === serviserModal) {
                serviserModal.classList.remove('show');
            }
        });

        // Service form submission
        serviceForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = {
                ime_kupca: document.getElementById('customer-name').value,
                telefon: document.getElementById('customer-phone').value,
                adresa: document.getElementById('customer-adresa').value,
                proizvod_model: document.getElementById('product-model').value,
                serijski_broj: document.getElementById('serial-number').value,
                status_garancije: document.getElementById('warranty-status').value,
                opis_kvara: document.getElementById('problem-description').value,
                tehnicar: document.getElementById('assigned-technician').value,
                prioritet: document.getElementById('priority-level').value,
                procenjena_cena: document.getElementById('estimated-cost').value,
                napomene: document.getElementById('service-notes').value,
                datum_kupovine: document.getElementById('purchase-date').value || null
            };

            const serviceId = serviceIdInput.value;
            const url = serviceId ? `/servis/update/${serviceId}` : '/servis/add';
            const method = serviceId ? 'PUT' : 'POST';

            try {
                const response = await fetch(url, {
                    method: method,
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(formData)
                });

                const data = await response.json();
                
                if (data.success) {
                    showNotification(data.message, 'success');
                    serviceModal.classList.remove('show');
                    // Reload page to show updated data
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                } else {
                    showNotification(data.message, 'error');
                }
            } catch (error) {
                showNotification('Greška pri čuvanju servisa.', 'error');
            }
        });

        // Status form submission
        statusForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const serviceId = statusServiceIdInput.value;
            const statusData = {
                status: document.getElementById('new-status').value,
                napomena: document.getElementById('status-note').value,
                finalna_cena: document.getElementById('final-cost').value
            };
            
            try {
                const response = await fetch(`/servis/status/${serviceId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(statusData)
                });

                const data = await response.json();
                
                if (data.success) {
                    showNotification(data.message, 'success');
                    statusModal.classList.remove('show');
                    
                    // Reload page to update warning indicators
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                } else {
                    showNotification(data.message, 'error');
                }
            } catch (error) {
                showNotification('Greška pri promeni statusa.', 'error');
            }
        });

        // Serviser form submission
        serviserForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const serviserName = document.getElementById('serviser-name').value.trim();
            
            if (!serviserName) {
                showNotification('Ime servisera je obavezno.', 'error');
                return;
            }
            
            try {
                const response = await fetch('/api/serviseri', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        ime_servisera: serviserName
                    })
                });

                const data = await response.json();
                
                if (data.success) {
                    showNotification(data.message, 'success');
                    serviserModal.classList.remove('show');
                    
                    // Add new serviser to the dropdown
                    const serviserSelect = document.getElementById('assigned-technician');
                    const newOption = document.createElement('option');
                    newOption.value = serviserName;
                    newOption.textContent = serviserName;
                    serviserSelect.appendChild(newOption);
                    
                    // Select the newly added serviser
                    serviserSelect.value = serviserName;
                    
                    // Also add to filter dropdown
                    const filterSelect = document.getElementById('serviser-filter');
                    const filterOption = document.createElement('option');
                    filterOption.value = serviserName;
                    filterOption.textContent = serviserName;
                    filterSelect.appendChild(filterOption);
                    
                    showNotification(`Serviser "${serviserName}" je dodat i automatski odabran.`, 'success');
                } else {
                    showNotification(data.message, 'error');
                }
            } catch (error) {
                showNotification('Greška pri dodavanju servisera.', 'error');
            }
        });

        // Helper function
        function getStatusText(status) {
            const statusMap = {
                'primljen': 'Primljen',
                'u-radu': 'U radu',
                'ceka-deo': 'Čeka deo',
                'gotov': 'Gotov',
                'isporucen': 'Isporučen'
            };
            return statusMap[status] || status;
        }

        // Search and filter functionality
        function filterTable() {
            const searchTerm = searchInput.value.toLowerCase();
            const statusFilterValue = document.getElementById('status-filter').value;
            const serviserFilterValue = document.getElementById('serviser-filter').value;
            const rows = document.querySelectorAll('#services-tbody tr');
            
            rows.forEach(row => {
                if (row.cells.length > 1) {
                    const customer = row.cells[1].textContent.toLowerCase();
                    const product = row.cells[2].textContent.toLowerCase();
                    const problem = (row.cells[3].title || row.cells[3].textContent).toLowerCase();
                    const serviser = row.cells[4].textContent.toLowerCase();
                    const status = row.cells[5].querySelector('.status-badge').className;
                    
                    const matchesSearch = customer.includes(searchTerm) || 
                                        product.includes(searchTerm) || 
                                        problem.includes(searchTerm);
                    
                    const matchesStatus = !statusFilterValue || status.includes(`status-${statusFilterValue}`);
                    const matchesServiser = !serviserFilterValue || serviser.includes(serviserFilterValue.toLowerCase());
                    
                    if (matchesSearch && matchesStatus && matchesServiser) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                }
            });
        }

        searchInput.addEventListener('input', filterTable);
        document.getElementById('status-filter').addEventListener('change', filterTable);
        document.getElementById('serviser-filter').addEventListener('change', filterTable);

        // Print report
        printReportBtn.addEventListener('click', function() {
            const printWindow = window.open('', '_blank');
            const visibleRows = Array.from(document.querySelectorAll('#services-tbody tr')).filter(row => 
                row.style.display !== 'none' && row.cells.length > 1
            );
            
            let tableRows = '';
            visibleRows.forEach(row => {
                const dateWarning = row.cells[6].querySelector('.date-warning');
                const dateInfo = dateWarning ? dateWarning.title : '';

                tableRows += `
                    <tr>
                        <td>${row.cells[0].textContent}</td>
                        <td>${row.cells[1].textContent}</td>
                        <td>${row.cells[2].textContent}</td>
                        <td>${row.cells[3].title || row.cells[3].textContent}</td>
                        <td>${row.cells[4].textContent}</td>
                        <td>${row.cells[5].textContent.trim()}</td>
                        <td>${dateInfo}</td>
                        <td>${row.cells[7].textContent}</td>
                        <td>${row.cells[8].textContent}</td>
                    </tr>
                `;
            });
            
            printWindow.document.write(`
                <html>
                <head>
                    <title>Tehnolux - Izveštaj servisa</title>
                    <style>
                        body { font-family: Arial, sans-serif; margin: 20px; }
                        .header { text-align: center; margin-bottom: 30px; }
                        table { width: 100%; border-collapse: collapse; }
                        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; font-size: 11px; }
                        th { background-color: #f8f9fa; font-weight: bold; }
                        .numeric { text-align: right; }
                        @media print { body { margin: 0; } }
                    </style>
                </head>
                <body>
                    <div class="header">
                        <h1>TEHNOLUX</h1>
                        <h2>Izveštaj servisnih zahteva</h2>
                        <p>Datum: ${new Date().toLocaleDateString('sr-RS')}</p>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Kupac</th>
                                <th>Proizvod/Model</th>
                                <th>Opis kvara</th>
                                <th>Serviser</th>
                                <th>Status</th>
                                <th>Datum kreiranja</th>
                                <th>Datum kupovine</th>
                                <th>Cena (€)</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${tableRows}
                        </tbody>
                    </table>
                </body>
                </html>
            `);
            printWindow.document.close();
            printWindow.print();
        });

        // Refresh button
        refreshBtn.addEventListener('click', function() {
            window.location.reload();
        });

        // Handle window resize
        window.addEventListener('resize', function() {
            if (window.innerWidth > 576) {
                closeMobileSidebar();
            }
            
            if (window.innerWidth <= 992 && window.innerWidth > 576) {
                if (!sidebar.classList.contains('collapsed')) {
                    sidebar.classList.add('collapsed');
                    mainContent.classList.add('expanded');
                    header.classList.add('expanded');
                    sidebarIcon.classList.remove('fa-chevron-left');
                    sidebarIcon.classList.add('fa-chevron-right');
                }
            }
        });

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            attachActionListeners();
            
            if (window.innerWidth <= 992 && window.innerWidth > 576) {
                sidebar.classList.add('collapsed');
                mainContent.classList.add('expanded');
                header.classList.add('expanded');
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            }
        });

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (serviceModal.classList.contains('show')) {
                    serviceModal.classList.remove('show');
                } else if (statusModal.classList.contains('show')) {
                    statusModal.classList.remove('show');
                } else if (serviserModal.classList.contains('show')) {
                    serviserModal.classList.remove('show');
                } else if (sidebar.classList.contains('mobile-open')) {
                    closeMobileSidebar();
                }
            }
            
            if (e.ctrlKey && e.key === 'n') {
                e.preventDefault();
                addServiceBtn.click();
            }
            
            if (e.ctrlKey && e.key === 'f') {
                e.preventDefault();
                searchInput.focus();
            }
            
            if (e.ctrlKey && e.key === 'p') {
                e.preventDefault();
                printReportBtn.click();
            }
        });
    </script>
</body>
</html>