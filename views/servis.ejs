    <script>
        // DOM Elements
        const sidebar = document.getElementById('sidebar');
        const sidebarOverlay = document.getElementById('sidebar-overlay');
        const mainContent = document.getElementById('main-content');
        const header = document.getElementById('header');
        const toggleSidebar = document.getElementById('toggle-sidebar');
        const sidebarIcon = document.getElementById('sidebar-icon');
        const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
        
        // Modal elements
        const serviceModal = document.getElementById('service-modal');
        const statusModal = document.getElementById('status-modal');
        const addServiceBtn = document.getElementById('add-service-btn');
        const closeModal = document.getElementById('close-modal');
        const closeStatusModal = document.getElementById('close-status-modal');
        const cancelBtn = document.getElementById('cancel-btn');
        const cancelStatusBtn = document.getElementById('cancel-status-btn');
        const serviceForm = document.getElementById('service-form');
        const statusForm = document.getElementById('status-form');
        const modalTitle = document.getElementById('modal-title');
        const serviceIdInput = document.getElementById('service-id');
        const statusServiceIdInput = document.getElementById('status-service-id');

        // Table elements
        const servicesTable = document.getElementById('services-tbody');
        const searchInput = document.getElementById('search-services');
        const statusFilter = document.getElementById('status-filter');
        const technicianFilter = document.getElementById('technician-filter');
        const refreshBtn = document.getElementById('refresh-btn');
        const printReportBtn = document.getElementById('print-report-btn');

        // Status change elements
        const newStatusSelect = document.getElementById('new-status');
        const completionGroup = document.getElementById('completion-group');
        const finalCostGroup = document.getElementById('final-cost-group');

        // Function to close mobile sidebar
        function closeMobileSidebar() {
            if (window.innerWidth <= 576) {
                sidebar.classList.remove('mobile-open');
                sidebarOverlay.classList.remove('show');
                document.body.style.overflow = '';
            }
        }

        // Mobile menu functionality
        mobileMenuToggle.addEventListener('click', function() {
            sidebar.classList.toggle('mobile-open');
            sidebarOverlay.classList.toggle('show');
            
            // Prevent body scroll when sidebar is open
            if (sidebar.classList.contains('mobile-open')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = '';
            }
        });

        // Close mobile menu when clicking overlay
        sidebarOverlay.addEventListener('click', function() {
            closeMobileSidebar();
        });

        // Close mobile menu when clicking outside
        document.addEventListener('click', function(e) {
            if (window.innerWidth <= 576) {
                if (!sidebar.contains(e.target) && !mobileMenuToggle.contains(e.target)) {
                    closeMobileSidebar();
                }
            }
        });

        // Toggle sidebar
        toggleSidebar.addEventListener('click', function() {
            sidebar.classList.toggle('collapsed');
            mainContent.classList.toggle('expanded');
            header.classList.toggle('expanded');
            
            if (sidebar.classList.contains('collapsed')) {
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            } else {
                sidebarIcon.classList.remove('fa-chevron-right');
                sidebarIcon.classList.add('fa-chevron-left');
            }
        });

        // Submenu functionality - bez zatvaranja sidebara za glavne kategorije
        document.querySelectorAll('.nav-item.has-submenu > .nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const parent = this.parentElement;
                const submenu = parent.querySelector('.submenu');
                
                // Zatvori druge submenije
                document.querySelectorAll('.nav-item.has-submenu').forEach(item => {
                    if (item !== parent) {
                        item.classList.remove('open');
                        item.querySelector('.submenu').classList.remove('open');
                    }
                });
                
                parent.classList.toggle('open');
                submenu.classList.toggle('open');
            });
        });

        // Enhanced navigation - zatvori sidebar pri kliku na submenu linkove
        document.querySelectorAll('.submenu .nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                // Dodaj vizuelnu povratnu informaciju
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 100);
                
                // Zatvori mobile sidebar odmah
                closeMobileSidebar();
            });
        });

        // Get next service number
        function getNextServiceNumber() {
            let maxId = 0;
            document.querySelectorAll('#services-tbody tr').forEach(row => {
                if (row.cells.length > 1) {
                    const id = parseInt(row.cells[0].textContent);
                    if (!isNaN(id) && id > maxId) {
                        maxId = id;
                    }
                }
            });
            return String(maxId + 1).padStart(3, '0');
        }

        // Status change handler
        newStatusSelect.addEventListener('change', function() {
            const status = this.value;
            
            if (status === 'gotov' || status === 'isporucen') {
                completionGroup.style.display = 'block';
                finalCostGroup.style.display = 'block';
                
                if (!document.getElementById('completion-date').value) {
                    const today = new Date().toISOString().split('T')[0];
                    document.getElementById('completion-date').value = today;
                }
            } else {
                completionGroup.style.display = 'none';
                finalCostGroup.style.display = 'none';
            }
        });

        // Attach event listeners to action buttons
        function attachActionListeners() {
            // Edit buttons
            document.querySelectorAll('.edit-service-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.dataset.id;
                    const row = document.querySelector(`tr[data-id="${id}"]`);
                    
                    if (row) {
                        fillServiceForm(row);
                        modalTitle.textContent = 'Izmeni servisni zahtev';
                        serviceModal.classList.add('show');
                    }
                });
            });

            // Status change buttons
            document.querySelectorAll('.status-service-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.dataset.id;
                    const row = document.querySelector(`tr[data-id="${id}"]`);
                    
                    if (row) {
                        statusServiceIdInput.value = id;
                        const currentStatus = row.cells[4].querySelector('.status-badge').className.split(' ').find(cls => cls.startsWith('status-')).replace('status-', '');
                        newStatusSelect.value = currentStatus;
                        newStatusSelect.dispatchEvent(new Event('change'));
                        statusModal.classList.add('show');
                    }
                });
            });

            // Print buttons
            document.querySelectorAll('.print-service-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.dataset.id;
                    printServiceReport(id);
                });
            });

            // Delete buttons
            document.querySelectorAll('.delete-service-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    if (confirm('Da li ste sigurni da želite da obrišete ovaj servisni zahtev?')) {
                        const id = this.dataset.id;
                        const row = document.querySelector(`tr[data-id="${id}"]`);
                        if (row) {
                            row.remove();
                            showNotification('Servisni zahtev je uspešno obrisan.', 'success');
                        }
                    }
                });
            });
        }

        // Fill form with service data
        function fillServiceForm(row) {
            serviceIdInput.value = row.dataset.id;
            document.getElementById('service-number').value = row.cells[0].textContent.trim();
            document.getElementById('customer-name').value = row.cells[1].textContent.trim();
            document.getElementById('product-model').value = row.cells[2].textContent.trim();
            document.getElementById('problem-description').value = row.cells[3].title || row.cells[3].textContent.trim();
            document.getElementById('estimated-cost').value = parseFloat(row.cells[5].textContent.replace('€', '').replace(',', ''));
        }

        // Clear form
        function clearServiceForm() {
            serviceForm.reset();
            serviceIdInput.value = '';
            document.getElementById('service-number').value = getNextServiceNumber();
            document.getElementById('priority-level').value = 'srednji';
            document.getElementById('warranty-status').value = 'proverava-se';
        }

        // Print service report
        function printServiceReport(serviceId) {
            const row = document.querySelector(`tr[data-id="${serviceId}"]`);
            if (!row) return;

            const serviceData = {
                id: row.cells[0].textContent.trim(),
                customer: row.cells[1].textContent.trim(),
                product: row.cells[2].textContent.trim(),
                problem: row.cells[3].title || row.cells[3].textContent.trim(),
                status: row.cells[4].textContent.trim(),
                cost: row.cells[5].textContent.trim()
            };

            // Create print window
            const printWindow = window.open('', '_blank');
            printWindow.document.write(`
                <html>
                <head>
                    <title>Servisni izveštaj #${serviceData.id}</title>
                    <style>
                        body { font-family: Arial, sans-serif; margin: 20px; }
                        .header { text-align: center; margin-bottom: 30px; }
                        .service-info { margin-bottom: 20px; }
                        .info-row { display: flex; margin-bottom: 10px; }
                        .label { font-weight: bold; width: 150px; }
                        .value { flex: 1; }
                        .signature { margin-top: 50px; display: flex; justify-content: space-between; }
                        .signature div { text-align: center; }
                        @media print { body { margin: 0; } }
                    </style>
                </head>
                <body>
                    <div class="header">
                        <h1>TEHNOLUX</h1>
                        <h2>Servisni izveštaj #${serviceData.id}</h2>
                    </div>
                    <div class="service-info">
                        <div class="info-row">
                            <div class="label">Kupac:</div>
                            <div class="value">${serviceData.customer}</div>
                        </div>
                        <div class="info-row">
                            <div class="label">Proizvod/Model:</div>
                            <div class="value">${serviceData.product}</div>
                        </div>
                        <div class="info-row">
                            <div class="label">Opis problema:</div>
                            <div class="value">${serviceData.problem}</div>
                        </div>
                        <div class="info-row">
                            <div class="label">Status:</div>
                            <div class="value">${serviceData.status}</div>
                        </div>
                        <div class="info-row">
                            <div class="label">Cena servisa:</div>
                            <div class="value">${serviceData.cost}</div>
                        </div>
                    </div>
                    <div class="signature">
                        <div>
                            <p>_____________________</p>
                            <p>Potpis tehničara</p>
                        </div>
                        <div>
                            <p>_____________________</p>
                            <p>Potpis kupca</p>
                        </div>
                    </div>
                </body>
                </html>
            `);
            printWindow.document.close();
            printWindow.print();
        }

        // Show notification
        function showNotification(message, type = 'info') {
            // Create notification element
            const notification = document.createElement('div');
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                padding: 12px 20px;
                border-radius: 4px;
                color: white;
                font-weight: 500;
                z-index: 3000;
                animation: slideIn 0.3s ease;
            `;
            
            switch(type) {
                case 'success':
                    notification.style.backgroundColor = '#2ecc71';
                    break;
                case 'error':
                    notification.style.backgroundColor = '#e74c3c';
                    break;
                case 'warning':
                    notification.style.backgroundColor = '#f1c40f';
                    notification.style.color = '#2c3e50';
                    break;
                default:
                    notification.style.backgroundColor = '#3498db';
            }
            
            notification.textContent = message;
            document.body.appendChild(notification);
            
            // Auto remove after 3 seconds
            setTimeout(() => {
                notification.style.animation = 'slideOut 0.3s ease';
                setTimeout(() => notification.remove(), 300);
            }, 3000);
        }

        // Add animation styles
        const style = document.createElement('style');
        style.textContent = `
            @keyframes slideIn {
                from { transform: translateX(100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
            @keyframes slideOut {
                from { transform: translateX(0); opacity: 1; }
                to { transform: translateX(100%); opacity: 0; }
            }
        `;
        document.head.appendChild(style);

        // Add new service
        addServiceBtn.addEventListener('click', () => {
            clearServiceForm();
            modalTitle.textContent = 'Unos novog servisnog zahteva';
            serviceModal.classList.add('show');
        });

        // Close modals
        closeModal.addEventListener('click', () => {
            serviceModal.classList.remove('show');
        });

        closeStatusModal.addEventListener('click', () => {
            statusModal.classList.remove('show');
        });

        cancelBtn.addEventListener('click', () => {
            serviceModal.classList.remove('show');
        });

        cancelStatusBtn.addEventListener('click', () => {
            statusModal.classList.remove('show');
        });

        serviceModal.addEventListener('click', (e) => {
            if (e.target === serviceModal) {
                serviceModal.classList.remove('show');
            }
        });

        statusModal.addEventListener('click', (e) => {
            if (e.target === statusModal) {
                statusModal.classList.remove('show');
            }
        });

        // Service form submission
        serviceForm.addEventListener('submit', (e) => {
            e.preventDefault();
            
            const formData = {
                id: serviceIdInput.value,
                serviceNumber: document.getElementById('service-number').value,
                customerName: document.getElementById('customer-name').value,
                customerPhone: document.getElementById('customer-phone').value,
                customerEmail: document.getElementById('customer-email').value,
                productModel: document.getElementById('product-model').value,
                serialNumber: document.getElementById('serial-number').value,
                warrantyStatus: document.getElementById('warranty-status').value,
                problemDescription: document.getElementById('problem-description').value,
                assignedTechnician: document.getElementById('assigned-technician').value,
                priorityLevel: document.getElementById('priority-level').value,
                estimatedCost: parseFloat(document.getElementById('estimated-cost').value) || 0
            };

            if (formData.id) {
                // Update existing service
                updateServiceRow(formData);
                showNotification('Servisni zahtev je uspešno ažuriran.', 'success');
            } else {
                // Add new service
                addNewServiceRow(formData);
                showNotification('Novi servisni zahtev je uspešno kreiran.', 'success');
            }

            serviceModal.classList.remove('show');
        });

        // Status form submission
        statusForm.addEventListener('submit', (e) => {
            e.preventDefault();
            
            const serviceId = statusServiceIdInput.value;
            const newStatus = document.getElementById('new-status').value;
            const statusNote = document.getElementById('status-note').value;
            const completionDate = document.getElementById('completion-date').value;
            const finalCost = document.getElementById('final-cost').value;
            
            const row = document.querySelector(`tr[data-id="${serviceId}"]`);
            if (row) {
                // Update status badge
                const statusBadge = row.cells[4].querySelector('.status-badge');
                statusBadge.className = `status-badge status-${newStatus}`;
                statusBadge.textContent = getStatusText(newStatus);
                
                // Update final cost if provided
                if (finalCost) {
                    row.cells[5].textContent = '€' + parseFloat(finalCost).toFixed(2);
                }
                
                showNotification(`Status servisa je promenjen na "${getStatusText(newStatus)}".`, 'success');
            }
            
            statusModal.classList.remove('show');
        });

        // Helper functions
        function getStatusText(status) {
            const statusMap = {
                'primljen': 'Primljen',
                'u-radu': 'U radu',
                'ceka-deo': 'Čeka deo',
                'gotov': 'Gotov',
                'isporucen': 'Isporučen'
            };
            return statusMap[status] || status;
        }

        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('sr-RS');
        }

        function updateServiceRow(data) {
            const row = document.querySelector(`tr[data-id="${data.id}"]`);
            if (row) {
                row.cells[1].textContent = data.customerName;
                row.cells[2].textContent = data.productModel;
                row.cells[3].textContent = data.problemDescription;
                row.cells[3].title = data.problemDescription;
                row.cells[5].textContent = '€' + data.estimatedCost.toFixed(2);
            }
        }

        function addNewServiceRow(data) {
            const tbody = document.getElementById('services-tbody');
            const newRow = document.createElement('tr');
            const newId = Date.now();
            newRow.dataset.id = newId;
            
            newRow.innerHTML = `
                <td class="numeric-column">${data.serviceNumber}</td>
                <td>${data.customerName}</td>
                <td>${data.productModel}</td>
                <td title="${data.problemDescription}">${data.problemDescription}</td>
                <td><span class="status-badge status-primljen">Primljen</span></td>
                <td class="price-column">€${data.estimatedCost.toFixed(2)}</td>
                <td>
                    <div class="action-buttons">
                        <button class="btn btn-sm btn-primary edit-service-btn" data-id="${newId}" title="Izmeni">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="btn btn-sm btn-warning status-service-btn" data-id="${newId}" title="Promeni status">
                            <i class="fas fa-exchange-alt"></i>
                        </button>
                        <button class="btn btn-sm btn-secondary print-service-btn" data-id="${newId}" title="Štampaj">
                            <i class="fas fa-print"></i>
                        </button>
                        <button class="btn btn-sm btn-danger delete-service-btn" data-id="${newId}" title="Obriši">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </td>
            `;
            
            tbody.appendChild(newRow);
            attachActionListeners();
        }

        // Search and filter functionality
        function filterTable() {
            const searchTerm = searchInput.value.toLowerCase();
            const statusFilter = document.getElementById('status-filter').value;
            const technicianFilter = document.getElementById('technician-filter').value;
            const rows = document.querySelectorAll('#services-tbody tr');
            
            rows.forEach(row => {
                if (row.cells.length > 1) {
                    const customer = row.cells[1].textContent.toLowerCase();
                    const product = row.cells[2].textContent.toLowerCase();
                    const problem = (row.cells[3].title || row.cells[3].textContent).toLowerCase();
                    const status = row.cells[4].querySelector('.status-badge').className;
                    
                    const matchesSearch = customer.includes(searchTerm) || 
                                        product.includes(searchTerm) || 
                                        problem.includes(searchTerm);
                    
                    const matchesStatus = !statusFilter || status.includes(`status-${statusFilter}`);
                    const matchesTechnician = true; // Removed technician filter from simplified table
                    
                    if (matchesSearch && matchesStatus && matchesTechnician) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                }
            });
        }

        searchInput.addEventListener('input', filterTable);
        document.getElementById('status-filter').addEventListener('change', filterTable);
        document.getElementById('technician-filter').addEventListener('change', filterTable);

        // Print report
        printReportBtn.addEventListener('click', function() {
            const printWindow = window.open('', '_blank');
            const visibleRows = Array.from(document.querySelectorAll('#services-tbody tr')).filter(row => 
                row.style.display !== 'none' && row.cells.length > 1
            );
            
            let tableRows = '';
            visibleRows.forEach(row => {
                tableRows += `
                    <tr>
                        <td>${row.cells[0].textContent}</td>
                        <td>${row.cells[1].textContent}</td>
                        <td>${row.cells[2].textContent}</td>
                        <td>${row.cells[3].title || row.cells[3].textContent}</td>
                        <td>${row.cells[4].textContent.trim()}</td>
                        <td>${row.cells[5].textContent}</td>
                    </tr>
                `;
            });
            
            printWindow.document.write(`
                <html>
                <head>
                    <title>Tehnolux - Izveštaj servisa</title>
                    <style>
                        body { font-family: Arial, sans-serif; margin: 20px; }
                        .header { text-align: center; margin-bottom: 30px; }
                        table { width: 100%; border-collapse: collapse; }
                        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; font-size: 12px; }
                        th { background-color: #f8f9fa; font-weight: bold; }
                        .numeric { text-align: right; }
                        @media print { body { margin: 0; } }
                    </style>
                </head>
                <body>
                    <div class="header">
                        <h1>TEHNOLUX</h1>
                        <h2>Izveštaj servisnih zahteva</h2>
                        <p>Datum: ${new Date().toLocaleDateString('sr-RS')}</p>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Kupac</th>
                                <th>Proizvod/Model</th>
                                <th>Opis kvara</th>
                                <th>Status</th>
                                <th>Cena (€)</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${tableRows}
                        </tbody>
                    </table>
                </body>
                </html>
            `);
            printWindow.document.close();
            printWindow.print();
        });

        // Refresh button
        refreshBtn.addEventListener('click', function() {
            showNotification('Podaci su osveženi.', 'info');
            // In real app, this would reload data from server
        });

        // Handle window resize
        window.addEventListener('resize', function() {
            if (window.innerWidth > 576) {
                closeMobileSidebar();
            }
            
            // Auto collapse sidebar on medium screens
            if (window.innerWidth <= 992 && window.innerWidth > 576) {
                if (!sidebar.classList.contains('collapsed')) {
                    sidebar.classList.add('collapsed');
                    mainContent.classList.add('expanded');
                    header.classList.add('expanded');
                    sidebarIcon.classList.remove('fa-chevron-left');
                    sidebarIcon.classList.add('fa-chevron-right');
                }
            }
        });

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            attachActionListeners();
            
            // Auto collapse sidebar on medium screens on load
            if (window.innerWidth <= 992 && window.innerWidth > 576) {
                sidebar.classList.add('collapsed');
                mainContent.classList.add('expanded');
                header.classList.add('expanded');
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            }
            
            console.log('Tehnolux Servis panel initialized with improved responsive design');
        });

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // ESC to close modals or mobile menu
            if (e.key === 'Escape') {
                if (serviceModal.classList.contains('show')) {
                    serviceModal.classList.remove('show');
                } else if (statusModal.classList.contains('show')) {
                    statusModal.classList.remove('show');
                } else if (sidebar.classList.contains('mobile-open')) {
                    closeMobileSidebar();
                }
            }
            
            // Ctrl+N for new service
            if (e.ctrlKey && e.key === 'n') {
                e.preventDefault();
                addServiceBtn.click();
            }
            
            // Ctrl+F to focus search
            if (e.ctrlKey && e.key === 'f') {
                e.preventDefault();
                searchInput.focus();
            }
            
            // Ctrl+P for print report
            if (e.ctrlKey && e.key === 'p') {
                e.preventDefault();
                printReportBtn.click();
            }
        });

        // Auto-save drafts (demo feature)
        let draftTimeout;
        function saveDraft() {
            clearTimeout(draftTimeout);
            draftTimeout = setTimeout(() => {
                if (serviceModal.classList.contains('show')) {
                    const draftData = {
                        customerName: document.getElementById('customer-name').value,
                        productModel: document.getElementById('product-model').value,
                        problemDescription: document.getElementById('problem-description').value,
                        timestamp: new Date().toISOString()
                    };
                    // In real app, save to localStorage or server
                    console.log('Draft saved:', draftData);
                }
            }, 2000);
        }

        // Add auto-save listeners to form inputs
        ['customer-name', 'product-model', 'problem-description'].forEach(id => {
            const element = document.getElementById(id);
            if (element) {
                element.addEventListener('input', saveDraft);
            }
        });
    </script>
</body>
</html>