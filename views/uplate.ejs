    <script>
        // Initialize with server data
        let paymentsData = <%- JSON.stringify(uplate || []) %>;
        let filteredData = [...paymentsData];
        let partneriData = [];
        let komercijalistiData = [];

        // DOM Elements
        const sidebar = document.getElementById('sidebar');
        const sidebarOverlay = document.getElementById('sidebar-overlay');
        const mainContent = document.getElementById('main-content');
        const header = document.getElementById('header');
        const toggleSidebar = document.getElementById('toggle-sidebar');
        const sidebarIcon = document.getElementById('sidebar-icon');
        const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
        
        // Modal elements
        const paymentModal = document.getElementById('payment-modal');
        const addPaymentBtn = document.getElementById('add-payment-btn');
        const closeModal = document.getElementById('close-modal');
        const cancelBtn = document.getElementById('cancel-btn');
        const paymentForm = document.getElementById('payment-form');
        const modalTitle = document.getElementById('modal-title');
        const paymentIdInput = document.getElementById('payment-id');

        // Autocomplete elements
        const customerInput = document.getElementById('customer-name');
        const customerAutocomplete = document.getElementById('customer-autocomplete');
        const salespersonInput = document.getElementById('salesperson');
        const salespersonAutocomplete = document.getElementById('salesperson-autocomplete');
        const partnerSifraInput = document.getElementById('partner-sifra');
        const komercijalistIdInput = document.getElementById('komercijalist-id');

        // Table and filter elements
        const paymentsTable = document.getElementById('payments-tbody');
        const searchInput = document.getElementById('search-payments');
        const statusFilter = document.getElementById('status-filter');
        const methodFilter = document.getElementById('method-filter');
        const refreshBtn = document.getElementById('refresh-btn');

        // Date filter elements
        const dateFromInput = document.getElementById('date-from');
        const dateToInput = document.getElementById('date-to');
        const applyDateFilterBtn = document.getElementById('apply-date-filter');
        const clearDateFilterBtn = document.getElementById('clear-date-filter');
        const quickDateBtns = document.querySelectorAll('.quick-date-btn');

        // Load partners and komercijalisti data
        async function loadPartneriData() {
            try {
                const response = await fetch('/api/partneri');
                partneriData = await response.json();
                console.log('Loaded partneri data:', partneriData.length, 'partners');
            } catch (error) {
                console.error('Error loading partneri:', error);
                partneriData = [];
            }
        }

        async function loadKomercijalistiData() {
            try {
                const response = await fetch('/api/komercijalisti');
                komercijalistiData = await response.json();
                console.log('Loaded komercijalisti data:', komercijalistiData.length, 'komercijalisti');
            } catch (error) {
                console.error('Error loading komercijalisti:', error);
                komercijalistiData = [];
            }
        }

        // Autocomplete functionality
        function setupAutocomplete(input, dropdown, data, searchFields, displayField, subtitleField, callback) {
            let selectedIndex = -1;
            let filteredItems = [];

            input.addEventListener('input', function() {
                const value = this.value.toLowerCase().trim();
                dropdown.innerHTML = '';
                selectedIndex = -1;
                
                if (value.length < 2) {
                    dropdown.classList.remove('show');
                    return;
                }

                filteredItems = data.filter(item => {
                    return searchFields.some(field => {
                        const fieldValue = item[field];
                        return fieldValue && fieldValue.toLowerCase().includes(value);
                    });
                }).slice(0, 10); // Limit to 10 results

                if (filteredItems.length === 0) {
                    dropdown.classList.remove('show');
                    return;
                }

                filteredItems.forEach((item, index) => {
                    const div = document.createElement('div');
                    div.className = 'autocomplete-item';
                    div.innerHTML = `
                        <div class="autocomplete-item-title">${item[displayField]}</div>
                        ${subtitleField && item[subtitleField] ? `<div class="autocomplete-item-subtitle">${item[subtitleField]}</div>` : ''}
                    `;
                    
                    div.addEventListener('click', function() {
                        input.value = item[displayField];
                        dropdown.classList.remove('show');
                        if (callback) callback(item);
                    });
                    
                    dropdown.appendChild(div);
                });

                dropdown.classList.add('show');
            });

            input.addEventListener('keydown', function(e) {
                const items = dropdown.querySelectorAll('.autocomplete-item');
                
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
                    updateSelection(items);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    selectedIndex = Math.max(selectedIndex - 1, -1);
                    updateSelection(items);
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (selectedIndex >= 0 && items[selectedIndex]) {
                        items[selectedIndex].click();
                    }
                } else if (e.key === 'Escape') {
                    dropdown.classList.remove('show');
                    selectedIndex = -1;
                }
            });

            function updateSelection(items) {
                items.forEach((item, index) => {
                    item.classList.toggle('selected', index === selectedIndex);
                });
            }

            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (!input.contains(e.target) && !dropdown.contains(e.target)) {
                    dropdown.classList.remove('show');
                }
            });
        }

        // Format currency
        function formatCurrency(amount) {
            return new Intl.NumberFormat('de-DE', {
                style: 'currency',
                currency: 'EUR',
                minimumFractionDigits: 2
            }).format(amount);
        }

        // Format date
        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('sr-RS') + ' ' + date.toLocaleTimeString('sr-RS', { 
                hour: '2-digit', 
                minute: '2-digit' 
            });
        }

        // Get status badge HTML
        function getStatusBadge(status) {
            let badgeClass = '';
            switch(status) {
                case 'primljena':
                    badgeClass = 'status-primljena';
                    break;
                case 'cekanje':
                    badgeClass = 'status-cekanje';
                    break;
                case 'odbijena':
                    badgeClass = 'status-odbijena';
                    break;
            }
            return `<span class="status-badge ${badgeClass}">${status}</span>`;
        }

        // Get payment method badge HTML
        function getPaymentMethodBadge(method) {
            let badgeClass = '';
            switch(method) {
                case 'gotovina':
                    badgeClass = 'method-gotovina';
                    break;
                case 'kartica':
                    badgeClass = 'method-kartica';
                    break;
                case 'virman':
                    badgeClass = 'method-virman';
                    break;
            }
            return `<span class="payment-method ${badgeClass}">${method}</span>`;
        }

        // Update statistics
        async function updateStatistics() {
            try {
                const from = dateFromInput.value;
                const to = dateToInput.value;
                let url = '/api/uplate/stats/summary';
                
                if (from || to) {
                    const params = new URLSearchParams();
                    if (from) params.append('from', from);
                    if (to) params.append('to', to);
                    url += '?' + params.toString();
                }
                
                const response = await fetch(url);
                const stats = await response.json();
                
                document.getElementById('total-payments').textContent = formatCurrency(stats.totalPayments);
                document.getElementById('payment-count').textContent = stats.paymentCount;
                document.getElementById('avg-payment').textContent = formatCurrency(stats.avgPayment);
                document.getElementById('pending-payments').textContent = stats.pendingPayments;
                
                // Update summary
                document.getElementById('period-total').textContent = formatCurrency(stats.totalPayments);
                document.getElementById('period-count').textContent = stats.paymentCount;
                document.getElementById('period-successful').textContent = formatCurrency(stats.successfulAmount);
                document.getElementById('period-failed').textContent = formatCurrency(stats.failedAmount);
                
            } catch (error) {
                console.error('Error updating statistics:', error);
            }
        }

        // Load payments from API
        async function loadPayments() {
            try {
                const response = await fetch('/api/uplate');
                const data = await response.json();
                paymentsData = data;
                applyFilters();
                updateStatistics();
            } catch (error) {
                console.error('Error loading payments:', error);
                alert('Greška pri učitavanju uplata.');
            }
        }

        // Render payments table
        function renderPaymentsTable(data = filteredData) {
            const tbody = document.getElementById('payments-tbody');
            tbody.innerHTML = '';
            
            if (data.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="10" style="text-align: center; padding: 2rem; color: #666;">
                            <i class="fas fa-inbox" style="font-size: 2rem; margin-bottom: 1rem; display: block;"></i>
                            Nema uplata za prikaz
                        </td>
                    </tr>
                `;
                return;
            }
            
            data.forEach(payment => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td><strong>${payment.id}</strong></td>
                    <td>${formatDate(payment.datum)}</td>
                    <td title="${payment.kupac}">${payment.kupac}</td>
                    <td class="currency amount-positive">${formatCurrency(payment.iznos)}</td>
                    <td>${getPaymentMethodBadge(payment.nacin)}</td>
                    <td>${getStatusBadge(payment.status)}</td>
                    <td>${payment.dokument || '-'}</td>
                    <td>${payment.komercijalist || '-'}</td>
                    <td title="${payment.napomene || ''}">${payment.napomene ? (payment.napomene.length > 20 ? payment.napomene.substring(0, 20) + '...' : payment.napomene) : '-'}</td>
                    <td>
                        <div class="action-buttons">
                            <button class="btn btn-sm btn-primary edit-payment-btn" data-id="${payment.id}" title="Uredi">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-info view-payment-btn" data-id="${payment.id}" title="Detalji">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="btn btn-sm btn-success print-receipt-btn" data-id="${payment.id}" title="Štampaj">
                                <i class="fas fa-print"></i>
                            </button>
                            <button class="btn btn-sm btn-danger delete-payment-btn" data-id="${payment.id}" title="Obriši">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                `;
                tbody.appendChild(row);
            });

            // Attach event listeners to new buttons
            attachActionListeners();
        }

        // Attach event listeners to action buttons
        function attachActionListeners() {
            // Edit buttons (blue button with edit icon)
            document.querySelectorAll('.edit-payment-btn').forEach(btn => {
                btn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    const id = this.dataset.id;
                    console.log('Edit button clicked for payment ID:', id);
                    
                    try {
                        const response = await fetch(`/api/uplate/${id}`);
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        const payment = await response.json();
                        console.log('Payment data loaded for editing:', payment);
                        
                        fillForm(payment);
                        modalTitle.textContent = 'Uredi uplatu';
                        paymentModal.classList.add('show');
                    } catch (error) {
                        console.error('Error fetching payment for edit:', error);
                        alert('Greška pri dohvatanju uplate za pregled.');
                    }
                });
            });

            // Print receipt buttons
            document.querySelectorAll('.print-receipt-btn').forEach(btn => {
                btn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    const id = this.dataset.id;
                    console.log('Print button clicked for payment ID:', id);
                    
                    try {
                        const response = await fetch(`/api/uplate/${id}`);
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        const payment = await response.json();
                        console.log('Payment data loaded for printing:', payment);
                        
                        printReceipt(payment);
                    } catch (error) {
                        console.error('Error fetching payment for print:', error);
                        alert('Greška pri dohvatanju uplate za štampanje.');
                    }
                });
            });

            // Delete buttons
            document.querySelectorAll('.delete-payment-btn').forEach(btn => {
                btn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    const id = this.dataset.id;
                    console.log('Delete button clicked for payment ID:', id);
                    
                    if (confirm(`Da li ste sigurni da želite da obrišete uplatu "${id}"?`)) {
                        try {
                            const response = await fetch(`/api/uplate/${id}`, {
                                method: 'DELETE'
                            });
                            
                            if (response.ok) {
                                await loadPayments();
                                alert('Uplata je uspješno obrisana.');
                            } else {
                                throw new Error('Delete failed');
                            }
                        } catch (error) {
                            console.error('Error deleting payment:', error);
                            alert('Greška pri brisanju uplate.');
                        }
                    }
                });
            });
        }

        // Show payment details in a better formatted popup
        function showPaymentDetails(payment) {
            const statusText = {
                'primljena': 'Primljena',
                'cekanje': 'Na čekanju', 
                'odbijena': 'Odbijena'
            };
            
            const methodText = {
                'gotovina': 'Gotovina',
                'kartica': 'Kartica',
                'virman': 'Virman'
            };
            
            const details = `
=== DETALJI UPLATE ===

ID Uplate: ${payment.id}
Datum: ${formatDate(payment.datum)}
Kupac: ${payment.kupac}
Iznos: ${formatCurrency(payment.iznos)}
Način plaćanja: ${methodText[payment.nacin] || payment.nacin}
Status: ${statusText[payment.status] || payment.status}
Dokument: ${payment.dokument || 'Nije unešen'}
Komercijalist: ${payment.komercijalist || 'Nije dodjeljen'}

Napomene: 
${payment.napomene || 'Nema dodatnih napomena'}

========================
            `.trim();
            
            alert(details);
        }

        // Print receipt
        function printReceipt(payment) {
            const receipt = `
TEHNOLUX d.o.o.
Potvrda o uplati
==================

ID Uplate: ${payment.id}
Datum: ${formatDate(payment.datum)}
Kupac: ${payment.kupac}
Iznos: ${formatCurrency(payment.iznos)}
Način plaćanja: ${payment.nacin}
Status: ${payment.status}
Dokument: ${payment.dokument || 'N/A'}
Komercijalist: ${payment.komercijalist || 'N/A'}

Napomene: ${payment.napomene || 'Nema napomena'}

==================
Hvala Vam na ukazanom povjerenju!
            `.trim();
            
            alert('Potvrda o uplati:\n\n' + receipt);
        }

        // Fill form with payment data
        function fillForm(payment) {
            paymentIdInput.value = payment.id;
            
            // Convert database datetime to input format
            const date = new Date(payment.datum);
            const formattedDate = date.getFullYear() + '-' + 
                String(date.getMonth() + 1).padStart(2, '0') + '-' + 
                String(date.getDate()).padStart(2, '0') + 'T' +
                String(date.getHours()).padStart(2, '0') + ':' +
                String(date.getMinutes()).padStart(2, '0');
            
            document.getElementById('payment-date').value = formattedDate;
            document.getElementById('payment-amount').value = payment.iznos;
            document.getElementById('customer-name').value = payment.kupac;
            document.getElementById('payment-method').value = payment.nacin;
            document.getElementById('payment-status').value = payment.status;
            document.getElementById('document-number').value = payment.dokument || '';
            document.getElementById('salesperson').value = payment.komercijalist || '';
            document.getElementById('payment-notes').value = payment.napomene || '';

            // Try to find partner and komercijalist IDs
            const partner = partneriData.find(p => p.Naziv_partnera === payment.kupac);
            if (partner) {
                partnerSifraInput.value = partner.Sifra;
            }

            const komercijalist = komercijalistiData.find(k => k.ime_prezime === payment.komercijalist);
            if (komercijalist) {
                komercijalistIdInput.value = komercijalist.id;
            }
        }

        // Clear form
        function clearForm() {
            paymentForm.reset();
            paymentIdInput.value = '';
            partnerSifraInput.value = '';
            komercijalistIdInput.value = '';
            
            const now = new Date();
            const formattedNow = now.getFullYear() + '-' + 
                String(now.getMonth() + 1).padStart(2, '0') + '-' + 
                String(now.getDate()).padStart(2, '0') + 'T' +
                String(now.getHours()).padStart(2, '0') + ':' +
                String(now.getMinutes()).padStart(2, '0');
            document.getElementById('payment-date').value = formattedNow;
            document.getElementById('payment-status').value = 'primljena';
        }

        // Apply filters
        function applyFilters() {
            const term = searchInput.value.toLowerCase();
            const status = statusFilter.value;
            const method = methodFilter.value;
            const dateFrom = dateFromInput.value ? new Date(dateFromInput.value) : null;
            const dateTo = dateToInput.value ? new Date(dateToInput.value + 'T23:59:59') : null;

            filteredData = paymentsData.filter(payment => {
                const paymentDate = new Date(payment.datum);
                
                const matchesSearch = payment.id.toString().includes(term) ||
                                    payment.kupac.toLowerCase().includes(term) ||
                                    (payment.dokument && payment.dokument.toLowerCase().includes(term)) ||
                                    (payment.komercijalist && payment.komercijalist.toLowerCase().includes(term));
                
                const matchesStatus = !status || payment.status === status;
                const matchesMethod = !method || payment.nacin === method;
                
                const matchesDateFrom = !dateFrom || paymentDate >= dateFrom;
                const matchesDateTo = !dateTo || paymentDate <= dateTo;
                
                return matchesSearch && matchesStatus && matchesMethod && matchesDateFrom && matchesDateTo;
            });

            renderPaymentsTable(filteredData);
            updateStatistics();
        }

        // Quick date functions
        function setQuickDate(days, period) {
            const now = new Date();
            let fromDate, toDate;
            
            if (period === 'month') {
                fromDate = new Date(now.getFullYear(), now.getMonth(), 1);
                toDate = new Date(now.getFullYear(), now.getMonth() + 1, 0);
            } else if (period === 'year') {
                fromDate = new Date(now.getFullYear(), 0, 1);
                toDate = new Date(now.getFullYear(), 11, 31);
            } else {
                fromDate = new Date(now);
                fromDate.setDate(now.getDate() - days);
                toDate = new Date(now);
            }
            
            dateFromInput.value = fromDate.toISOString().split('T')[0];
            dateToInput.value = toDate.toISOString().split('T')[0];
            
            // Remove active class from all buttons and add to clicked one
            quickDateBtns.forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
        }

        // Event listeners for quick date buttons
        quickDateBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const days = this.dataset.days;
                const period = this.dataset.period;
                
                if (days !== undefined) {
                    setQuickDate(parseInt(days));
                } else if (period) {
                    setQuickDate(0, period);
                }
            });
        });

        // Modal functionality
        addPaymentBtn.addEventListener('click', () => {
            clearForm();
            modalTitle.textContent = 'Nova uplata';
            paymentModal.classList.add('show');
        });

        closeModal.addEventListener('click', () => {
            paymentModal.classList.remove('show');
        });

        cancelBtn.addEventListener('click', () => {
            paymentModal.classList.remove('show');
        });

        paymentModal.addEventListener('click', (e) => {
            if (e.target === paymentModal) {
                paymentModal.classList.remove('show');
            }
        });

        // Form submission
        paymentForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = {
                datum: document.getElementById('payment-date').value.replace('T', ' ') + ':00',
                kupac: document.getElementById('customer-name').value,
                iznos: parseFloat(document.getElementById('payment-amount').value),
                nacin: document.getElementById('payment-method').value,
                status: document.getElementById('payment-status').value,
                dokument: document.getElementById('document-number').value,
                komercijalist: document.getElementById('salesperson').value,
                napomene: document.getElementById('payment-notes').value,
                partner_sifra: partnerSifraInput.value,
                komercijalist_id: komercijalistIdInput.value
            };

            try {
                const paymentId = paymentIdInput.value;
                let response;
                
                if (paymentId) {
                    // Update existing
                    response = await fetch(`/api/uplate/${paymentId}`, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(formData)
                    });
                } else {
                    // Add new
                    response = await fetch('/api/uplate', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(formData)
                    });
                }

                if (response.ok) {
                    paymentModal.classList.remove('show');
                    await loadPayments();
                    alert(paymentId ? 'Uplata je uspješno ažurirana.' : 'Uplata je uspješno dodana.');
                } else {
                    throw new Error('Save failed');
                }
            } catch (error) {
                console.error('Error saving payment:', error);
                alert('Greška pri snimanju uplate.');
            }
        });

        // Search and filter functionality
        searchInput.addEventListener('input', applyFilters);
        statusFilter.addEventListener('change', applyFilters);
        methodFilter.addEventListener('change', applyFilters);

        // Date filter functionality
        applyDateFilterBtn.addEventListener('click', applyFilters);

        clearDateFilterBtn.addEventListener('click', () => {
            dateFromInput.value = '';
            dateToInput.value = '';
            quickDateBtns.forEach(btn => btn.classList.remove('active'));
            applyFilters();
        });

        // Refresh button
        refreshBtn.addEventListener('click', async function() {
            await loadPayments();
            await loadPartneriData();
            await loadKomercijalistiData();
            searchInput.value = '';
            statusFilter.value = '';
            methodFilter.value = '';
            dateFromInput.value = '';
            dateToInput.value = '';
            quickDateBtns.forEach(btn => btn.classList.remove('active'));
        });

        // Sidebar functionality
        function closeMobileSidebar() {
            if (window.innerWidth <= 576) {
                sidebar.classList.remove('mobile-open');
                if (sidebarOverlay) sidebarOverlay.classList.remove('show');
                document.body.style.overflow = '';
            }
        }

        if (mobileMenuToggle) {
            mobileMenuToggle.addEventListener('click', function() {
                sidebar.classList.toggle('mobile-open');
                if (sidebarOverlay) sidebarOverlay.classList.toggle('show');
                
                if (sidebar.classList.contains('mobile-open')) {
                    document.body.style.overflow = 'hidden';
                } else {
                    document.body.style.overflow = '';
                }
            });
        }

        if (sidebarOverlay) {
            sidebarOverlay.addEventListener('click', closeMobileSidebar);
        }

        if (toggleSidebar) {
            toggleSidebar.addEventListener('click', function() {
                sidebar.classList.toggle('collapsed');
                mainContent.classList.toggle('expanded');
                header.classList.toggle('expanded');
                
                if (sidebar.classList.contains('collapsed')) {
                    sidebarIcon.classList.remove('fa-chevron-left');
                    sidebarIcon.classList.add('fa-chevron-right');
                } else {
                    sidebarIcon.classList.remove('fa-chevron-right');
                    sidebarIcon.classList.add('fa-chevron-left');
                }
            });
        }

        // Submenu functionality
        document.querySelectorAll('.nav-item.has-submenu > .nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const parent = this.parentElement;
                const submenu = parent.querySelector('.submenu');
                
                document.querySelectorAll('.nav-item.has-submenu').forEach(item => {
                    if (item !== parent) {
                        item.classList.remove('open');
                        item.querySelector('.submenu').classList.remove('open');
                    }
                });
                
                parent.classList.toggle('open');
                submenu.classList.toggle('open');
            });
        });

        // Navigation click handlers
        document.querySelectorAll('.submenu .nav-link').forEach(link => {
            link.addEventListener('click', closeMobileSidebar);
        });

        // Initialize date inputs with current month
        function initializeDateInputs() {
            const now = new Date();
            const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
            const lastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0);
            
            dateFromInput.value = firstDay.toISOString().split('T')[0];
            dateToInput.value = lastDay.toISOString().split('T')[0];
            
            quickDateBtns.forEach(btn => {
                if (btn.dataset.period === 'month') {
                    btn.classList.add('active');
                }
            });
        }

        // Auto collapse sidebar on medium screens
        function handleResponsiveLayout() {
            if (window.innerWidth <= 992 && window.innerWidth > 576) {
                if (!sidebar.classList.contains('collapsed')) {
                    sidebar.classList.add('collapsed');
                    mainContent.classList.add('expanded');
                    header.classList.add('expanded');
                    if (sidebarIcon) {
                        sidebarIcon.classList.remove('fa-chevron-left');
                        sidebarIcon.classList.add('fa-chevron-right');
                    }
                }
            }
        }

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (paymentModal.classList.contains('show')) {
                    paymentModal.classList.remove('show');
                } else if (sidebar.classList.contains('mobile-open')) {
                    closeMobileSidebar();
                }
            }
            
            if (e.ctrlKey && e.key === 'n') {
                e.preventDefault();
                addPaymentBtn.click();
            }
            
            if (e.ctrlKey && e.key === 'f') {
                e.preventDefault();
                searchInput.focus();
            }
        });

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', async function() {
            initializeDateInputs();
            updateStatistics();
            handleResponsiveLayout();
            attachActionListeners();
            
            // Load data for autocomplete
            await loadPartneriData();
            await loadKomercijalistiData();
            
            // Setup autocomplete for customers (partneri)
            setupAutocomplete(
                customerInput,
                customerAutocomplete,
                partneriData,
                ['Naziv_partnera', 'Grad', 'PIB'], // Search fields
                'Naziv_partnera', // Display field
                'Grad', // Subtitle field
                function(selectedPartner) {
                    partnerSifraInput.value = selectedPartner.Sifra;
                    console.log('Selected partner:', selectedPartner.Naziv_partnera, 'Sifra:', selectedPartner.Sifra);
                }
            );

            // Setup autocomplete for salesperson (komercijalisti)
            setupAutocomplete(
                salespersonInput,
                salespersonAutocomplete,
                komercijalistiData.filter(k => k.status === 'aktivan'), // Only active komercijalisti
                ['ime_prezime'], // Search fields
                'ime_prezime', // Display field
                'status', // Subtitle field
                function(selectedKomercijalist) {
                    komercijalistIdInput.value = selectedKomercijalist.id;
                    console.log('Selected komercijalist:', selectedKomercijalist.ime_prezime, 'ID:', selectedKomercijalist.id);
                }
            );
            
            console.log('Tehnolux Uplate panel initialized with autocomplete functionality');
        });

        // Handle window resize
        window.addEventListener('resize', handleResponsiveLayout);
    </script>
</body>
</html>