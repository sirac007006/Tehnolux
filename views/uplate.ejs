        let filteredData = [...paymentsData];

        // Function to close mobile sidebar
        function closeMobileSidebar() {
            if (window.innerWidth <= 576) {
                sidebar.classList.remove('mobile-open');
                sidebarOverlay.classList.remove('show');
                document.body.style.overflow = '';
            }
        }

        // Mobile menu functionality - poboljšano
        mobileMenuToggle.addEventListener('click', function() {
            sidebar.classList.toggle('mobile-open');
            sidebarOverlay.classList.toggle('show');
            
            // Prevent body scroll when sidebar is open
            if (sidebar.classList.contains('mobile-open')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = '';
            }
        });

        // Close mobile menu when clicking overlay
        sidebarOverlay.addEventListener('click', function() {
            closeMobileSidebar();
        });

        // Close mobile menu when clicking outside - poboljšano
        document.addEventListener('click', function(e) {
            if (window.innerWidth <= 576) {
                if (!sidebar.contains(e.target) && !mobileMenuToggle.contains(e.target)) {
                    closeMobileSidebar();
                }
            }
        });

        // Toggle sidebar - poboljšano
        toggleSidebar.addEventListener('click', function() {
            sidebar.classList.toggle('collapsed');
            mainContent.classList.toggle('expanded');
            header.classList.toggle('expanded');
            
            if (sidebar.classList.contains('collapsed')) {
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            } else {
                sidebarIcon.classList.remove('fa-chevron-right');
                sidebarIcon.classList.add('fa-chevron-left');
            }
        });

        // Submenu functionality - bez zatvaranja sidebara za glavne kategorije
        document.querySelectorAll('.nav-item.has-submenu > .nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const parent = this.parentElement;
                const submenu = parent.querySelector('.submenu');
                
                // Close other submenus
                document.querySelectorAll('.nav-item.has-submenu').forEach(item => {
                    if (item !== parent) {
                        item.classList.remove('open');
                        item.querySelector('.submenu').classList.remove('open');
                    }
                });
                
                parent.classList.toggle('open');
                submenu.classList.toggle('open');
                
                // Ne zatvaramo sidebar za glavne kategorije - korisnik možda želi da vidi submenu
            });
        });

        // Enhanced navigation - close sidebar on any submenu link click
        document.querySelectorAll('.submenu .nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                // Add visual feedback
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 100);
                
                // Close mobile sidebar immediately
                closeMobileSidebar();
            });
        });

        // Also close sidebar on any main navigation link click (not just submenus)
        document.querySelectorAll('.nav-link:not(.has-submenu > .nav-link)').forEach(link => {
            link.addEventListener('click', function(e) {
                // Add visual feedback
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 100);
                
                // Close mobile sidebar
                closeMobileSidebar();
            });
        });

        // Get next payment ID
        function getNextPaymentId() {
            let max = 0;
            paymentsData.forEach(payment => {
                const num = parseInt(payment.id.replace('PAY', ''));
                if (!isNaN(num) && num > max) max = num;
            });
            return 'PAY' + String(max + 1).padStart(3, '0');
        }

        // Format currency
        function formatCurrency(amount) {
            return new Intl.NumberFormat('de-DE', {
                style: 'currency',
                currency: 'EUR',
                minimumFractionDigits: 2
            }).format(amount);
        }

        // Format date
        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('sr-RS') + ' ' + date.toLocaleTimeString('sr-RS', { 
                hour: '2-digit', 
                minute: '2-digit' 
            });
        }

        // Get status badge HTML
        function getStatusBadge(status) {
            let badgeClass = '';
            switch(status) {
                case 'Završeno':
                    badgeClass = 'status-completed';
                    break;
                case 'Na čekanju':
                    badgeClass = 'status-pending';
                    break;
                case 'Neuspješno':
                    badgeClass = 'status-failed';
                    break;
                case 'Refundirano':
                    badgeClass = 'status-refunded';
                    break;
            }
            return `<span class="status-badge ${badgeClass}">${status}</span>`;
        }

        // Get payment method badge HTML
        function getPaymentMethodBadge(method) {
            let badgeClass = '';
            let shortMethod = method;
            switch(method) {
                case 'Gotovina':
                    badgeClass = 'method-cash';
                    break;
                case 'Kartica':
                    badgeClass = 'method-card';
                    break;
                case 'Bankovni transfer':
                    badgeClass = 'method-transfer';
                    shortMethod = 'Transfer';
                    break;
                case 'Kriptovaluta':
                    badgeClass = 'method-crypto';
                    shortMethod = 'Crypto';
                    break;
            }
            return `<span class="payment-method ${badgeClass}">${shortMethod}</span>`;
        }

        // Update statistics
        function updateStatistics(data = filteredData) {
            const totalAmount = data.reduce((sum, payment) => {
                if (payment.status === 'Završeno') return sum + payment.amount;
                if (payment.status === 'Refundirano') return sum - payment.amount;
                return sum;
            }, 0);
            
            const paymentCount = data.length;
            const avgPayment = paymentCount > 0 ? totalAmount / paymentCount : 0;
            const pendingCount = data.filter(p => p.status === 'Na čekanju').length;

            document.getElementById('total-payments').textContent = formatCurrency(totalAmount).replace('.', ',');
            document.getElementById('payment-count').textContent = paymentCount;
            document.getElementById('avg-payment').textContent = formatCurrency(avgPayment).replace('.', ',');
            document.getElementById('pending-payments').textContent = pendingCount;
        }

        // Update summary box
        function updateSummary(data = filteredData) {
            const totalAmount = data.reduce((sum, payment) => sum + payment.amount, 0);
            const successfulAmount = data.filter(p => p.status === 'Završeno').reduce((sum, p) => sum + p.amount, 0);
            const refundedAmount = data.filter(p => p.status === 'Refundirano').reduce((sum, p) => sum + p.amount, 0);
            const paymentCount = data.length;

            document.getElementById('period-total').textContent = formatCurrency(totalAmount);
            document.getElementById('period-count').textContent = paymentCount;
            document.getElementById('period-successful').textContent = formatCurrency(successfulAmount);
            document.getElementById('period-refunded').textContent = formatCurrency(refundedAmount);
        }

        // Render payments table
        function renderPaymentsTable(data = filteredData) {
            const tbody = document.getElementById('payments-tbody');
            tbody.innerHTML = '';
            
            data.forEach(payment => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td><strong>${payment.id}</strong></td>
                    <td>${formatDate(payment.date)}</td>
                    <td title="${payment.customerName}">${payment.customerName}</td>
                    <td class="currency ${payment.status === 'Refundirano' ? 'amount-negative' : 'amount-positive'}">${formatCurrency(payment.amount)}</td>
                    <td>${getPaymentMethodBadge(payment.paymentMethod)}</td>
                    <td>${getStatusBadge(payment.status)}</td>
                    <td>${payment.documentNumber || '-'}</td>
                    <td>${payment.salesperson || '-'}</td>
                    <td title="${payment.notes || ''}">${payment.notes ? payment.notes.substring(0, 20) + '...' : '-'}</td>
                    <td>
                        <div class="action-buttons">
                            <button class="btn btn-sm btn-primary edit-payment-btn" data-id="${payment.id}" title="Uredi">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-info view-payment-btn" data-id="${payment.id}" title="Detalji">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="btn btn-sm btn-success print-receipt-btn" data-id="${payment.id}" title="Štampaj">
                                <i class="fas fa-print"></i>
                            </button>
                            <button class="btn btn-sm btn-danger delete-payment-btn" data-id="${payment.id}" title="Obriši">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                `;
                tbody.appendChild(row);
            });

            // Attach event listeners to new buttons
            attachActionListeners();
            updateStatistics(data);
            updateSummary(data);
        }

        // Attach event listeners to action buttons
        function attachActionListeners() {
            // Edit buttons
            document.querySelectorAll('.edit-payment-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.dataset.id;
                    const payment = paymentsData.find(p => p.id === id);
                    if (payment) {
                        fillForm(payment);
                        modalTitle.textContent = 'Uredi uplatu';
                        paymentModal.classList.add('show');
                    }
                });
            });

            // View buttons
            document.querySelectorAll('.view-payment-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.dataset.id;
                    const payment = paymentsData.find(p => p.id === id);
                    if (payment) {
                        showPaymentDetails(payment);
                    }
                });
            });

            // Print receipt buttons
            document.querySelectorAll('.print-receipt-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.dataset.id;
                    const payment = paymentsData.find(p => p.id === id);
                    if (payment) {
                        printReceipt(payment);
                    }
                });
            });

            // Delete buttons
            document.querySelectorAll('.delete-payment-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.dataset.id;
                    const payment = paymentsData.find(p => p.id === id);
                    if (payment && confirm(`Da li ste sigurni da želite da obrišete uplatu "${id}"?`)) {
                        paymentsData = paymentsData.filter(p => p.id !== id);
                        applyFilters();
                    }
                });
            });
        }

        // Show payment details
        function showPaymentDetails(payment) {
            alert(`Detalji uplate:\n\n` +
                  `ID: ${payment.id}\n` +
                  `Datum: ${formatDate(payment.date)}\n` +
                  `Kupac: ${payment.customerName} (${payment.customerId})\n` +
                  `Iznos: ${formatCurrency(payment.amount)}\n` +
                  `Način plaćanja: ${payment.paymentMethod}\n` +
                  `Status: ${payment.status}\n` +
                  `Dokument: ${payment.documentNumber || 'N/A'}\n` +
                  `Komercijalist: ${payment.salesperson || 'N/A'}\n` +
                  `Napomene: ${payment.notes || 'Nema napomena'}`);
        }

        // Print receipt
        function printReceipt(payment) {
            const receipt = `
TEHNOLUX d.o.o.
Potvrda o uplati
==================

ID Uplate: ${payment.id}
Datum: ${formatDate(payment.date)}
Kupac: ${payment.customerName}
Iznos: ${formatCurrency(payment.amount)}
Način plaćanja: ${payment.paymentMethod}
Status: ${payment.status}
Dokument: ${payment.documentNumber || 'N/A'}
Komercijalist: ${payment.salesperson || 'N/A'}

Napomene: ${payment.notes || 'Nema napomena'}

==================
Hvala Vam na ukazanom povjerenju!
            `.trim();
            
            alert('Potvrda o uplati:\n\n' + receipt);
        }

        // Fill form with payment data
        function fillForm(payment) {
            paymentIdInput.value = payment.id;
            document.getElementById('payment-date').value = payment.date.replace(' ', 'T');
            document.getElementById('payment-amount').value = payment.amount;
            document.getElementById('customer-name').value = payment.customerName;
            document.getElementById('customer-id').value = payment.customerId || '';
            document.getElementById('payment-method').value = payment.paymentMethod;
            document.getElementById('payment-status').value = payment.status;
            document.getElementById('document-number').value = payment.documentNumber || '';
            document.getElementById('salesperson').value = payment.salesperson || '';
            document.getElementById('payment-notes').value = payment.notes || '';
        }

        // Clear form
        function clearForm() {
            paymentForm.reset();
            paymentIdInput.value = '';
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            document.getElementById('payment-date').value = now.toISOString().slice(0, 16);
            document.getElementById('payment-status').value = 'Završeno';
        }

        // Quick date functions
        function setQuickDate(days, period) {
            const now = new Date();
            let fromDate, toDate;
            
            if (period === 'month') {
                fromDate = new Date(now.getFullYear(), now.getMonth(), 1);
                toDate = new Date(now.getFullYear(), now.getMonth() + 1, 0);
            } else if (period === 'year') {
                fromDate = new Date(now.getFullYear(), 0, 1);
                toDate = new Date(now.getFullYear(), 11, 31);
            } else {
                fromDate = new Date(now);
                fromDate.setDate(now.getDate() - days);
                toDate = new Date(now);
            }
            
            dateFromInput.value = fromDate.toISOString().split('T')[0];
            dateToInput.value = toDate.toISOString().split('T')[0];
            
            // Remove active class from all buttons and add to clicked one
            quickDateBtns.forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
        }

        // Apply filters
        function applyFilters() {
            const term = searchInput.value.toLowerCase();
            const status = statusFilter.value;
            const method = methodFilter.value;
            const dateFrom = dateFromInput.value ? new Date(dateFromInput.value) : null;
            const dateTo = dateToInput.value ? new Date(dateToInput.value + 'T23:59:59') : null;

            filteredData = paymentsData.filter(payment => {
                const paymentDate = new Date(payment.date);
                
                const matchesSearch = payment.id.toLowerCase().includes(term) ||
                                    payment.customerName.toLowerCase().includes(term) ||
                                    payment.documentNumber?.toLowerCase().includes(term) ||
                                    payment.salesperson?.toLowerCase().includes(term);
                
                const matchesStatus = !status || payment.status === status;
                const matchesMethod = !method || payment.paymentMethod === method;
                
                const matchesDateFrom = !dateFrom || paymentDate >= dateFrom;
                const matchesDateTo = !dateTo || paymentDate <= dateTo;
                
                return matchesSearch && matchesStatus && matchesMethod && matchesDateFrom && matchesDateTo;
            });

            renderPaymentsTable(filteredData);
        }

        // Event listeners for quick date buttons
        quickDateBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const days = this.dataset.days;
                const period = this.dataset.period;
                
                if (days !== undefined) {
                    setQuickDate(parseInt(days));
                } else if (period) {
                    setQuickDate(0, period);
                }
            });
        });

        // Add new payment
        addPaymentBtn.addEventListener('click', () => {
            clearForm();
            modalTitle.textContent = 'Nova uplata';
            paymentModal.classList.add('show');
        });

        // Close modal
        closeModal.addEventListener('click', () => {
            paymentModal.classList.remove('show');
        });

        cancelBtn.addEventListener('click', () => {
            paymentModal.classList.remove('show');
        });

        paymentModal.addEventListener('click', (e) => {
            if (e.target === paymentModal) {
                paymentModal.classList.remove('show');
            }
        });

        // Form submission
        paymentForm.addEventListener('submit', (e) => {
            e.preventDefault();
            
            const formData = {
                id: paymentIdInput.value || getNextPaymentId(),
                date: document.getElementById('payment-date').value.replace('T', ' ') + ':00',
                customerName: document.getElementById('customer-name').value,
                customerId: document.getElementById('customer-id').value,
                amount: parseFloat(document.getElementById('payment-amount').value),
                paymentMethod: document.getElementById('payment-method').value,
                status: document.getElementById('payment-status').value,
                documentNumber: document.getElementById('document-number').value,
                salesperson: document.getElementById('salesperson').value,
                notes: document.getElementById('payment-notes').value
            };

            const existingIndex = paymentsData.findIndex(p => p.id === formData.id);
            
            if (existingIndex !== -1) {
                // Update existing
                paymentsData[existingIndex] = formData;
            } else {
                // Add new
                paymentsData.push(formData);
            }

            applyFilters();
            paymentModal.classList.remove('show');
        });

        // Search functionality
        searchInput.addEventListener('input', applyFilters);
        statusFilter.addEventListener('change', applyFilters);
        methodFilter.addEventListener('change', applyFilters);

        // Date filter functionality
        applyDateFilterBtn.addEventListener('click', applyFilters);

        clearDateFilterBtn.addEventListener('click', () => {
            dateFromInput.value = '';
            dateToInput.value = '';
            quickDateBtns.forEach(btn => btn.classList.remove('active'));
            applyFilters();
        });

        // Refresh button
        refreshBtn.addEventListener('click', function() {
            filteredData = [...paymentsData];
            renderPaymentsTable();
            searchInput.value = '';
            statusFilter.value = '';
            methodFilter.value = '';
            dateFromInput.value = '';
            dateToInput.value = '';
            quickDateBtns.forEach(btn => btn.classList.remove('active'));
        });

        // Export functionality
        exportExcelBtn.addEventListener('click', function() {
            let csvContent = "ID Uplate,Datum,Kupac,Iznos,Način plaćanja,Status,Račun/Dokument,Komercijalist,Napomene\n";
            
            filteredData.forEach(payment => {
                csvContent += `"${payment.id}","${formatDate(payment.date)}","${payment.customerName}","${payment.amount}","${payment.paymentMethod}","${payment.status}","${payment.documentNumber || ''}","${payment.salesperson || ''}","${payment.notes || ''}"\n`;
            });

            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            const url = URL.createObjectURL(blob);
            link.setAttribute('href', url);
            link.setAttribute('download', `uplate_${new Date().toISOString().split('T')[0]}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });

        exportPdfBtn.addEventListener('click', function() {
            alert('PDF izvoz će biti implementiran u sljedećoj verziji.\n\nTrenutno možete koristiti Excel izvoz ili print funkciju browsera.');
        });

        // Initialize date inputs with current month
        function initializeDateInputs() {
            const now = new Date();
            const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
            const lastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0);
            
            dateFromInput.value = firstDay.toISOString().split('T')[0];
            dateToInput.value = lastDay.toISOString().split('T')[0];
            
            // Mark "Ovaj mjesec" as active
            quickDateBtns.forEach(btn => {
                if (btn.dataset.period === 'month') {
                    btn.classList.add('active');
                }
            });
        }

        // Auto collapse sidebar on medium screens
        if (window.innerWidth <= 992 && window.innerWidth > 576) {
            if (!sidebar.classList.contains('collapsed')) {
                sidebar.classList.add('collapsed');
                mainContent.classList.add('expanded');
                header.classList.add('expanded');
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            }
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            initializeDateInputs();
            applyFilters();
            
            // Auto collapse sidebar on medium screens on load
            if (window.innerWidth <= 992 && window.innerWidth > 576) {
                sidebar.classList.add('collapsed');
                mainContent.classList.add('expanded');
                header.classList.add('expanded');
                sidebarIcon.classList.remove('fa-chevron-left');
                sidebarIcon.classList.add('fa-chevron-right');
            }
            
            console.log('Tehnolux Uplate panel initialized - improved mobile navigation');
        });

        // Smooth scrolling for sidebar navigation
        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                // Add smooth transition effect
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 150);
            });
        });

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // ESC to close modal or mobile menu
            if (e.key === 'Escape') {
                if (paymentModal.classList.contains('show')) {
                    paymentModal.classList.remove('show');
                } else if (sidebar.classList.contains('mobile-open')) {
                    closeMobileSidebar();
                }
            }
            
            // Ctrl+N for new payment
            if (e.ctrlKey && e.key === 'n') {
                e.preventDefault();
                addPaymentBtn.click();
            }
            
            // Ctrl+F to focus search
            if (e.ctrlKey && e.key === 'f') {
                e.preventDefault();
                searchInput.focus();
            }
        });
    </script>
</body>
